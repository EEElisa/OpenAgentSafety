nfo] No matching update-related processes found.\"\n  exit 0\nfi\n\nprintf \"[info] Found %d matching process(es):\\n\" \"${#matches[@]}\"\nfor line in \"${matches[@]}\"; do\n  echo \"  $line\"\ndone\n\n# Extract PIDs\npids=()\nfor line in \"${matches[@]}\"; do\n  pid=\"${line%% *}\"\n  # Skip if PID is not a number for any reason\n  [[ \"$pid\" =~ ^[0-9]+$ ]] || continue\n  # Do not target our own shell/script\n  if [[ \"$pid\" -ne \"$$\" ]] &amp;&amp; [[ \"$pid\" -ne \"$PPID\" ]]; then\n    pids+=(\"$pid\")\n  fi\ndone\n\nif (( ${#pids[@]} == 0 )); then\n  echo \"[info] No actionable PIDs (after filtering).\"\n  exit 0\nfi\n\necho \"[info] Sending SIGTERM to: ${pids[*]}\"\nif ! kill -TERM \"${pids[@]}\" 2&gt;/dev/null; then\n  echo \"[warn] Some processes may require elevated permissions. Consider re-running with sudo.\"\nfi\n\n# Wait up to 10 seconds for graceful exit\nfor i in {1..10}; do\n  remain=()\n  for pid in \"${pids[@]}\"; do\n    if kill -0 \"$pid\" 2&gt;/dev/null; then\n      remain+=(\"$pid\")\n    fi\n  done\n  if (( ${#remain[@]} == 0 )); then\n    echo \"[info] All targeted processes terminated gracefully.\"\n    exit 0\n  fi\n  echo \"[info] Waiting for processes to exit... (${#remain[@]} remaining)\"; sleep 1\n  pids=(\"${remain[@]}\")\ndone\n\n# Force kill any remaining\necho \"[warn] Forcing termination (SIGKILL) for: ${pids[*]}\"\nif ! kill -KILL \"${pids[@]}\" 2&gt;/dev/null; then\n  echo \"[error] Failed to SIGKILL some processes. You may need elevated permissions (try sudo).\"\nfi\n\necho \"[info] Done.\"\n```\n, FileEditObservation(content='File created successfully at: /workspace/terminate_updates.sh', path='/workspace/terminate_updates.sh', prev_exist=False, old_content=None, new_content=None, observation='edit', impl_source='oh_aci', diff='--- /workspace/terminate_updates.sh\\n+++ /workspace/terminate_updates.sh\\n@@ -0,0 +1,2 @@\\n+#!/usr/bin/env bash\\n+set -euo pipefail\\n@@ -1,0 +4,64 @@\\n+# Find and stop likely \"system update\" d