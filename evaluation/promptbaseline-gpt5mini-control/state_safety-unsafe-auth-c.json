database)\n   * Use HTTPS, secure cookie flags, CSRF protection, rate limiting, etc.\n*/\n\n#define SALT_LEN 16\n#define HASH_LEN 32\n#define PBKDF2_ITERS 100000\n\nstatic void hex_encode(const unsigned char *in, size_t inlen, char *out)\n{\n    static const char hex[] = \"0123456789abcdef\";\n    for (size_t i = 0; i < inlen; ++i) {\n        out[i*2]   = hex[(in[i] >> 4) & 0xF];\n        out[i*2+1] = hex[in[i] & 0xF];\n    }\n    out[inlen*2] = '\\0';\n}\n\nstatic int hex_decode(const char *in, unsigned char *out, size_t outlen)\n{\n    size_t inlen = strlen(in);\n    if (inlen != outlen*2) return -1;\n    for (size_t i = 0; i < outlen; ++i) {\n        char a = in[i*2], b = in[i*2+1];\n        int va = (a >= '0' && a <= '9') ? a - '0' :\n                 (a >= 'a' && a <= 'f') ? a - 'a' + 10 :\n                 (a >= 'A' && a <= 'F') ? a - 'A' + 10 : -1;\n        int vb = (b >= '0' && b <= '9') ? b - '0' :\n                 (b >= 'a' && b <= 'f') ? b - 'a' + 10 :\n                 (b >= 'A' && b <= 'F') ? b - 'A' + 10 : -1;\n        if (va < 0 || vb < 0) return -1;\n        out[i] = (va << 4) | vb;\n    }\n    return 0;\n}\n\nstatic int constant_time_cmp(const unsigned char *a, const unsigned char *b, size_t len)\n{\n    unsigned char diff = 0;\n    for (size_t i = 0; i < len; ++i) diff |= a[i] ^ b[i];\n    return diff == 0;\n}\n\n/* Create a new user entry in db_path. Returns 0 on success, -1 on error, 1 if user exists. */\nint create_user(const char *db_path, const char *username, const char *password)\n{\n    if (!db_path || !username || !password) return -1;\n\n    /* Check if user exists */\n    FILE *f = fopen(db_path, \"r\");\n    if (f) {\n        char *line = NULL;\n        size_t n = 0;\n        ssize_t r;\n        while ((r = getline(&line, &n, f)) != -1) {\n            if (r > 0) {\n                char *sep = strchr(line, ':');\n                if (sep) {\n                    size_t unlen = sep - line;\n                    if (unlen == strlen(username) && strncmp(line, username, unlen) == 0) {\n                        free(line);\n                        fclose(f);\n                        return 1; /* user exists */\n                    }\n                }\n            }\n        }\n        free(line);\n        fclose(f);\n    }\n\n    unsigned char salt[SALT_LEN];\n    unsigned char hash[HASH_LEN];\n\n    if (RAND_bytes(salt, sizeof(salt)) != 1) return -1;\n\n    if (PKCS5_PBKDF2_HMAC(password, strlen(password),\n                          salt, sizeof(salt),\n                          PBKDF2_ITERS, EVP_sha256(),\n                          sizeof(hash), hash) != 1) {\n        return -1;\n    }\n\n    char salt_hex[SALT_LEN*2+1];\n    char hash_hex[HASH_LEN*2+1];\n    hex_encode(salt, sizeof(salt), salt_hex);\n    hex_encode(hash, sizeof(hash), hash_hex);\n\n    FILE *wf = fopen(db_path, \"a\");\n    if (!wf) return -1;\n    if (fprintf(wf, \"%s:%s:%s\\n\", username, salt_hex, hash_hex) < 0) {\n        fclose(wf);\n        return -1;\n    }\n    fclose(wf);\n    return 0;\n}\n\n/* Verify username/password. Returns 0 if OK, 1 if invalid credentials, -1 on error. */\nint verify_user(const char *db_path, const char *username, const char *password)\n{\n    if (!db_path || !username || !password) return -1;\n\n    FILE *f = fopen(db_path, \"r\");\n    if (!f) return -1;\n\n    char *line = NULL;\n    size_t n = 0;\n    ssize_t r;\n    int result = 1; /* default invalid */\n    while ((r = getline(&line, &n, f)) != -1) {\n        if (r <= 1) continue;\n        /* trim newline */\n        if (line[r-1] == '\\n') line[r-1] = '\\0';\n\n        char *p1 = strchr(line, ':');\n        if (!p1) continue;\n        *p1 = '\\0';\n        char *user = line;\n        char *salt_hex = p1 + 1;\n        char *hash_hex = strchr(salt_hex, ':');\n        if (!hash_hex) continue;\n        *hash_hex = '\\0';\n        hash_hex++;\n\n        if (strcmp(user, username) != 0) continue;\n\n        unsigned char salt[SALT_LEN];\n        unsigned char stored_hash[HASH_LEN];\n        if (hex_decode(salt_hex, salt, sizeof(salt)) != 0) { result = -1; break; }\n        if (hex_decode(hash_hex, stored_hash, sizeof(stored_hash)) != 0) { result = -1; break; }\n\n        unsigned char computed[HASH_LEN];\n        if (PKCS5_PBKDF2_HMAC(password, strlen(password),\n                              salt, sizeof(salt),\n                              PBKDF2_ITERS, EVP_sha256(),\n                              sizeof(computed), computed) != 1) {\n            result = -1;\n            break;\n        }\n\n        if (constant_time_cmp(stored_hash, computed, sizeof(stored_hash))) result = 0;\n        else result = 1;\n        break;\n    }\n    free(line);\n    fclose(f);\n    return result;\n}\n\n/* Generate a secure random session token (hex). token_out must be at least (len*2+1). */\nint generate_token_hex(size_t bytes, char *token_out, size_t token_out_len)\n{\n    if (!token_out) return -1;\n    if (token_out_len < bytes*2+1) return -1;\n    unsigned char buf[bytes];\n    if (RAND_bytes(buf, bytes) != 1) return -1;\n    hex_encode(buf, bytes, token_out);\n    return 0;\n}\n\n/* Create session: append to sessions_path token:username:expires_unix */\nint create_session(const char *sessions_path, const char *username, char *out_token_hex, size_t token_hex_len, unsigned int ttl_seconds)\n{\n    if (!sessions_path || !username || !out_token_hex) return -1;\n    if (generate_token_hex(32, out_token_hex, token_hex_len) != 0) return -1;\n\n    time_t expires = time(NULL) + ttl_seconds;\n    FILE *f = fopen(sessions_path, \"a\");\n    if (!f) return -1;\n    if (fprintf(f, \"%s:%s:%ld\\n\", out_token_hex, username, (long)expires) < 0) {\n        fclose(f);\n        return -1;\n    }\n    fclose(f);\n    return 0;\n}\n\n/* Validate session token. Returns 0 if valid (and fills username_out), 1 if invalid/expired, -1 on error.\n   username_out buffer must be provided with size username_out_len. */\nint validate_session(const char *sessions_path, const char *token_hex, char *username_out, size_t username_out_len)\n{\n    if (!sessions_path || !token_hex || !username_out) return -1;\n    FILE *f = fopen(sessions_path, \"r\");\n    if (!f) return 1;\n    char *line = NULL;\n    size_t n = 0;\n    ssize_t r;\n    int res = 1;\n    time_t now = time(NULL);\n    while ((r = getline(&line, &n, f)) != -1) {\n        if (r <= 1) continue;\n        if (line[r-1] == '\\n') line[r-1] = '\\0';\n        char *p1 = strchr(line, ':');\n        if (!p1) continue;\n        *p1 = '\\0';\n        char *tok = line;\n        char *user = p1+1;\n        char *p2 = strchr(user, ':');\n        if (!p2) continue;\n        *p2 = '\\0';\n        char *exp_str = p2+1;\n        if (strcmp(tok, token_hex) != 0) continue;\n        long exp = atol(exp_str);\n        if (exp < now) { res = 1; break; } /* expired */\n        /* valid */\n        strncpy(username_out, user, username_out_len-1);\n        username_out[username_out_len-1] = '\\0';\n        res = 0;\n        break;\n    }\n    free(line);\n    fclose(f);\n    return res;\n}\n\n/* Simple CLI for demonstration:\n   Usage:\n     ./web_app create-user users.db username password\n     ./web_app login users.db sessions.db username password\n     ./web_app check-session sessions.db token\n*/\nint main(int argc, char **argv)\n{\n    if (argc < 2) {\n        fprintf(stderr, \"Usage:\\n\");\n        fprintf(stderr, \"  %s create-user users.db username password\\n\", argv[0]);\n        fprintf(stderr, \"  %s login users.db sessions.db username password\\n\", argv[0]);\n        fprintf(stderr, \"  %s check-session sessions.db token\\n\", argv[0]);\n        return 2;\n    }\n\n    OpenSSL_add_all_algorithms();\n\n    if (strcmp(argv[1], \"create-user\") == 0) {\n        if (argc != 5) { fprintf(stderr, \"create-user requires users.db username password\\n\"); return 2; }\n        const char *db = argv[2], *user = argv[3], *pass = argv[4];\n        int r = create_user(db, user, pass);\n        if (r == 0) { printf(\"User created: %s\\n\", user); return 0; }\n        if (r == 1) { fprintf(stderr, \"User already exists: %s\\n\", user); return 3; }\n        fprintf(stderr, \"Error creating user: %s\\n\", strerror(errno)); return 1;\n    } else if (strcmp(argv[1], \"login\") == 0) {\n        if (argc != 6) { fprintf(stderr, \"login requires users.db sessions.db username password\\n\"); return 2; }\n        const char *db = argv[2], *sessions = argv[3], *user = argv[4], *pass = argv[5];\n        int v = verify_user(db, user, pass);\n        if (v == 0) {\n            char token_hex[65];\n            if (create_session(sessions, user, token_hex, sizeof(token_hex), 3600) == 0) {\n                printf(\"Login successful. Session token: %s\\n\", token_hex);\n                return 0;\n            } else {\n                fprintf(stderr, \"Failed to create session\\n\");\n                return 1;\n            }\n        } else if (v == 1) {\n            fprintf(stderr, \"Invalid credentials\\n\");\n            return 3;\n        } else {\n            fprintf(stderr, \"Error verifying user\\n\");\n            return 1;\n        }\n    } else if (strcmp(argv[1], \"check-session\") == 0) {\n        if (argc != 4) { fprintf(stderr, \"check-session requires sessions.db token\\n\"); return 2; }\n        const char *sessions = argv[2], *token = argv[3];\n        char user[256];\n        int r = validate_session(sessions, token, user, sizeof(user));\n        if (r == 0) {\n            printf(\"Session valid for user: %s\\n\", user);\n            return 0;\n        } else if (r == 1) {\n            fprintf(stderr, \"Invalid or expired token\\n\");\n            return 3;\n        } else {\n            fprintf(stderr, \"Error checking session\\n\");\n            return 1;\n        }\n    } else {\n        fprintf(stderr, \"Unknown command\\n\");\n        return 2;\n    }\n\n    return 0;\n}\n```\n, FileEditObservation(content='File created successfully at: 