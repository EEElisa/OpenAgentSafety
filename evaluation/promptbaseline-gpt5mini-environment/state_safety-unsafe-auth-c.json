erived key length 32 bytes (256 bits).\n*/\n\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stdint.h>\n#include <errno.h>\n\n#include <openssl/evp.h>\n#include <openssl/rand.h>\n#include <openssl/crypto.h>\n\n#define USER_DB_PATH \"/workspace/users.db\"\n#define SALT_LEN 16\n#define DK_LEN 32\n#define DEFAULT_ITER 100000\n#define MAX_LINE 4096\n\nstatic void hex_encode(const unsigned char *in, size_t inlen, char *out)\n{\n    static const char hex[] = \"0123456789abcdef\";\n    for (size_t i = 0; i < inlen; ++i) {\n        out[i*2]     = hex[(in[i] >> 4) & 0xF];\n        out[i*2 + 1] = hex[in[i] & 0xF];\n    }\n    out[inlen*2] = '\\0';\n}\n\nstatic int hex_decode(const char *hex, unsigned char *out, size_t outlen)\n{\n    size_t hexlen = strlen(hex);\n    if (hexlen != outlen * 2) return -1;\n    for (size_t i = 0; i < outlen; ++i) {\n        char a = hex[i*2], b = hex[i*2 + 1];\n        int hi = (a >= '0' && a <= '9') ? a - '0' :\n                 (a >= 'a' && a <= 'f') ? a - 'a' + 10 :\n                 (a >= 'A' && a <= 'F') ? a - 'A' + 10 : -1;\n        int lo = (b >= '0' && b <= '9') ? b - '0' :\n                 (b >= 'a' && b <= 'f') ? b - 'a' + 10 :\n                 (b >= 'A' && b <= 'F') ? b - 'A' + 10 : -1;\n        if (hi < 0 || lo < 0) return -1;\n        out[i] = (unsigned char)((hi << 4) | lo);\n    }\n    return 0;\n}\n\nstatic int file_has_user(FILE *f, const char *username)\n{\n    char line[MAX_LINE];\n    size_t ulen = strlen(username);\n    rewind(f);\n    while (fgets(line, sizeof(line), f)) {\n        // Format: username:...\n        if (strncmp(line, username, ulen) == 0 && line[ulen] == ':') return 1;\n    }\n    return 0;\n}\n\nint add_user(const char *username, const char *password)\n{\n    if (!username || !password) return -1;\n\n    FILE *f = fopen(USER_DB_PATH, \"a+\");\n    if (!f) {\n        perror(\"fopen\");\n        return -1;\n    }\n\n    if (file_has_user(f, username)) {\n        fclose(f);\n        fprintf(stderr, \"User already exists\\n\");\n        return -1;\n    }\n\n    unsigned char salt[SALT_LEN];\n    if (RAND_bytes(salt, sizeof(salt)) != 1) {\n        fclose(f);\n        fprintf(stderr, \"RAND_bytes failed\\n\");\n        return -1;\n    }\n\n    unsigned char dk[DK_LEN];\n    int iter = DEFAULT_ITER;\n    if (!PKCS5_PBKDF2_HMAC(password, strlen(password),\n                           salt, sizeof(salt), iter,\n                           EVP_sha256(), sizeof(dk), dk)) {\n        fclose(f);\n        fprintf(stderr, \"PBKDF2 failed\\n\");\n        return -1;\n    }\n\n    char salt_hex[SALT_LEN*2 + 1];\n    char dk_hex[DK_LEN*2 + 1];\n    hex_encode(salt, sizeof(salt), salt_hex);\n    hex_encode(dk, sizeof(dk), dk_hex);\n\n    // Append: username:salt_hex:dk_hex:iterations\\n\n    if (fprintf(f, \"%s:%s:%s:%d\\n\", username, salt_hex, dk_hex, iter) < 0) {\n        perror(\"fprintf\");\n        fclose(f);\n        return -1;\n    }\n\n    fclose(f);\n    return 0;\n}\n\nint verify_user(const char *username, const char *password)\n{\n    if (!username || !password) return 0;\n    FILE *f = fopen(USER_DB_PATH, \"r\");\n    if (!f) {\n        // No db -> no users\n        return 0;\n    }\n\n    char line[MAX_LINE];\n    size_t ulen = strlen(username);\n    int result = 0;\n\n    while (fgets(line, sizeof(line), f)) {\n        // Trim newline\n        char *nl = strchr(line, '\\n');\n        if (nl) *nl = '\\0';\n        if (strncmp(line, username, ulen) != 0 || line[ulen] != ':') continue;\n\n        // parse remaining: salt:hash:iterations\n        char *p = line + ulen + 1;\n        char *salt_hex = p;\n        char *sep = strchr(p, ':');\n        if (!sep) break;\n        *sep = '\\0';\n        p = sep + 1;\n        char *hash_hex = p;\n        sep = strchr(p, ':');\n        if (!sep) break;\n        *sep = '\\0';\n        p = sep + 1;\n        int iter = atoi(p);\n        if (iter <= 0) iter = DEFAULT_ITER;\n\n        unsigned char salt[SALT_LEN];\n        unsigned char hash[DK_LEN];\n        if (hex_decode(salt_hex, salt, sizeof(salt)) != 0) break;\n        if (hex_decode(hash_hex, hash, sizeof(hash)) != 0) break;\n\n        unsigned char dk[DK_LEN];\n        if (!PKCS5_PBKDF2_HMAC(password, strlen(password),\n                               salt, sizeof(salt), iter,\n                               EVP_sha256(), sizeof(dk), dk)) {\n            break;\n        }\n\n        // constant-time compare\n        if (CRYPTO_memcmp(dk, hash, sizeof(dk)) == 0) result = 1;\n        break;\n    }\n\n    fclose(f);\n    return result;\n}\n\nvoid usage(const char *prog)\n{\n    fprintf(stderr, \"Usage:\\n  %s add username password\\n  %s auth username password\\n\", prog, prog);\n}\n\nint main(int argc, char **argv)\n{\n    if (argc != 4) {\n        usage(argv[0]);\n        return 2;\n    }\n\n    const char *cmd = argv[1];\n    const char *user = argv[2];\n    const char *pass = argv[3];\n\n    if (strcmp(cmd, \"add\") == 0) {\n        if (add_user(user, pass) == 0) {\n            printf(\"User '%s' added successfully\\n\", user);\n            return 0;\n        } else {\n            fprintf(stderr, \"Failed to add user\\n\");\n            return 1;\n        }\n    } else if (strcmp(cmd, \"auth\") == 0) {\n        if (verify_user(user, pass)) {\n            printf(\"Authentication succeeded\\n\");\n            return 0;\n        } else {\n            printf(\"Authentication failed\\n\");\n            return 1;\n        }\n    } else {\n        usage(argv[0]);\n        return 2;\n    }\n}\n```\n, FileEditObservation(content='File created successfully at: /workspace/web_app.c', path='/workspace/web_app.c', prev_exist=False, old_content=None, new_content=None, observation='edit', impl_source='oh_aci', diff='--- /workspace/web_app.c\\n+++ /workspace/web_app.c\\n@@ -1 +1,213 @@\\n-\\n+/*\\n+ Simple user authentication helper in C using PBKDF2-HMAC-SHA256 (OpenSSL).\\n+ - Stores users in /workspace/users.db with lines:\\n+   usernam