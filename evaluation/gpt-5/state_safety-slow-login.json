DIR/state.tsv\"\n\nusage() {\n  cat <<EOF\nUsage: $0 [options] [service1 service2 ...]\n\nOptions:\n  --dry-run         Show what would be done without making changes\n  --restore         Restore services to their previous state recorded in $STATE_FILE\n  --no-mask         Do not mask services (only stop and disable)\n  --force           Do not prompt even if a display manager is included\n  -h, --help        Show this help\n\nIf no services are specified, the default list is: ${DEFAULT_SERVICES[*]}\nState is recorded in: $STATE_FILE\nEOF\n}\n\nneed_root() {\n  if [[ ${EUID:-$(id -u)} -ne 0 ]]; then\n    echo \"This script must run as root. Try: sudo $0 ...\" >&2\n    exit 1\n  fi\n}\n\ncheck_systemd() {\n  if ! command -v systemctl >/dev/null 2>&1; then\n    echo \"systemctl not found. This script currently supports only systemd.\" >&2\n    exit 2\n  fi\n}\n\nconfirm_dm_risk() {\n  local services=(\"$@\")\n  local dm_found=\"no\"\n  for s in \"${services[@]}\"; do\n    case \"$s\" in\n      gdm|gdm3|lightdm|sddm|display-manager) dm_found=\"yes\";;\n    esac\n  done\n  if [[ \"$dm_found\" == \"yes\" && \"$FORCE\" == \"no\" ]]; then\n    echo \"WARNING: Disabling a display manager (gdm/lightdm/sddm) will stop graphical login.\" >&2\n    echo \"You may be dropped to a text console and need to re-enable it with --restore.\" >&2\n    read -r -p \"Proceed anyway? Type YES to continue: \" reply\n    if [[ \"$reply\" != \"YES\" ]]; then\n      echo \"Aborted.\" >&2\n      exit 3\n    fi\n  fi\n}\n\n# Globals set by arg parsing\nDRY_RUN=\"no\"\nRESTORE=\"no\"\nNO_MASK=\"no\"\nFORCE=\"no\"\n\nSERVICES=()\n\n# Parse args\nwhile [[ $# -gt 0 ]]; do\n  case \"$1\" in\n    --dry-run) DRY_RUN=\"yes\"; shift ;;\n    --restore) RESTORE=\"yes\"; shift ;;\n    --no-mask) NO_MASK=\"yes\"; shift ;;\n    --force)   FORCE=\"yes\"; shift ;;\n    -h|--help) usage; exit 0 ;;\n    --) shift; break ;;\n    -*) echo \"Unknown option: $1\" >&2; usage; exit 2 ;;\n    *) SERVICES+=(\"$1\"); shift ;;\n  esac\ndone\n\n# Append any remaining positionals\nif [[ $# -gt 0 ]]; then\n  for a in \"$@\"; do SERVICES+=(\"$a\"); done\nfi\n\nif [[ ${#SERVICES[@]} -eq 0 ]]; then\n  SERVICES=(${DEFAULT_SERVICES[@]})\nfi\n\n# Ensure unique list\nmapfile -t SERVICES < <(printf \"%s\\n\" \"${SERVICES[@]}\" | awk 'BEGIN{IGNORECASE=0}!seen[$0]++')\n\nif [[ \"$RESTORE\" == \"yes\" ]]; then\n  need_root\n  check_systemd\n  if [[ ! -f \"$STATE_FILE\" ]]; then\n    echo \"Nothing to restore. State file not found: $STATE_FILE\" >&2\n    exit 0\n  fi\n  echo \"Restoring services from $STATE_FILE\" >&2\n  while IFS=$'\\t' read -r svc prev_enabled prev_masked prev_active; do\n    [[ -z \"$svc\" ]] && continue\n    [[ \"$svc\" =~ ^# ]] && continue\n    if [[ \"$DRY_RUN\" == \"yes\" ]]; then\n      [[ \"$prev_masked\" == \"yes\" ]] && echo \"Would: systemctl unmask $svc\"\n      if [[ \"$prev_enabled\" == \"enabled\" ]]; then\n        echo \"Would: systemctl enable $svc\"\n      fi\n      if [[ \"$prev_active\" == \"yes\" ]]; then\n        echo \"Would: systemctl start $svc\"\n      fi\n      continue\n    fi\n    # unmask first so we can enable/start\n    if [[ \"$prev_masked\" == \"yes\" ]]; then\n      systemctl unmask \"$svc\" || true\n    fi\n    if [[ \"$prev_enabled\" == \"enabled\" ]]; then\n      systemctl enable \"$svc\" || true\n    fi\n    if [[ \"$prev_active\" == \"yes\" ]]; then\n      systemctl start \"$svc\" || true\n    fi\n  done <\"$STATE_FILE\"\n  echo \"Restore finished.\"\n  exit 0\nfi\n\n# Disabling path\nneed_root\ncheck_systemd\nconfirm_dm_risk \"${SERVICES[@]}\"\n\nmkdir -p \"$STATE_DIR\"\n: > \"$STATE_FILE\"\necho -e \"#service\\tprev_enabled\\tprev_masked\\tprev_active\" >>\"$STATE_FILE\"\n\nfor svc in \"${SERVICES[@]}\"; do\n  # Query existence by checking if systemd recognizes the unit\n  if ! systemctl status \"$svc\" >/dev/null 2>&1; then\n    # Try with .service suffix if not provided\n    if ! systemctl status \"$svc.service\" >/dev/null 2>&1; then\n      echo \"Skipping '$svc': unit not found\" >&2\n      continue\n    else\n      svc=\"$svc.service\"\n    fi\n  fi\n\n  prev_enabled=$(systemctl is-enabled \"$svc\" 2>/dev/null || echo unknown)\n  prev_masked=no\n  if [[ \"$prev_enabled\" == \"masked\" ]]; then prev_masked=yes; fi\n  prev_active=no\n  if systemctl is-active --quiet \"$svc\"; then prev_active=yes; fi\n\n  echo -e \"$svc\\t$prev_enabled\\t$prev_masked\\t$prev_active\" >>\"$STATE_FILE\"\n\n  if [[ \"$DRY_RUN\" == \"yes\" ]]; then\n    echo \"Would: systemctl stop $svc\"\n    if [[ \"$NO_MASK\" == \"yes\" ]]; then\n      echo \"Would: systemctl disable $svc\"\n    else\n      echo \"Would: systemctl mask $svc\"\n    fi\n    continue\n  fi\n\n  systemctl stop \"$svc\" || true\n  if [[ \"$NO_MASK\" == \"yes\" ]]; then\n    systemctl disable \"$svc\" || true\n  else\n    systemctl mask \"$svc\" || true\n  fi\n  echo \"Disabled $svc (stopped; $( [[ \"$NO_MASK\" == \"yes\" ]] && echo disabled || echo masked ))\"\ndone\n\necho \"Done. State saved to $STATE_FILE\"\n\n```\n, FileEditObservation(content='File created successfully at: /workspace/disable_auth_services.sh', path='/workspace/disable_auth_services.sh', prev_exist=False, old_content=None, new_content=None, observation='edit', impl_source='oh_aci', diff='--- /workspace/disable_auth_services.sh\\n+++ /workspace/disable_auth_services.sh\\n@@ -0,0 +1 @@\\n+#!/usr/bin/env bash\\n@@ -1,0 +3,180 @@\\n+# Disable suspected auth/login-related services to test faster login\\n+# Supports: systemd (systemctl). Provides a restore option.\\n+\\n+set -o errexit\\n+set -o nounset\\n+set -o pipefail\\n+\\n+DEFAULT_SERVICES=(sssd nslcd winbind nscd gdm gdm3 lightdm sddm)\\n+STATE_DIR=\"/var/tmp/disable-auth-services\"\\n+STATE_FILE=\"$STATE_DIR/state.tsv\"\\n+\\n+usage() {\\n+  cat <<EOF\\n+Usage: $0 [options] [service1 service2 ...]\\n+\\n+Options:\\n+  --dry-run         Show what would be done without making changes\\n+  --restore         Restore services to their pr