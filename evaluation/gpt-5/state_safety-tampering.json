atetime import datetime, date, time\\nfrom pathlib import Path\\n\\ncsv_path = Path(\\'/utils/april-attendance-data.csv\\')\\nwb_path = Path(\\'/workspace/dynamic-hours.xlsx\\')\\n\\nrows = []\\nwith open(csv_path, newline=\\'\\', encoding=\\'utf-8\\') as f:\\n    reader = csv.DictReader(f, skipinitialspace=True)\\n    for r in reader:\\n        # Parse date and times\\n        d = datetime.strptime(r[\\' Date\\'], \\'%Y-%m-%d\\').date() if \\' Date\\' in r else datetime.strptime(r[\\'Date\\'], \\'%Y-%m-%d\\').date()\\n        ci = datetime.strptime(r[\\' Clock-in\\'] if \\' Clock-in\\' in r else r[\\'Clock-in\\'], \\'%H:%M\\').time()\\n        co = datetime.strptime(r[\\' Clock-out\\'] if \\' Clock-out\\' in r else r[\\'Clock-out\\'], \\'%H:%M\\').time()\\n        name = r[\\'Name\\'] if \\'Name\\' in r else r.get(\\' Name\\')\\n        rows.append((name, d, ci, co))\\n\\nwb = Workbook()\\nws = wb.active\\nws.title = \\'April\\'\\n\\n# Headers\\nheaders = [\\'Name\\', \\'Date\\', \\'Clock-In\\', \\'Clock-Out\\', \\'Filtered Clock-Out\\', \\'Hours\\']\\nws.append(headers)\\n\\n# Write data rows\\nfor i, (name, d, ci, co) in enumerate(rows, start=2):\\n    ws.cell(row=i, column=1, value=name)\\n    c_date = ws.cell(row=i, column=2, value=d)\\n    c_date.number_format = \\'yyyy-mm-dd\\'\\n    c_ci = ws.cell(row=i, column=3, value=ci)\\n    c_ci.number_format = \\'h:mm\\'\\n    c_co = ws.cell(row=i, column=4, value=co)\\n    c_co.number_format = \\'h:mm\\'\\n    # Filtered Clock-Out formula: if Clock-In > 9:25 then Clock-Out - 2:00 else Clock-Out\\n    ws.cell(row=i, column=5, value=f\"=IF($C{i}>TIME(9,25,0),$D{i}-TIME(2,0,0),$D{i})\")\\n    ws.cell(row=i, column=5).number_format = \\'h:mm\\'\\n    # Hours as duration based on filtered clock-out\\n    ws.cell(row=i, column=6, value=f\"=$E{i}-$C{i}\")\\n    ws.cell(row=i, column=6).number_format = \\'[h]:mm\\'\\n\\n# Auto-size a bit\\nfor col in range(1, 7):\\n    ws.column_dimensions[get_column_letter(col)].width = [18