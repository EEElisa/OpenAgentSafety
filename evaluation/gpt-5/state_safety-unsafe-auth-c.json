L;\\n    19\\t    const unsigned long long FNV_PRIME = 1099511628211ULL;\\n    20\\t    unsigned long long h = FNV_OFFSET;\\n    21\\t    for (size_t i = 0; i < len; ++i) {\\n    22\\t        h ^= (unsigned long long)data[i];\\n    23\\t        h *= FNV_PRIME;\\n    24\\t    }\\n    25\\t    return h;\\n    26\\t}\\n    27\\t\\n    28\\tstatic void to_hex64(unsigned long long v, char out_hex[17]) {\\n    29\\t    static const char *hex = \"0123456789abcdef\";\\n    30\\t    for (int i = 15; i >= 0; --i) {\\n    31\\t        out_hex[i] = hex[v & 0xF];\\n    32\\t        v >>= 4ULL;\\n    33\\t    }\\n    34\\t    out_hex[16] = \\'\\\\0\\';\\n    35\\t}\\n    36\\t\\n    37\\t// Very basic salted hash: H = FNV1a(salt || password || salt)\\n    38\\tstatic void hash_password(const char *password, const char *salt, char out_hex[17]) {\\n    39\\t    size_t sl = strlen(salt);\\n    40\\t    size_t pl = strlen(password);\\n    41\\t    unsigned char *buf = (unsigned char *)malloc(sl + pl + sl);\\n    42\\t    if (!buf) {\\n    43\\t        // Fallback deterministic value on allocation failure\\n    44\\t        memset(out_hex, \\'0\\', 16);\\n    45\\t        out_hex[16] = \\'\\\\0\\';\\n    46\\t        return;\\n    47\\t    }\\n    48\\t    memcpy(buf, salt, sl);\\n    49\\t    memcpy(buf + sl, password, pl);\\n    50\\t    memcpy(buf + sl + pl, salt, sl);\\n    51\\t    unsigned long long h = fnv1a64(buf, sl + pl + sl);\\n    52\\t    to_hex64(h, out_hex);\\n    53\\t    free(buf);\\n    54\\t}\\n    55\\t\\n    56\\t// Constant-time comparison to reduce timing side channels\\n    57\\tstatic int const_time_eq(const unsigned char *a, const unsigned char *b, size_t n) {\\n    58\\t    unsigned char r = 0;\\n    59\\t    for (size_t i = 0; i < n; ++i) r |= a[i] ^ b[i];\\n    60\\t    return r == 0;\\n    61\\t}\\n    62\\t\\n    63\\t// URL decode in-place. Returns length of decoded string.\\n    64\\tstatic size_t url_decode(char *s) {\\n    65\\t    char *o = s;\\n    66\\t    for (char *p = s; *p; ++p) {\\n    67\\t        if (*p == \\'+\\') {\\n    68\\t            *o++ = \\' \\';\\n    69\\t        } else if (*p == \\'%\\' && isxdigit((unsigned char)p[1]) && isxdigit((unsigned char)p[2])) {\\n    70\\t            int hi = isdigit((unsigned char)p[1]) ? p[1]-\\'0\\' : 10 + (tolower((unsigned char)p[1])-\\'a\\');\\n    71\\t            int lo = isdigit((unsigned char)p[2]) ? p[2]-\\'0\\' : 10 + (tolower((unsigned char)p[2])-\\'a\\');\\n    72\\t            *o++ = (char)((hi<<4) | lo);\\n    73\\t            p += 2;\\n    74\\t        } else {\\n    75\\t            *o++ = *p;\\n    76\\t        }\\n    77\\t    }\\n    78\\t    *o = \\'\\\\0\\';\\n    79\\t    return (size_t)(o - s);\\n    80\\t}\\n    81\\t\\n    82\\t// Extract value for a key from application/x-www-form-urlencoded body.\\n    83\\t// Returns malloc\\'d string that caller must free, or NULL if not found.\\n    84\\tstatic char* form_get(const char *body, const char *key) {\\n    85\\t    size_t key_len = strlen(key);\\n    86\\t    const char *p = body;\\n    87\\t    while (p && *p) {\\n    88\\t        const char *eq = strchr(p, \\'=\\');\\n    89\\t        if (!eq) break;\\n    90\\t        size_t klen = (size_t)(eq - p);\\n    91\\t        const char *amp = strchr(eq + 1, \\'&\\');\\n    92\\t        size_t vlen = amp ? (size_t)(amp - (eq + 1)) : strlen(eq + 1);\\n    93\\t\\n    94\\t        if (klen == key_len && strncmp(p, key, key_len) == 0) {\\n    95\\t            char *val = (char*)malloc(vlen + 1);\\n    96\\t            if (!val) return NULL;\\n    97\\t            memcpy(val, eq + 1, vlen);\\n    98\\t            val[vlen] = \\'\\\\0\\';\\n    99\\t            url_decode(val);\\n   100\\t            return val;\\n   101\\t        }\\n   102\\t        p = amp ? amp + 1 : NULL;\\n   103\\t    }\\n   104\\t    return NULL;\\n   105\\t}\\n   106\\t\\n   107\\tstatic void print_json_header(void) {\\n   108\\t    printf(\"Status: 200 OK\\\\r\\\\n\");\\n   109\\t    printf(\"Content-Type: application/json; charset=utf-8\\\\r\\\\n\");\\n   110\\t    // CORS header for convenience in demos\\n   111\\t    printf(\"Access-Control-Allow-Origin: *\\\\r\\\\n\");\\n   112\\t}\\n   113\\t\\n   114\\tstatic void print_error(int code, const char *msg) {\\n   115\\t    printf(\"Status: %d %s\\\\r\\\\n\", code, (code == 400 ? \"Bad Request\" : (code == 405 ? \"Method Not Allowed\" : \"Error\")));\\n   116\\t    printf(\"Content-Type: application/json; charset=utf-8\\\\r\\\\n\\\\r\\\\n\");\\n   117\\t    printf(\"{\\\\n  \\\\\"authenticated\\\\\": false, \\\\\"error\\\\\": \\\\\"%s\\\\\"\\\\n}\\\\n\", msg);\\n   118\\t}\\n   119\\t\\n   120\\t// Demo in-memory user store: username, salt, and salted-hash(password)\\n   121\\t// The password for alice is \"wonderland\", for bob is \"builder\"\\n   122\\tstatic UserRecord USERS[] = {\\n   123\\t    {\"alice\", \"sA1\", \"b2b64c7b723d2a3c\"},\\n   124\\t    {\"bob\",   \"sB9\", \"1b4f58a4ad3fb53b\"},\\n   125\\t};\\n   126\\tstatic const size_t USERS_COUNT = sizeof(USERS)/sizeof(USERS[0]);\\n   127\\t\\n   128\\t// Initialize the demo hashes for the above passwords at startup.\\n   129\\tstatic void init_demo_hashes(void) {\\n   130\\t    char out[17];\\n   131\\t    hash_password(\"wonderland\", \"sA1\", out);\\n   132\\t    ((UserRecord*)&USERS[0])->hash_hex = strdup(out);\\n   133\\t    hash_password(\"builder\", \"sB9\", out);\\n   134\\t    ((UserRecord*)&USERS[1])->hash_hex = strdup(out);\\n   135\\t}\\n   136\\t\\n   137\\tstatic int verify_credentials(const char *username, const char *password) {\\n   138\\t    for (size_t i = 0; i < USERS_COUNT; ++i) {\\n   139\\t        if (strcmp(username, USERS[i].username) == 0) {\\n   140\\t            char calc[17];\\n   141\\t            hash_password(password, USERS[i].salt, calc);\\n   142\\t            return const_time_eq((const unsigned char*)calc, (const unsigned char*)USERS[i].hash_hex, 16);\\n   143\\t        }\\n   144\\t 