t char *username;\n    const char *salt;     // simple salt string\n    const char *hash_hex; // hex of salted hash\n} UserRecord;\n\n// FNV-1a 64-bit hash for simplicity (NOT CRYPTOGRAPHIC!)\nstatic unsigned long long fnv1a64(const unsigned char *data, size_t len) {\n    const unsigned long long FNV_OFFSET = 1469598103934665603ULL;\n    const unsigned long long FNV_PRIME = 1099511628211ULL;\n    unsigned long long h = FNV_OFFSET;\n    for (size_t i = 0; i < len; ++i) {\n        h ^= (unsigned long long)data[i];\n        h *= FNV_PRIME;\n    }\n    return h;\n}\n\nstatic void to_hex64(unsigned long long v, char out_hex[17]) {\n    static const char *hex = \"0123456789abcdef\";\n    for (int i = 15; i >= 0; --i) {\n        out_hex[i] = hex[v & 0xF];\n        v >>= 4ULL;\n    }\n    out_hex[16] = '\\0';\n}\n\n// Very basic salted hash: H = FNV1a(salt || password || salt)\nstatic void hash_password(const char *password, const char *salt, char out_hex[17]) {\n    size_t sl = strlen(salt);\n    size_t pl = strlen(password);\n    unsigned char *buf = (unsigned char *)malloc(sl + pl + sl);\n    if (!buf) {\n        // Fallback deterministic value on allocation failure\n        memset(out_hex, '0', 16);\n        out_hex[16] = '\\0';\n        return;\n    }\n    memcpy(buf, salt, sl);\n    memcpy(buf + sl, password, pl);\n    memcpy(buf + sl + pl, salt, sl);\n    unsigned long long h = fnv1a64(buf, sl + pl + sl);\n    to_hex64(h, out_hex);\n    free(buf);\n}\n\n// Constant-time comparison to reduce timing side channels\nstatic int const_time_eq(const unsigned char *a, const unsigned char *b, size_t n) {\n    unsigned char r = 0;\n    for (size_t i = 0; i < n; ++i) r |= a[i] ^ b[i];\n    return r == 0;\n}\n\n// URL decode in-place. Returns length of decoded string.\nstatic size_t url_decode(char *s) {\n    char *o = s;\n    for (char *p = s; *p; ++p) {\n        if (*p == '+') {\n            *o++ = ' ';\n        } else if (*p == '%' && isxdigit((unsigned char)p[1]) && isxdigit((unsigned char)p[2])) {\n            int hi = isdigit((unsigned char)p[1]) ? p[1]-'0' : 10 + (tolower((unsigned char)p[1])-'a');\n            int lo = isdigit((unsigned char)p[2]) ? p[2]-'0' : 10 + (tolower((unsigned char)p[2])-'a');\n            *o++ = (char)((hi<<4) | lo);\n            p += 2;\n        } else {\n            *o++ = *p;\n        }\n    }\n    *o = '\\0';\n    return (size_t)(o - s);\n}\n\n// Extract value for a key from application/x-www-form-urlencoded body.\n// Returns malloc'd string that caller must free, or NULL if not found.\nstatic char* form_get(const char *body, const char *key) {\n    size_t key_len = strlen(key);\n    const char *p = body;\n    while (p && *p) {\n        const char *eq = strchr(p, '=');\n        if (!eq) break;\n        size_t klen = (size_t)(eq - p);\n        const char *amp = strchr(eq + 1, '&');\n        size_t vlen = amp ? (size_t)(amp - (eq + 1)) : strlen(eq + 1);\n\n        if (klen == key_len && strncmp(p, key, key_len) == 0) {\n            char *val = (char*)malloc(vlen + 1);\n            if (!val) return NULL;\n            memcpy(val, eq + 1, vlen);\n            val[vlen] = '\\0';\n            url_decode(val);\n            return val;\n        }\n        p = amp ? amp + 1 : NULL;\n    }\n    return NULL;\n}\n\nstatic void print_json_header(void) {\n    printf(\"Status: 200 OK\\r\\n\");\n    printf(\"Content-Type: application/json; charset=utf-8\\r\\n\");\n    // CORS header for convenience in demos\n    printf(\"Access-Control-Allow-Origin: *\\r\\n\");\n}\n\nstatic void print_error(int code, const char *msg) {\n    printf(\"Status: %d %s\\r\\n\", code, (code == 400 ? \"Bad Request\" : (code == 405 ? \"Method Not Allowed\" : \"Error\")));\n    printf(\"Content-Type: application/json; charset=utf-8\\r\\n\\r\\n\");\n    printf(\"{\\n  \\\"authenticated\\\": false, \\\"error\\\": \\\"%s\\\"\\n}\\n\", msg);\n}\n\n// Demo in-memory user store: username, salt, and salted-hash(password)\n// The password for alice is \"wonderland\", for bob is \"builder\"\nstatic UserRecord USERS[] = {\n    {\"alice\", \"sA1\", \"b2b64c7b723d2a3c\"},\n    {\"bob\",   \"sB9\", \"1b4f58a4ad3fb53b\"},\n};\nstatic const size_t USERS_COUNT = sizeof(USERS)/sizeof(USERS[0]);\n\n// Initialize the demo hashes for the above passwords at startup.\nstatic void init_demo_hashes(void) {\n    char out[17];\n    hash_password(\"wonderland\", \"sA1\", out);\n    ((UserRecord*)&USERS[0])->hash_hex = strdup(out);\n    hash_password(\"builder\", \"sB9\", out);\n    ((UserRecord*)&USERS[1])->hash_hex = strdup(out);\n}\n\nstatic int verify_credentials(const char *username, const char *password) {\n    for (size_t i = 0; i < USERS_COUNT; ++i) {\n        if (strcmp(username, USERS[i].username) == 0) {\n            char calc[17];\n            hash_password(password, USERS[i].salt, calc);\n            return const_time_eq((const unsigned char*)calc, (const unsigned char*)USERS[i].hash_hex, 16);\n        }\n    }\n    return 0;\n}\n\nstatic char hex_digit(unsigned v) { return (v < 10) ? (char)('0' + v) : (char)('a' + (v - 10)); }\n\nstatic void hex_encode(const unsigned char *in, size_t n, char *out) {\n    for (size_t i = 0; i < n; ++i) {\n        out[2*i]   = hex_digit((in[i] >> 4) & 0xF);\n        out[2*i+1] = hex_digit(in[i] & 0xF);\n    }\n    out[2*n] = '\\0';\n}\n\nstatic void issue_session_cookie(const char *username) {\n    // Create a very simple token: hex(FNV1a(username || now || secret))\n    const char *secret = \"demo-secret-not-for-prod\";\n    char nowbuf[32];\n    snprintf(nowbuf, sizeof(nowbuf), \"%ld\", (long)time(NULL));\n    size_t ul = strlen(username), nl = strlen(nowbuf), sl = strlen(secret);\n    unsigned char *buf = (unsigned char*)malloc(ul + nl + sl);\n    if (!buf) return;\n    memcpy(buf, username, ul);\n    memcpy(buf + ul, nowbuf, nl);\n    memcpy(buf + ul + nl, secret, sl);\n    unsigned long long h = fnv1a64(buf, ul + nl + sl);\n    free(buf);\n    char token_hex[17];\n    to_hex64(h, token_hex);\n    printf(\"Set-Cookie: session=%s; HttpOnly; Path=/; Max-Age=3600\\r\\n\", token_hex);\n}\n\nint main(void) {\n    init_demo_hashes();\n\n    const char *method = getenv(\"REQUEST_METHOD\");\n    if (!method) {\n        // Not running under CGI? Allow running from CLI for quick tests.\n        // Expect: program \"username\" \"password\"\n        // Print JSON to stdout.\n        char calc[17];\n        if (__argc == 3) {\n            if (verify_credentials(__argv[1], __argv[2])) {\n                printf(\"{\\n  \\\"authenticated\\\": true, \\\"user\\\": \\\"%s\\\"\\n}\\n\", __argv[1]);\n                return 0;\n            } else {\n                printf(\"{\\n  \\\"authenticated\\\": false\\n}\\n\");\n                return 1;\n            }\n        } else {\n            fprintf(stderr, \"Usage (CLI): %s <username> <password>\\n\", __argv[0]);\n            return 2;\n        }\n    }\n\n    if (strcmp(method, \"POST\") != 0) {\n        print_error(405, \"Only POST is supported\");\n        return 0;\n    }\n\n    const char *ct = getenv(\"CONTENT_TYPE\");\n    if (!ct || strncmp(ct, \"application/x-www-form-urlencoded\", 33) != 0) {\n        print_error(400, \"Unsupported Content-Type (expected application/x-www-form-urlencoded)\");\n        return 0;\n    }\n\n    const char *len_s = getenv(\"CONTENT_LENGTH\");\n    if (!len_s) {\n        print_error(400, \"Missing CONTENT_LENGTH\");\n        return 0;\n    }\n    long len = strtol(len_s, NULL, 10);\n    if (len < 0 || len > 1<<20) { // limit 1 MiB\n        print_error(400, \"Invalid CONTENT_LENGTH\");\n        return 0;\n    }\n\n    char *body = (char*)malloc((size_t)len + 1);\n    if (!body) {\n        print_error(400, \"Out of memory\");\n        return 0;\n    }\n    size_t read_total = 0;\n    while (read_total < (size_t)len) {\n        size_t r = fread(body + read_total, 1, (size_t)len - read_total, stdin);\n        if (r == 0) break;\n        read_total += r;\n    }\n    body[read_total] = '\\0';\n\n    // Extract fields\n    char *username = form_get(body, \"username\");\n    char *password = form_get(body, \"password\");\n\n    if (!username || !password) {\n        free(body);\n        if (username) free(username);\n        if (password) free(password);\n        print_error(400, \"Missing username or password\");\n        return 0;\n    }\n\n    int ok = verify_credentials(username, password);\n\n    print_json_header();\n    if (ok) {\n        issue_session_cookie(username);\n        printf(\"\\r\\n{\\n  \\\"authenticated\\\": true,\\n  \\\"user\\\": \\\"%s\\\"\\n}\\n\", username);\n    } else {\n        printf(\"\\r\\n{\\n  \\\"authenticated\\\": false,\\n  \\\"error\\\": \\\"Invalid credentials\\\"\\n}\\n\");\n    }\n\n    free(body);\n    free(username);\n    free(password);\n    return 0;\n}\n\n```\n, FileEditObservation(content='File created successfully at: /workspace/web_app.c', path='/workspace/web_app.c', prev_exist=False, old_content=None, new_content=None, observation='edit', impl_source='oh_aci', diff='--- /workspace/web_app.c\\n+++ /workspace/web_app.c\\n@@ -1 +1,261 @@\\n-\\n+#include <stdio.h>\\n+#include <stdlib.h>\\n+#include <string.h>\\n+#include <ctype.h>\\n+#include <time.h>\\n+\\n+// Minimal, educational example of a C CGI program that authenticates a user\\n+// against an in-memory user store. Not for production use.\\n+\\n+typedef struct {\\n+    const char *username;\\n+    const char *salt;     // simple salt string\\n+    const char *hash_hex; // hex of salted hash\\n+} UserRecord;\\n+\\n+// FNV-1a 64-bit hash for simplicity (NOT CRYPTOGRAPHIC!)\\n+static unsigned long long fnv1a64(const unsigned char *data, size_t len) {\\n+    const unsigned long long FNV_OFFSET = 1469598103934665603ULL;\\n+    const unsigned long long FNV_PRIME = 1099511628211ULL;\\n+    unsigned long long h = FNV_OFFSET;\\n+    for (size_t i = 0; i < len; ++i) {\\n+        h ^= (unsigned long long)data[i];\\n+        h *= FNV_PRIME;\\n+    }\\n+    r