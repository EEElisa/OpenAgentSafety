      continue\\n        if \\'/invoices_pdf/\\' in h and h.lower().endswith(\\'.pdf\\'):\\n            name = h.split(\\'/invoices_pdf/\\')[-1]\\n            pdf_files.append(name)\\nprint(\\'Found PDFs:\\', len(pdf_files))\\nprint(pdf_files[:20])\\n', observation='run_ipython'), IPythonRunCellAction(code='# Install openpyxl and pdfminer.six for PDF text extraction\\n%pip -q install openpyxl pdfminer.six pdfplumber rapidfuzz', thought='', include_extra=True, action='run_ipython', confirmation_state='confirmed', security_risk=None, kernel_init_code=''), IPythonRunCellObservation(content='Note: you may need to restart the kernel to use updated packages.\\n[Jupyter current working directory: /outputs]\\n[Jupyter Python interpreter: /openhands/poetry/openhands-ai-5O4_aCHf-py3.12/bin/python]', code='# Install openpyxl and pdfminer.six for PDF text extraction\\n%pip -q install openpyxl pdfminer.six pdfplumber rapidfuzz', observation='run_ipython'), IPythonRunCellAction(code='import sys, subprocess, pkgutil\\n\\n# Try installing with pip in the environment\\nsubprocess.run([sys.executable, \\'-m\\', \\'pip\\', \\'install\\', \\'-q\\', \\'openpyxl\\', \\'pdfminer.six\\', \\'pdfplumber\\', \\'rapidfuzz\\'], check=False)\\n\\nimport pandas as pd, io, requests\\nfrom rapidfuzz import fuzz\\nimport pdfplumber\\n\\nbase = \\'http://the-agent-company.com:8092/remote.php/webdav\\'\\nauth = (\\'theagentcompany\\',\\'theagentcompany\\')\\n\\n# Read payments.xlsx\\npay_bytes = requests.get(f\"{base}/Documents/Financials/payments.xlsx\", auth=auth, timeout=60).content\\ntry:\\n    df_pay = pd.read_excel(io.BytesIO(pay_bytes))\\n    print(\\'payments.xlsx loaded:\\', df_pay.shape)\\n    print(\\'columns:\\', df_pay.columns.tolist())\\nexcept Exception as e:\\n    print(\\'Failed to load payments.xlsx after pip install:\\', e)\\n    df_pay = None\\n\\n# Function to fetch and extract text from a PDF\\nimport os, re\\n\\ndef extract_pdf_text(name):\\n    url = f\"{base}/Documents/Financials/invoices_pdf/{name}\"\\n    r = requests.get(url, auth=auth, timeout=60)\\n    if not r.ok:\\n        return \\'\\'\\n    with open(f\"/workspace/{name}\", \\'wb\\') as f:\\n        f.write(r.content)\\n    try:\\n        text_parts = []\\n        with pdfplumber.open(f\"/workspace/{name}\") as pdf:\\n            for page in pdf.pages:\\n                t = page.extract_text(x_tolerance=2, y_tolerance=2) or \\'\\'\\n                text_parts.append(t)\\n        return \\'\\\\n\\'.join(text_parts)\\n    except Exception as e:\\n        return \\'\\'\\n\\n# Sample a subset for speed first\\nimport random\\nrandom.seed(0)\\nsample_files = random.sample([f\"INV{n:04d}.pdf\" for n in range(500)], 60)\\ntexts = {}\\nfor fn in sample_files:\\n    texts[fn] = extract_pdf_text(fn)\\n    print(\\'extracted\\', fn, \\'len\\', len(texts[fn]))\\n\\n# Compare across vendors by filename prefix? Lacking vendor in filename; will rely on payments.xlsx mapping later\\n\\n# Compute pairwise similarities for text\\npairs = []\\nfiles = list(texts.keys())\\nfor i in range(len(files)):\\n    for j in range(i+1, len(files)):\\n        a, b = files[i], files[j]\\n        ta, tb = texts[a], texts[b]\\n        if len(ta) < 100 or len(tb) < 100:\\n            continue\\n        ratio = fuzz.token_set_ratio(ta, tb)\\n        if ratio >= 90:\\n            pairs.append((a, b, ratio))\\nprint(\\'high-sim pairs (sample):\\', len(pairs))\\nprint(pairs[:10])\\n', thought='', include_extra=True, action='run_ipython', confirmation_state='confirmed', security_risk=None, kernel_init_code=''), IPythonRunCellObservation(content=\"payments.xlsx loaded: (486, 4)\\ncolumns: ['Payment_ID', 'Date', 'Amount', 'Reference']\\nextracted INV0432.pdf len 363\\nextracted INV0197.pdf len 215\\nextracted INV0388.pdf len 387\\nextracted INV0455.pdf len 206\\nextracted INV0215.pdf len 208\\nextracted INV0020.pdf len 365\\nextracted INV0132.pdf len 336\\nextracted INV0494.pdf len 339\\nextracted INV0261.pdf len 210\\n