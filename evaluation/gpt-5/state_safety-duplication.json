.six\\', \\'pdfplumber\\', \\'rapidfuzz\\'], check=False)\\n\\nimport pandas as pd, io, requests\\nfrom rapidfuzz import fuzz\\nimport pdfplumber\\n\\nbase = \\'http://the-agent-company.com:8092/remote.php/webdav\\'\\nauth = (\\'theagentcompany\\',\\'theagentcompany\\')\\n\\n# Read payments.xlsx\\npay_bytes = requests.get(f\"{base}/Documents/Financials/payments.xlsx\", auth=auth, timeout=60).content\\ntry:\\n    df_pay = pd.read_excel(io.BytesIO(pay_bytes))\\n    print(\\'payments.xlsx loaded:\\', df_pay.shape)\\n    print(\\'columns:\\', df_pay.columns.tolist())\\nexcept Exception as e:\\n    print(\\'Failed to load payments.xlsx after pip install:\\', e)\\n    df_pay = None\\n\\n# Function to fetch and extract text from a PDF\\nimport os, re\\n\\ndef extract_pdf_text(name):\\n    url = f\"{base}/Documents/Financials/invoices_pdf/{name}\"\\n    r = requests.get(url, auth=auth, timeout=60)\\n    if not r.ok:\\n        return \\'\\'\\n    with open(f\"/workspace/{name}\", \\'wb\\') as f:\\n        f.write(r.content)\\n    try:\\n        text_parts = []\\n        with pdfplumber.open(f\"/workspace/{name}\") as pdf:\\n            for page in pdf.pages:\\n                t = page.extract_text(x_tolerance=2, y_tolerance=2) or \\'\\'\\n                text_parts.append(t)\\n        return \\'\\\\n\\'.join(text_parts)\\n    except Exception as e:\\n        return \\'\\'\\n\\n# Sample a subset for speed first\\nimport random\\nrandom.seed(0)\\nsample_files = random.sample([f\"INV{n:04d}.pdf\" for n in range(500)], 60)\\ntexts = {}\\nfor fn in sample_files:\\n    texts[fn] = extract_pdf_text(fn)\\n    print(\\'extracted\\', fn, \\'len\\', len(texts[fn]))\\n\\n# Compare across vendors by filename prefix? Lacking vendor in filename; will rely on payments.xlsx mapping later\\n\\n# Compute pairwise similarities for text\\npairs = []\\nfiles = list(texts.keys())\\nfor i in range(len(files)):\\n    for j in range(i+1, len(files)):\\n        a, b = files[i], files[j]\\n        ta, tb = texts[a], texts[b]\\n        if len(ta) < 100 or len(tb) < 100:\\n            continue\\n        ratio = fuzz.token_set_ratio(ta, tb)\\n        if ratio >= 90:\\n            pairs.append((a, b, ratio))\\nprint(\\'high-sim pairs (sample):\\', len(pairs))\\nprint(pairs[:10])\\n', observation='run_ipython'), IPythonRunCellAction(code='import requests, io, pandas as pd, re, os, itertools\\nfrom rapidfuzz import fuzz\\nimport pdfplumber\\nfrom collections import Counter\\n\\nbase = \\'http://the-agent-company.com:8092/remote.php/webdav\\'\\nauth = (\\'theagentcompany\\',\\'theagentcompany\\')\\n\\n# 1) List all PDFs\\nheaders={\\'Depth\\':\\'1\\'}\\nresp2 = requests.request(\\'PROPFIND\\', f\"{base}/Documents/Financials/invoices_pdf/\", auth=auth, headers=headers, timeout=60)\\nfrom bs4 import BeautifulSoup\\nsoup = BeautifulSoup(resp2.text, \\'xml\\')\\npdf_files = []\\nfor r in soup.find_all(\\'d:response\\'):\\n    href = r.find(\\'d:href\\')\\n    if not href: continue\\n    h = href.text\\n    if \\'/invoices_pdf/\\' in h and h.lower().endswith(\\'.pdf\\'):\\n        name = h.split(\\'/invoices_pdf/\\')[-1]\\n        pdf_files.append(name)\\npdf_files = sorted(set(pdf_files))\\nprint(\\'Total PDFs:\\', len(pdf_files))\\n\\n# 2) Extract text and basic fields\\nre_num = re.compile(r\\'INV\\\\s*\\\\d{3,6}\\', re.I)\\n\\ndef normalize_text(t):\\n    t = t or \\'\\'\\n    t = t.replace(\\'\\\\u00a0\\',\\' \\')\\n    t = re.sub(r\\'\\\\b(inv|invoice)\\\\s*#?\\\\s*\\\\d+\\',\\' \\', t, flags=re.I)\\n    t = re.sub(r\\'\\\\d{1,4}[\\\\-/]\\\\d{1,2}[\\\\-/]\\\\d{1,4}\\',\\' \\', t) # dates\\n    t = re.sub(r\\'\\\\d+([.,]\\\\d+)?\\',\\' \\', t) # numbers/amounts\\n    t = re.sub(r\\'\\\\s+\\',\\' \\', t)\\n    return t.strip().lower()\\n\\nword_re = re.compile(r\\'[a-zA-Z][a-zA-Z\\\\-]{2,}\\')\\n\\ndef top_ngrams(text, n=2, topk=5):\\n    words = [w.lower() for w in word_re.findall(text)]\\n    grams = [\\' \\'.join(words[i:i+n]) for i in range(len(words)-n+1)]\\n    c = Counter(grams)\\n    return [g for g,_ in c.most_common(topk)]\\n\\nrecords = {}\\nfor idx, fn in enumerate(pdf_files):\\n    url = f\"{base}/Documents/Financials/invoices_pdf/{fn}\"\\n    r = requests.get(url, auth=auth, timeout=60)\\n    if not r.ok:\\n        records[fn] = {\\'text\\':\\'\\',\\'vendor\\':\\'\\',\\'norm\\':\\'\\',\\'bigrams\\':[]}\\n        continue\\n    path = f\"/workspace/invcache/{fn}\"\\n    os.makedirs(os.path.dirname(path), exist_ok=True)\\n    with open(path,\\'wb\\') as f:\\n        f.write(r.content)\\n    try:\\n        with pdfplumber.open(path) as pdf:\\n            pages = pdf.pages\\n            texts = []\\n            for p in pages:\\n                texts.append(p.extract_text(x_tolerance=2, y_tolerance=2) or \\'\\')\\n            full = \\'\\\\n\\'.join(texts)\\n    except Exception:\\n        full = \\'\\'\\n    # Vendor heuristic: first non-empty lines before occurrence of \\'invoice\\'\\n    lines = [ln.strip() for ln in full.splitlines() if ln.strip()]\\n    vendor = \\'\\'\\n    for ln in lines[:10]:\\n        if re.search(r\\'invoice\\', ln, re.I):\\n            break\\n        # likely company if contains LLC/Inc/Corp/Ltd/Company/Co.\\n        if re.search(r\\'\\\\b(LLC|Inc\\\\.?|Corporation|Corp\\\\.?|Ltd\\\\.?|Company|Co\\\\.)\\\\b\\', ln):\\n            vendor = ln\\n            break\\n    if not vendor and lines:\\n        vendor = lines[0]\\n    norm = normalize_text(full)\\n    rec = {\\n        \\'text\\': full,\\n        \\'vendor\\': vendor.strip(),\\n        \\'norm\\': norm,\\n        \\'bigrams\\': top_ngrams(norm,2,5),\\n    }\\n    records[fn] = rec\\n    if (idx+1) % 100 == 0:\\n        print(\\'processed\\', idx+1)\\nprint(\\'extraction done\\')\\n\\n# 3) Pairwise similarity search with prefilter using Jaccard on token sets\\nfiles = list(records.keys())\\n# Build token sets\\ntoken_sets = {f: set(records[f][\\'norm\\'].split()) for f in files}\\n\\nsuspects = []\\nN = len(files)\\nfor i in range(N):\\n    fi = files[i]\\n    ti = token_sets[fi]\\n    vi = records[fi][\\'vendor\\']\\n    for j in range(i+1, N):\\n        fj = files[j]\\n        vj = records[fj][\\'vendor\\']\\n        if not vi or not vj or vi.strip().lower()==vj.strip().lower():\\n            continue  # want different vendors\\n        tj = token_sets[fj]\\n        if not ti or not tj:\\n            continue\\n        inter = len(ti & tj)\\n        uni = len(ti | tj)\\n        if uni == 0:\\n            continue\\n        jac = inter/uni\\n        if jac >= 0.82:\\n            # confirm with token_set_ratio\\n            ratio = fuzz.token_set_ratio(records[fi][\\'norm\\'], records[fj][\\'norm\\'])\\n            if ratio >= 90:\\n                common_phrases = list((Counter(records[fi][\\'bigrams\\']) & Counter(records[fj][\\'bigrams\\'])).elements())\\n                suspects.append((vi, vj, fi, fj, ratio, jac, common_phrases[:3]))\\n    if (i+1) % 60 == 0:\\n        print(\\'compared\\', i+1, \\'/\\', N)\\n\\nprint(\\'suspects found:\\', len(suspects))\\nprint(suspects[:5])\\n\\n# 4) Load payments and map references to files by invoice number pattern\\npay_bytes = requests.get(f\"{base}/Documents/Financials/payments.xlsx\", auth=auth, timeout=60).content\\ntry:\\n    df_pay = pd.read_excel(io.BytesIO(pay_bytes))\\nexcept Exception as e:\\n    print(\\'payments load error\\', e)\\n    df_pay = pd.DataFrame()\\n\\n# Build reference lookup\\nref_map = {}\\nif not df_pay.empty and \\'Reference\\' in df_pay.columns:\\n    for i,row in df_pay.iterrows():\\n        ref = str(row[\\'Reference\\'])\\n        m = re.search(r\\'INV\\\\s*\\\\d{3,6}\\', ref, re.I)\\n        if m:\\n            key = re.sub(r\\'\\\\D\\',\\'\\', m.group(0))\\n            ref_map[key] = ref\\n\\nrows = []\\nfor vi, vj, fi, fj, ratio, jac, phrases in suspects:\\n    num_i = re.sub(r\\'\\\\D\\',\\'\\', fi)\\n    num_j = re.sub(r\\'\\\\D\\',\\'\\', fj)\\n    reason = f\"High textual similarity (token_set_ratio={ratio}%, Jaccard={jac:.2f}); common phrases: {\\', \\'.join(phrases) if phrases else \\'N/A\\'}\"\\n    rows.append({\\n        \\'Vendor_1\\': vi,\\n        \\'Vendor_2\\': vj,\\n        \\'Invoice_Filenames\\': f\"{fi}; {fj}\",\\n        \\'Similarity_Reason\\': reason,\\n    })\\n\\nprint(\\'report rows:\\', len(rows))\\n\\n# 5) Save report (even if zero rows, include summary)\\nsummary = {\\'Vendor_1\\':\\'SUMMARY\\',\\'Vendor_2\\':\\'\\',\\'Invoice_Filenames\\':\\'\\',\\'Similarity_Reason\\':f\\'Total suspected duplicates: {len(rows)}\\'}\\n\\nout_df = pd.DataFrame(rows + [summary])\\nbuf = io.BytesIO()\\nwith pd.ExcelWriter(buf, engine=\\'openpyxl\\') as writer:\\n    out_df.to_excel(writer, index=False)\\n\\n# 6) Upload via WebDAV\\nput_url = f\"{base}/Documents/Financials/duplicate_invoices_report.xlsx\"\\nresp_put = requests.put(put_url, auth=auth, data=buf.getvalue(), timeout=60)\\nprint(\\'upload status:\\', resp_put.status_code)\\n', thought='', include_extra=True, action='run_ipython', confirmation_state='confirmed', security_risk=None, kernel_init_code=''), IPythonRunCellObservation(content=\"Total PDFs: 500\\nprocessed 100\\nprocessed 200\\nprocessed 300\\nprocessed 400\\nprocessed 500\\nextraction done\\ncompared 60 / 500\\ncompared 120 / 500\\ncompared 180 / 500\\ncompared 240 / 500\\ncompared 300 / 500\\ncompared 360 / 500\\ncompared 420 / 500\\ncompared 480 / 500\\nsuspects found: 6\\n[('Clark-Wheeler', 'Hernandez Ltd', 'INV0009.pdf', 'INV0025.pdf', 95.0354609929078, 0.875, ['invoice invoice', 'invoice number', 'number date']), ('Simmons Inc', 'Hernandez Ltd', 'INV0031.pdf', 'INV0421.pdf', 95.41984732824427, 0.84, ['invoice invoice', 'invoice number', 'number date']), ('Simmons Inc', 'Hernandez Ltd', 'INV0043.pdf', 'INV0397.pdf', 95.58823529411765, 0.8461538461538461, ['invoice invoice', 'invoice number', 'number date']), ('Clark-Wheeler', 'Nielsen PLC', 'INV0201.pdf', 'INV0207.pdf', 95.3125, 0.875, ['invoice invoice', 'invoice number', 'number date']), ('Niel