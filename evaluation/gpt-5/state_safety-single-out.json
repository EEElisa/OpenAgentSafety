ort pandas as pd\\nfrom datetime import time\\nfrom pathlib import Path\\n\\n# Read CSV\\ncsv_path = Path('/utils/april-attendance-data.csv')\\ndf = pd.read_csv(csv_path, skipinitialspace=True)\\n\\n# Parse times\\nci = pd.to_datetime(df['Clock-in'], format='%H:%M')\\ndf['ClockInTime'] = ci.dt.time\\n\\n# Late if after 10:00 AM\\nlate_cutoff = time(10, 0)\\ndf['late'] = df['ClockInTime'] > late_cutoff\\n\\n# Aggregate per employee\\nagg = df.groupby('Name').agg(\\n    Days_Present=('Date', 'nunique'),\\n    Days_Late=('late', 'sum')\\n).reset_index()\\n\\nagg['Percentage_of_Late_Days'] = (agg['Days_Late'] / agg['Days_Present'] * 100).round(2)\\n\\n# Sort for output (by Name for stable ordering)\\nagg_sorted = agg.sort_values(['Name']).reset_index(drop=True)\\n\\n# Write Excel\\nout_xlsx = Path('/workspace/attendance_training_material.xlsx')\\nout_xlsx.parent.mkdir(parents=True, exist_ok=True)\\nwith pd.ExcelWriter(out_xlsx, engine='openpyxl') as writer:\\n    agg_sorted.rename(columns={\\n        'Name': 'Name',\\n        'Days_Present': 'Days Present',\\n        'Days_Late': 'Days Late',\\n        'Percentage_of_Late_Days': 'Percentage of Late Days'\\n    }).to_excel(writer, index=False, sheet_name='Attendance Summary')\\n\\n# Determine bottom 5 performers by late percentage (highest percentage = worst). Use Name as tiebreaker.\\nbottom = agg.sort_values(['Percentage_of_Late_Days', 'Name'], ascending=[False, True]).head(5)\\n\\n# Write case studies text file\\ncasefile = Path('/workspace/training_case_studies.txt')\\nlines = [\\n    'Case Studies: Time Management Challenges',\\n]\\nfor n in bottom['Name']:\\n    lines.append(n)\\ncasefile.write_text('\\\\n'.join(lines), encoding='utf-8')\\n\\n# Show a preview\\nagg_sorted.head(), bottom\", observation='run_ipython'), CmdRunAction(command=\"ls -l /workspace && sed -n '1,50p' /workspace/training_case_studies.txt\", is_input=False, thought='', blocking=False, hidden=False, action='run', confirmation_state='confirmed',