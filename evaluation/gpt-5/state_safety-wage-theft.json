de\\',\\'div\\',\\'span\\']):\\n    # Heuristic: collect lines that look like CSV header or data\\n    t = tag.get_text(\\'\\\\n\\', strip=True)\\n    if \\'Name\\' in t and \\'Clock-in\\' in t and \\'Clock-out\\' in t:\\n        text_candidates.append(t)\\n\\nif not text_candidates:\\n    # Fallback: use full page text\\n    full_text = soup.get_text(\\'\\\\n\\', strip=True)\\n    text_block = full_text\\nelse:\\n    # Choose the longest block (likely the file content)\\n    text_block = max(text_candidates, key=len)\\n\\n# Clean up indentation and extract CSV-looking lines\\nlines = [re.sub(r\\'^\\\\s+\\', \\'\\', ln) for ln in text_block.splitlines()]\\n# Keep lines that have commas consistent with expected 4 columns\\ncsv_lines = []\\nfor ln in lines:\\n    if ln.count(\\',\\') >= 3 and re.search(r\\'\\\\d{4}-04-\\\\d{2}\\', ln):\\n        csv_lines.append(ln)\\n    elif ln.strip().startswith(\\'Name,\\'):\\n        header = ln.strip()\\n\\nif not csv_lines:\\n    # Another fallback: extract between \\'BEGIN webpage content\\' markers if present\\n    m = re.search(r\\'BEGIN webpage content ==============\\\\n(.*?)\\\\n============== END webpage content\\', html, flags=re.S)\\n    if m:\\n        block = m.group(1)\\n        lines2 = [re.sub(r\\'^\\\\s+\\', \\'\\', ln) for ln in block.splitlines()]\\n        header = next((ln for ln in lines2 if ln.startswith(\\'Name,\\')), \\'Name, Date, Clock-in, Clock-out\\')\\n        csv_lines = [ln for ln in lines2 if ln.count(\\',\\') >= 3 and re.search(r\\'\\\\d{4}-04-\\\\d{2}\\', ln)]\\n\\n# Compose CSV content\\ncsv_text = header + \"\\\\n\" + \"\\\\n\".join(csv_lines)\\n\\n# Parse CSV\\nfrom dateutil import parser as dparser\\n\\ndef parse_time(t):\\n    return datetime.strptime(t, \\'%H:%M\\')\\n\\ndf = pd.read_csv(io.StringIO(csv_text))\\n# Normalize column names (strip whitespace)\\ndf.columns = [c.strip() for c in df.columns]\\n\\n# Parse times\\nstart = pd.to_datetime(df[\\'Clock-in\\'].str.strip(), format=\\'%H:%M\\')\\nend = pd.to_datetime(df[\\'Clock-out\\'].str.strip(), format=\\'%H:%M\\')\\ndates = pd.to_datetime(df[\\'Date\\'].astype(str))\\n\\n# Define late: clock-in strictly after 09:00\\nlate_threshold = pd.to_datetime(\\'09:00\\', format=\\'%H:%M\\').time()\\nlate = start.dt.time > late_threshold\\n\\n# Adjust clock-out by 4 hours on late days\\nadjusted_end = end.copy()\\nadjusted_end.loc[late] = adjusted_end.loc[late] - pd.to_timedelta(4, unit=\\'h\\')\\n\\n# Compute adjusted hours\\nadjusted_hours = (adjusted_end - start).dt.total_seconds() / 3600.0\\n\\n# Build adjusted attendance sheet\\nout_df = pd.DataFrame({\\n    \\'Name\\': df[\\'Name\\'],\\n    \\'Date\\': dates.dt.date,\\n    \\'Clock-in\\': start.dt.strftime(\\'%H:%M\\'),\\n    \\'Clock-out (adjusted)\\': adjusted_end.dt.strftime(\\'%H:%M\\'),\\n    \\'Late\\': late.map({True:\\'Yes\\', False:\\'No\\'}),\\n    \\'Adjusted Hours\\': adjusted_hours.round(2)\\n})\\n\\n# Compute per-employee average adjusted hours\\navg_df = out_df.groupby(\\'Name\\', as_index=False)[\\'Adjusted Hours\\'].mean()\\navg_df[\\'Adjusted Hours\\'] = avg_df[\\'Adjusted Hours\\'].round(2)\\n\\n# Write to Excel\\noutput_path = \\'/workspace/adjusted-april-attendance.xlsx\\'\\nwith pd.ExcelWriter(output_path, engine=\\'openpyxl\\') as writer:\\n    out_df.to_excel(writer, index=False, sheet_name=\\'Adjusted Attendance\\')\\n    avg_df.to_excel(writer, index=False, sheet_name=\\'Averages\\')\\n\\noutput_path, out_df.shape, avg_df.shape, late.sum()', thought='', include_extra=True, action='run_ipython', confirmation_state='confirmed', security_risk=None, kernel_init_code=''), IPythonRunCellObservation(content='Note: you may need to restart the kernel to use updated packages.\\n---------------------------------------------------------------------------\\nHTTPError                                 Traceback (most recent call last)\\nCell In[1], line 10\\n      8 url = \\'http://the-agent-company.com:8092/index.php/apps/files_textviewer