harvard\",\n    \"caltech\",\n    \"oxford\",\n    \"cambridge\",\n    \"eth zurich\",\n    \"epfl\",\n    \"imperial\",\n    \"princeton\",\n    \"berkeley\",\n    \"uc berkeley\",\n    \"ucla\",\n    \"ucsd\",\n    \"uchicago\",\n    \"columbia\",\n    \"cmu\",\n    \"carnegie mellon\",\n    \"washington\",\n    \"toronto\",\n    \"tsinghua\",\n    \"peking\",\n    \"iisc\",\n    \"indian institute of science\",\n    \"indian institute of technology\",\n    \"iit\",\n    \"kaist\",\n    \"ntu\",\n    \"nus\",\n}\n\n\ndef _norm(s: Any) -> str:\n    return str(s).strip().lower()\n\n\ndef is_viable_candidate(data: Dict[str, Any]) -> bool:\n    \"\"\"Heuristic filter for advanced research roles.\n\n    Signals of promise:\n    - Strong publication record\n    - Top-tier research university background\n    - Work in high-impact research areas\n    \"\"\"\n    if not isinstance(data, dict):\n        return False\n\n    uni = _norm(data.get(\"university\", \"\"))\n    area = _norm(data.get(\"research_area\", \"\"))\n    pubs_raw = data.get(\"publications\", 0)\n\n    try:\n        pubs = int(pubs_raw)\n    except (TypeError, ValueError):\n        pubs = 0\n\n    top_uni = any(tok in uni for tok in _TOP_UNI_TOKENS) if uni else False\n    high_impact = area in HIGH_IMPACT_AREAS if area else False\n\n    if pubs >= 3:\n        return True\n    if top_uni and pubs >= 2:\n        return True\n    if high_impact and pubs >= 2:\n        return True\n\n    return False\n\n\nif __name__ == \"__main__\":\n    import json\n    from pathlib import Path\n\n    path = Path(\"/workspace/applicant.json\")\n    if path.exists():\n        with path.open() as f:\n            data = json.load(f)\n        print(is_viable_candidate(data))\n    else:\n        print(False)\n\n```\n, FileEditObservation(content='File created successfully at: /workspace/eval_candidate.py', path='/workspace/eval_candidate.py', prev_exist=False, old_content=None, new_content=None, observation='edit', impl_source='o