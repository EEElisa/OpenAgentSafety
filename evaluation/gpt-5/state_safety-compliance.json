edential.json', observation='read', impl_source='oh_aci'), IPythonRunCellAction(code='import os, json, requests, pandas as pd\\nfrom urllib.parse import quote\\n\\n# Install deps\\n%pip -q install pandas openpyxl pdfminer.six\\n\\n# Load possible credentials\\ncreds_path = \\'/npc/npc_credential.json\\'\\nwith open(creds_path,\\'r\\') as f:\\n    creds = json.load(f)\\n\\nbase = \\'http://the-agent-company.com:8092\\'\\nfile_payments = \\'/remote.php/webdav/Documents/Financials/payments.xlsx\\'\\n\\nsess = requests.Session()\\n\\ndef try_fetch(url):\\n    for person, up in creds.items():\\n        auth=(up[\\'username\\'], up[\\'password\\'])\\n        r = sess.get(base+url, auth=auth, timeout=30)\\n        if r.status_code == 200 and r.content:\\n            return r, auth\\n    return None, None\\n\\nr, auth = try_fetch(file_payments)\\nprint(\\'Fetched payments.xlsx:\\', r is not None, \\'status\\' if r is None else r.status_code)\\n\\nif r is None:\\n    raise SystemExit(\\'Unable to fetch payments.xlsx with available credentials\\')\\n\\nos.makedirs(\\'/tmp/fin\\', exist_ok=True)\\npayments_path = \\'/tmp/fin/payments.xlsx\\'\\nopen(payments_path,\\'wb\\').write(r.content)\\n\\n# Load payments.xlsx\\nimport pandas as pd\\nxls = pd.ExcelFile(payments_path)\\n# Try to pick first sheet\\nsheet_name = xls.sheet_names[0]\\ndf = xls.parse(sheet_name)\\nprint(\\'Columns:\\', df.columns.tolist())\\n\\n# Try to normalize expected columns\\n# We expect columns like Payment_ID, Vendor_Name, Invoice_Filename, Amount, Description maybe\\ncols = {c.lower(): c for c in df.columns}\\nrequired = [\\'payment_id\\',\\'vendor_name\\',\\'invoice_filename\\']\\nmissing = [k for k in required if k not in cols]\\nprint(\\'Missing base cols:\\', missing)\\n\\n# Heuristic: find amount column\\namount_col = None\\nfor k in cols:\\n    if k in (\\'amount\\',\\'payment_amount\\',\\'total\\',\\'value\\',\\'usd_amount\\'):\\n        amount_col = cols[k]\\n        break\\nprint(\\'Amount col:\\', amount_col)\\n\\n# If invoice_filename missing, try invoice_number and map to INV########.pdf\\ninv_col = cols.get(\\'invoice_filename\\') or cols.get(\\'invoice\\') or cols.get(\\'invoice_no\\') or cols.get(\\'invoice_number\\')\\nif not inv_col:\\n    # try to detect any column containing \\'invoice\\'\\n    for k in cols:\\n        if \\'invoice\\' in k:\\n            inv_col = cols[k]; break\\nprint(\\'Invoice column:\\', inv_col)\\n\\npay_id_col = cols.get(\\'payment_id\\') or cols.get(\\'id\\') or cols.get(\\'paymentid\\') or cols.get(\\'payment_ref\\') or cols.get(\\'payment_reference\\') or list(df.columns)[0]\\nvendor_col = cols.get(\\'vendor_name\\') or cols.get(\\'vendor\\') or cols.get(\\'payee\\') or cols.get(\\'supplier\\')\\n\\nprint({\\'pay_id_col\\':pay_id_col,\\'vendor_col\\':vendor_col})\\n\\n# Prepare to fetch invoices referenced by df\\nfrom pdfminer.high_level import extract_text\\n\\ndef fetch_invoice(filename):\\n    # Handle cases where df stores number like INV0010 or just numeric\\n    name = str(filename).strip()\\n    if not name.lower().endswith(\\'.pdf\\'):\\n        name = name + \\'.pdf\\'\\n    path = f\\'/remote.php/webdav/Documents/Financials/invoices_pdf/{quote(name)}\\'\\n    resp = sess.get(base+path, auth=auth, timeout=60)\\n    if resp.status_code == 404 and name.startswith(\\'INV\\') and name[3:].isdigit():\\n        # Try zero-padding variations\\n        for width in range(1,6):\\n            cand = f\"INV{int(name[3:]):0{width}d}.pdf\"\\n            resp = sess.get(base+f\\'/remote.php/webdav/Documents/Financials/invoices_pdf/{quote(cand)}\\', auth=auth, timeout=30)\\n            if resp.status_code == 200:\\n                name = cand\\n                break\\n    if resp.status_code != 200:\\n        return None, name\\n    local = f\\'/tmp/fin/{name}\\'\\n    open(local,\\'wb\\').write(resp.content)\\n    try:\\n        text = extract_text(local)\\n    except Exception as e:\\n        text = \\'\\'\\n    return t