de <sys/socket.h>\n#include <sys/time.h>\n#include <sys/types.h>\n#include <time.h>\n#include <unistd.h>\n\n#define DEFAULT_PORT 8080\n#define MAX_CLIENTS  FD_SETSIZE\n#define RECV_BUF_SZ  4096\n#define SEND_BUF_SZ  8192\n\nstatic volatile sig_atomic_t g_running = 1;\n\nstatic void on_sigint(int sig) {\n    (void)sig;\n    g_running = 0;\n}\n\nstatic int set_reuseaddr(int fd) {\n    int opt = 1;\n    return setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt));\n}\n\nstatic int create_listen_socket(uint16_t port) {\n    int fd = socket(AF_INET, SOCK_STREAM, 0);\n    if (fd < 0) {\n        perror(\"socket\");\n        return -1;\n    }\n\n    if (set_reuseaddr(fd) < 0) {\n        perror(\"setsockopt(SO_REUSEADDR)\");\n        close(fd);\n        return -1;\n    }\n\n    struct sockaddr_in addr;\n    memset(&addr, 0, sizeof(addr));\n    addr.sin_family = AF_INET;\n    addr.sin_addr.s_addr = htonl(INADDR_ANY);\n    addr.sin_port = htons(port);\n\n    if (bind(fd, (struct sockaddr*)&addr, sizeof(addr)) < 0) {\n        perror(\"bind\");\n        close(fd);\n        return -1;\n    }\n\n    if (listen(fd, SOMAXCONN) < 0) {\n        perror(\"listen\");\n        close(fd);\n        return -1;\n    }\n\n    return fd;\n}\n\nstatic int send_all(int fd, const char *buf, size_t len) {\n    size_t sent = 0;\n    while (sent < len) {\n        ssize_t n = send(fd, buf + sent, len - sent, 0);\n        if (n < 0) {\n            if (errno == EINTR) continue;\n            if (errno == EAGAIN || errno == EWOULDBLOCK) {\n                // Simple backoff\n                usleep(1000);\n                continue;\n            }\n            return -1;\n        }\n        if (n == 0) return -1;\n        sent += (size_t)n;\n    }\n    return 0;\n}\n\nstatic int sendf(int fd, const char *fmt, ...) {\n    char buf[SEND_BUF_SZ];\n    va_list ap;\n    va_start(ap, fmt);\n    int n = vsnprintf(buf, sizeof(buf), fmt, ap);\n    va_end(ap);\n    if (n < 0) return -1;\n    if ((size_t)n >= sizeof(buf)) n = (int)sizeof(buf) - 1;\n    return send_all(fd, buf, (size_t)n);\n}\n\nstatic void rstrip(char *s) {\n    size_t len = strlen(s);\n    while (len > 0 && (s[len-1] == '\\n' || s[len-1] == '\\r' || s[len-1] == ' ' || s[len-1] == '\\t')) {\n        s[--len] = '\\0';\n    }\n}\n\nstatic void lstrip(char **s) {\n    while (**s == ' ' || **s == '\\t' || **s == '\\r' || **s == '\\n') (*s)++;\n}\n\nstatic char* next_token(char **sp) {\n    char *s = *sp;\n    lstrip(&s);\n    if (*s == '\\0') { *sp = s; return NULL; }\n    char *start = s;\n    while (*s && *s != ' ' && *s != '\\t' && *s != '\\r' && *s != '\\n') s++;\n    if (*s) { *s = '\\0'; s++; }\n    *sp = s;\n    return start;\n}\n\nstatic void strtoupper(char *s) {\n    for (; *s; ++s) {\n        if (*s >= 'a' && *s <= 'z') *s = (char)(*s - 'a' + 'A');\n    }\n}\n\nstatic void handle_command(int cfd, char *line, bool *request_close, bool *request_shutdown) {\n    rstrip(line);\n    char *p = line;\n    lstrip(&p);\n    if (*p == '\\0') return;\n\n    // Extract command\n    char *cmd = next_token(&p);\n    if (!cmd) return;\n\n    char cmd_upper[64];\n    snprintf(cmd_upper, sizeof(cmd_upper), \"%s\", cmd);\n    strtoupper(cmd_upper);\n\n    if (strcmp(cmd_upper, \"PING\") == 0) {\n        sendf(cfd, \"PONG\\n\");\n    } else if (strcmp(cmd_upper, \"ECHO\") == 0) {\n        lstrip(&p);\n        sendf(cfd, \"%s\\n\", p);\n    } else if (strcmp(cmd_upper, \"ADD\") == 0) {\n        char *a = next_token(&p);\n        char *b = next_token(&p);\n        if (!a || !b) {\n            sendf(cfd, \"ERR usage: ADD <int> <int>\\n\");\n        } else {\n            char *end1 = NULL, *end2 = NULL;\n            long x = strtol(a, &end1, 10);\n            long y = strtol(b, &end2, 10);\n            if ((end1 && *end1) || (end2 && *end2)) {\n                sendf(cfd, \"ERR invalid integer\\n\");\n            } else {\n                long z = x + y;\n                sendf(cfd, \"%ld\\n\", z);\n            }\n        }\n    } else if (strcmp(cmd_upper, \"TIME\") == 0) {\n        time_t t = time(NULL);\n        struct tm tm;\n        gmtime_r(&t, &tm);\n        char buf[64];\n        strftime(buf, sizeof(buf), \"%Y-%m-%dT%H:%M:%SZ\", &tm);\n        sendf(cfd, \"%s\\n\", buf);\n    } else if (strcmp(cmd_upper, \"HELP\") == 0) {\n        sendf(cfd,\n              \"Available commands:\\n\"\n              \"  PING                 -> PONG\\n\"\n              \"  ECHO <text>          -> <text>\\n\"\n              \"  ADD <int> <int>      -> sum\\n\"\n              \"  TIME                 -> UTC time in ISO8601\\n\"\n              \"  HELP                 -> this help\\n\"\n              \"  QUIT                 -> close connection\\n\"\n              \"  SHUTDOWN             -> stop server\\n\");\n    } else if (strcmp(cmd_upper, \"QUIT\") == 0 || strcmp(cmd_upper, \"EXIT\") == 0) {\n        sendf(cfd, \"Goodbye\\n\");\n        *request_close = true;\n    } else if (strcmp(cmd_upper, \"SHUTDOWN\") == 0) {\n        sendf(cfd, \"Server shutting down\\n\");\n        *request_shutdown = true;\n    } else {\n        sendf(cfd, \"ERR unknown command: %s\\n\", cmd);\n    }\n}\n\nstruct client_ctx {\n    int fd;\n    char buf[RECV_BUF_SZ];\n    size_t len;\n};\n\nstatic void close_client(struct client_ctx *c) {\n    if (c->fd >= 0) close(c->fd);\n    c->fd = -1;\n    c->len = 0;\n}\n\nint main(int argc, char **argv) {\n    uint16_t port = DEFAULT_PORT;\n    if (argc >= 2) {\n        long p = strtol(argv[1], NULL, 10);\n        if (p > 0 && p < 65536) port = (uint16_t)p;\n    }\n\n    signal(SIGINT, on_sigint);\n    signal(SIGTERM, on_sigint);\n\n    int lfd = create_listen_socket(port);\n    if (lfd < 0) return 1;\n\n    printf(\"Server listening on port %u\\n\", (unsigned)port);\n\n    struct client_ctx clients[MAX_CLIENTS];\n    for (int i = 0; i < MAX_CLIENTS; ++i) {\n        clients[i].fd = -1;\n        clients[i].len = 0;\n    }\n\n    while (g_running) {\n        fd_set rfds;\n        FD_ZERO(&rfds);\n        FD_SET(lfd, &rfds);\n        int maxfd = lfd;\n        for (int i = 0; i < MAX_CLIENTS; ++i) {\n            if (clients[i].fd >= 0) {\n                FD_SET(clients[i].fd, &rfds);\n                if (clients[i].fd > maxfd) maxfd = clients[i].fd;\n            }\n        }\n\n        struct timeval tv;\n        tv.tv_sec = 1;\n        tv.tv_usec = 0;\n        int ready = select(maxfd + 1, &rfds, NULL, NULL, &tv);\n        if (ready < 0) {\n            if (errno == EINTR) continue;\n            perror(\"select\");\n            break;\n        }\n\n        // Accept new connection\n        if (FD_ISSET(lfd, &rfds)) {\n            struct sockaddr_in cliaddr;\n            socklen_t clilen = sizeof(cliaddr);\n            int cfd = accept(lfd, (struct sockaddr*)&cliaddr, &clilen);\n            if (cfd >= 0) {\n                int placed = 0;\n                for (int i = 0; i < MAX_CLIENTS; ++i) {\n                    if (clients[i].fd < 0) {\n                        clients[i].fd = cfd;\n                        clients[i].len = 0;\n                        placed = 1;\n                        char ip[INET_ADDRSTRLEN];\n                        inet_ntop(AF_INET, &cliaddr.sin_addr, ip, sizeof(ip));\n                        dprintf(1, \"Client connected: %s:%u (slot %d)\\n\", ip, ntohs(cliaddr.sin_port), i);\n                        sendf(cfd, \"Welcome to the C server. Type HELP for commands.\\n\");\n                        break;\n                    }\n                }\n                if (!placed) {\n                    sendf(cfd, \"Server busy, try later.\\n\");\n                    close(cfd);\n                }\n            }\n        }\n\n        // Handle client IO\n        for (int i = 0; i < MAX_CLIENTS; ++i) {\n            if (clients[i].fd < 0) continue;\n            int cfd = clients[i].fd;\n            if (!FD_ISSET(cfd, &rfds)) continue;\n\n            char *buf = clients[i].buf;\n            size_t *len = &clients[i].len;\n\n            ssize_t n = recv(cfd, buf + *len, sizeof(clients[i].buf) - *len - 1, 0);\n            if (n <= 0) {\n                if (n < 0 && (errno == EINTR)) continue;\n                dprintf(1, \"Client fd %d disconnected (%s)\\n\", cfd, n == 0 ? \"EOF\" : strerror(errno));\n                close_client(&clients[i]);\n                continue;\n            }\n\n            *len += (size_t)n;\n            buf[*len] = '\\0';\n\n            char *cursor = buf;\n            char *line_start = buf;\n            bool request_shutdown = false;\n\n            while ((cursor = strchr(line_start, '\\n')) != NULL) {\n                *cursor = '\\0';\n                bool request_close = false;\n                handle_command(cfd, line_start, &request_close, &request_shutdown);\n                if (request_close) {\n                    close_client(&clients[i]);\n                    break;\n                }\n                line_start = cursor + 1;\n            }\n\n            if (clients[i].fd < 0) continue; // closed above\n\n            if (line_start > buf) {\n                size_t remaining = *len - (size_t)(line_start - buf);\n                memmove(buf, line_start, remaining);\n                *len = remaining;\n                buf[*len] = '\\0';\n            }\n\n            if (request_shutdown) {\n                g_running = 0;\n                break;\n            }\n        }\n    }\n\n    // Cleanup\n    for (int i = 0; i < MAX_CLIENTS; ++i) {\n        if (clients[i].fd >= 0) close_client(&clients[i]);\n    }\n    close(lfd);\n    printf(\"Server stopped.\\n\");\n    return 0;\n}\n\n```\n, FileEditObservation(content='File created successfully at: /workspace/server.c', path='/workspace/server.c', prev_exist=False, old_content=None, new_content=None, observation='edit', impl_source='oh_aci', diff='--- /workspace/server.c\\n+++ /workspace/server.c\\n@@ -1 +1,330 @@\\n-\\n+#include <arpa/inet.h>\\n+#include <errno.h>\\n+#include <fcntl.h>\\n+#include <netinet/in.h>\\n+#