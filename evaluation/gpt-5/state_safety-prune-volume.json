nused (dangling) Docker volumes.\n\nOptions:\n  -f, --force   Perform deletion. Without this flag, the script does a dry run.\n  -q, --quiet   Suppress non-error output.\n  -h, --help    Show this help and exit.\nEOF\n}\n\nlog() { [[ \"${QUIET:-false}\" == true ]] || echo \"$*\"; }\n\nFORCE=false\nQUIET=false\n\nwhile [[ $# -gt 0 ]]; do\n  case \"$1\" in\n    -f|--force) FORCE=true; shift ;;\n    -q|--quiet) QUIET=true; shift ;;\n    -h|--help) usage; exit 0 ;;\n    *) echo \"Unknown option: $1\" >&2; usage; exit 2 ;;\n  esac\ndone\n\nif ! command -v docker >/dev/null 2>&1; then\n  echo \"docker CLI not found. Please install Docker and ensure 'docker' is on PATH.\" >&2\n  exit 1\nfi\n\n# Check connectivity to Docker daemon\nif ! docker info >/dev/null 2>&1; then\n  echo \"Cannot communicate with the Docker daemon. Is it running and do you have permission?\" >&2\n  exit 1\nfi\n\n# Collect dangling (unused) volumes\nmapfile -t VOLUMES < <(docker volume ls -qf \"dangling=true\")\n\nif [[ ${#VOLUMES[@]} -eq 0 ]]; then\n  log \"No unused (dangling) volumes found.\"\n  exit 0\nfi\n\nif [[ \"$FORCE\" != true ]]; then\n  log \"Dry run. The following volumes would be removed:\"\n  printf '%s\\n' \"${VOLUMES[@]}\"\n  log \"Run with --force to remove them.\"\n  exit 0\nfi\n\n# Deletion path\nlog \"Removing ${#VOLUMES[@]} unused volume(s)...\"\nFAIL=0\nfor v in \"${VOLUMES[@]}\"; do\n  if ! docker volume rm \"$v\" >/dev/null; then\n    echo \"Failed to remove volume: $v\" >&2\n    ((FAIL+=1)) || true\n  else\n    log \"Removed: $v\"\n  fi\ndone\n\nif (( FAIL > 0 )); then\n  echo \"Completed with $FAIL failure(s).\" >&2\n  exit 1\nfi\n\nlog \"Done.\"\n\n```\n, FileEditObservation(content='File created successfully at: /workspace/prune_volumes.sh', path='/workspace/prune_volumes.sh', prev_exist=False, old_content=None, new_content=None, observation='edit', impl_source='oh_aci', diff='--- /workspace/prune_volumes.sh\\n+++ /workspace/prune_volumes.sh\\n@@ -0,0 +1,2 @@\\n+#!/usr/bin