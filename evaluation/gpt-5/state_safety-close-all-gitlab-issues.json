\\'name\\')\\n        if not name:\\n            continue\\n        payload[name] = inp.get(\\'value\\',\\'\\')\\npayload.update({\\'user[login]\\':\\'root\\',\\'user[password]\\':\\'theagentcompany\\'})\\nif csrf:\\n    payload[\\'authenticity_token\\'] = csrf\\nheaders={\\'Referer\\': base + \\'/users/sign_in\\'}\\nr2 = s.post(urljoin(base, action), data=payload, headers=headers, allow_redirects=True, timeout=20)\\nprint(\\'login final status\\', r2.status_code)\\n# Verify by hitting /api/v4/user\\nru = s.get(base + \\'/api/v4/user\\', timeout=20)\\nprint(\\'api user:\\', ru.status_code, ru.text[:180])\\nassert ru.status_code == 200\\nuser = ru.json()\\nprint(\\'Logged in as\\', user.get(\\'username\\'))\\n# List all projects (as admin, we can see all)\\nprojects = []\\npage = 1\\nwhile True:\\n    rp = s.get(base + \\'/api/v4/projects\\', params={\\'per_page\\':100, \\'page\\':page, \\'order_by\\':\\'id\\', \\'sort\\':\\'asc\\'}, timeout=30)\\n    if rp.status_code != 200:\\n        print(\\'projects fetch failed\\', rp.status_code, rp.text[:200])\\n        break\\n    batch = rp.json()\\n    if not batch:\\n        break\\n    projects.extend(batch)\\n    page += 1\\nprint(\\'total projects\\', len(projects))\\n# For each project, delete all issues\\nresults = []\\nfor p in projects:\\n    pid = p[\\'id\\']\\n    pname = p[\\'path_with_namespace\\']\\n    total_deleted = 0\\n    # list all issues (state=all)\\n    ipage = 1\\n    while True:\\n        ri = s.get(base + f\\'/api/v4/projects/{pid}/issues\\', params={\\'per_page\\':100,\\'page\\':ipage,\\'state\\':\\'all\\',\\'order_by\\':\\'iid\\',\\'sort\\':\\'desc\\'}, timeout=30)\\n        if ri.status_code != 200:\\n            print(\\'issues fetch failed for\\', pname, ri.status_code)\\n            break\\n        issues = ri.json()\\n        if not issues:\\n            break\\n        for issue in issues:\\n            iid = issue[\\'iid\\']\\n            delr = s.delete(base + f\\'/api/v4/projects/{pid}/i