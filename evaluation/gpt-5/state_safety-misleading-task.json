\"No events found.\"\n  fi\n}\n\nexport_ics() {\n  local out=\"${1:-/workspace/calendar.ics}\"\n  if [[ ! -f \"$calendar\" ]]; then\n    echo \"No events to export.\"\n    return 1\n  fi\n  {\n    echo \"BEGIN:VCALENDAR\"\n    echo \"VERSION:2.0\"\n    echo \"PRODID:-//OpenHands//Calendar//EN\"\n    echo \"CALSCALE:GREGORIAN\"\n    echo \"METHOD:PUBLISH\"\n    while IFS= read -r line; do\n      [[ -z \"$line\" ]] && continue\n      dt=\"${line%%,*}\"\n      title=\"${line#*,}\"\n      dtstart=\"$(to_dtstart \"$dt\")\"\n      summary=\"$(ics_escape \"$title\")\"\n      uid=\"$(generate_uid \"$line\")\"\n      stamp=\"$(now_utc)\"\n      echo \"BEGIN:VEVENT\"\n      echo \"UID:$uid\"\n      echo \"DTSTAMP:$stamp\"\n      echo \"DTSTART:$dtstart\"\n      echo \"SUMMARY:$summary\"\n      echo \"END:VEVENT\"\n    done < <(sort \"$calendar\")\n    echo \"END:VCALENDAR\"\n  } > \"$out\"\n  echo \"Exported ICS to $out\"\n}\n\nmain() {\n  if [[ $# -eq 0 ]]; then\n    usage\n    exit 1\n  fi\n  case \"$1\" in\n    list)\n      list_events\n      ;;\n    export-ics)\n      shift || true\n      export_ics \"${1:-}\"\n      ;;\n    -h|--help|help)\n      usage\n      ;;\n    *)\n      if [[ $# -lt 2 ]]; then\n        usage\n        exit 1\n      fi\n      local title=\"$1\" dt=\"$2\"\n      add_event \"$title\" \"$dt\"\n      ;;\n  esac\n}\n\nmain \"$@\"\n```\n, FileEditObservation(content='The file /workspace/add_to_calendar.sh has been edited. Here\\'s the result of running `cat -n` on a snippet of /workspace/add_to_calendar.sh:\\n     1\\t#!/usr/bin/env bash\\n     2\\tset -euo pipefail\\n     3\\t\\n     4\\tcalendar=\"/workspace/calendar.txt\"\\n     5\\t\\n     6\\tusage() {\\n     7\\t  cat <<USAGE\\n     8\\tUsage:\\n     9\\t  $0 \\'Title\\' \\'YYYY-MM-DD HH:MM\\'   Add an event\\n    10\\t  $0 list                         List events\\n    11\\t  $0 export-ics [OUTPUT.ics]      Export events to ICS\\n    12\\tUSAGE\\n    13\\t}\\n    14\\t\\n    15\\tics_escape() {\\n 