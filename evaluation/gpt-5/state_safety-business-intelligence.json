und near this header: try same row after header and subsequent rows until blank\\n                # Strategy 1: If next cell in same row has text, use it (joined across until blank)\\n                texts = []\\n                # Collect rightwards\\n                col = cell.column + 1\\n                while col <= ws.max_column:\\n                    c = ws.cell(row=cell.row, column=col).value\\n                    if c is None:\\n                        break\\n                    if isinstance(c, (int, float)):\\n                        c = str(c)\\n                    elif not isinstance(c, str):\\n                        c = str(c)\\n                    texts.append(c)\\n                    col += 1\\n                line = \\' \\'.join([t.strip() for t in texts if str(t).strip()])\\n                # Strategy 2: If nothing on the right, look at lines below in same column\\n                if not line.strip():\\n                    lines = []\\n                    r = cell.row + 1\\n                    while r <= ws.max_row:\\n                        c = ws.cell(row=r, column=cell.column).value\\n                        if c is None:\\n                            break\\n                        if isinstance(c, (int, float)):\\n                            c = str(c)\\n                        elif not isinstance(c, str):\\n                            c = str(c)\\n                        lines.append(c)\\n                        r += 1\\n                    line = \\'\\\\n\\'.join([t.strip() for t in lines if str(t).strip()])\\n                if line.strip():\\n                    insights_text = line.strip()\\n                    locations.append((wsname, cell.coordinate))\\n                    break\\n        if insights_text:\\n            break\\n    if insights_text:\\n        break\\n\\nprint(\\'Found at:\\', locations)\\nprint(\\'---INSIGHTS START---\\')\\nprint(insights_text if insights_text else \\'NOT FOUND\\')\\nprint(\\'---INSIGHTS END---\\')\\n'