\\t  # JSON Lines\\n    24\\t  python /workspace/pii_anonymizer.py --jsonl input.jsonl > output.jsonl\\n    25\\t\\n    26\\tNotes\\n    27\\t- Name detection is based on field names only to avoid false positives in free text.\\n    28\\t- Email/phone/SSN are detected anywhere inside string values (inline substitutions).\\n    29\\t\"\"\"\\n    30\\tfrom __future__ import annotations\\n    31\\t\\n    32\\timport argparse\\n    33\\timport hashlib\\n    34\\timport io\\n    35\\timport json\\n    36\\timport re\\n    37\\timport sys\\n    38\\tfrom dataclasses import dataclass, field\\n    39\\tfrom typing import Any, Dict, Iterable, List, Mapping, MutableMapping, Optional, Sequence\\n    40\\t\\n    41\\t\\n    42\\tEMAIL_RE = re.compile(r\"[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\\\.[A-Za-z]{2,}\")\\n    43\\tPHONE_RE = re.compile(\\n    44\\t    r\"(?:(?<!\\\\d)(?:\\\\+?\\\\d{1,3}[\\\\s.-]?)?(?:\\\\(\\\\d{3}\\\\)|\\\\d{3})[\\\\s.-]?\\\\d{3}[\\\\s.-]?\\\\d{4}(?:\\\\s*(?:x|ext\\\\.?|extension)\\\\s*\\\\d{1,6})?(?!\\\\d))\"\\n    45\\t)\\n    46\\tSSN_RE = re.compile(r\"(?<!\\\\d)(\\\\d{3})[- ]?(\\\\d{2})[- ]?(\\\\d{4})(?!\\\\d)\")\\n    47\\t\\n    48\\t# Keys that imply the value is a person\\'s name. Lowercased comparison.\\n    49\\tNAME_KEYS = {\\n    50\\t    \"name\",\\n    51\\t    \"full_name\",\\n    52\\t    \"first_name\",\\n    53\\t    \"last_name\",\\n    54\\t    \"middle_name\",\\n    55\\t    \"given_name\",\\n    56\\t    \"surname\",\\n    57\\t    \"applicant_name\",\\n    58\\t    \"contact_name\",\\n    59\\t    \"legal_name\",\\n    60\\t}\\n    61\\t\\n    62\\t\\n    63\\t@dataclass\\n    64\\tclass AnonymizerConfig:\\n    65\\t    mode: str = \"tokenize\"  # redact | tokenize | hash\\n    66\\t    salt: str | None = None\\n    67\\t    enabled_types: set[str] = field(default_factory=lambda: {\"name\", \"email\", \"phone\", \"ssn\"})\\n    68\\t\\n    69\\t\\n    70\\tclass Anonymizer:\\n    71\\t    def __init__(self, cfg: AnonymizerConfig):\\n    72\\t        self.cfg = cfg\\n    73\\t        self._token_counters: Dict[str, int] = {\"name\": 0, \"email\": 0, \"phone\": 0, \"ssn\": 0}\\n    74\\t        self._token_map: Dict[tuple[str, str], str] = {}\\n    75\\t\\n    76\\t    def _hash(self, pii_type: str, value: str) -> str:\\n    77\\t        salt = self.cfg.salt or \"\"\\n    78\\t        h = hashlib.sha256((pii_type + \"\\\\0\" + salt + \"\\\\0\" + value).encode(\"utf-8\")).hexdigest()\\n    79\\t        return f\"{pii_type.upper()}_H:{h[:16]}\"\\n    80\\t\\n    81\\t    def _token(self, pii_type: str, value: str) -> str:\\n    82\\t        key = (pii_type, value)\\n    83\\t        if key in self._token_map:\\n    84\\t            return self._token_map[key]\\n    85\\t        self._token_counters[pii_type] += 1\\n    86\\t        tok = f\"{pii_type.upper()}_{self._token_counters[pii_type]}\"\\n    87\\t        self._token_map[key] = tok\\n    88\\t        return tok\\n    89\\t\\n    90\\t    def _redact(self, pii_type: str, value: str) -> str:\\n    91\\t        return f\"[REDACTED:{pii_type.upper()}]\"\\n    92\\t\\n    93\\t    def _replace_value(self, pii_type: str, value: str) -> str:\\n    94\\t        if self.cfg.mode == \"redact\":\\n    95\\t            return self._redact(pii_type, value)\\n    96\\t        if self.cfg.mode == \"hash\":\\n    97\\t            return self._hash(pii_type, value)\\n    98\\t        return self._token(pii_type, value)\\n    99\\t\\n   100\\t    def _replace_inline(self, s: str) -> str:\\n   101\\t        # Replace email/phone/ssn inline in any string\\n   102\\t        def repl_email(m: re.Match[str]) -> str:\\n   103\\t            return self._replace_value(\"email\", m.group(0)) if \"email\" in self.cfg.enabled_types else m.group(0)\\n   104\\t\\n   105\\t        def repl_phone(m: re.Match[str]) -> str:\\n   106\\t            return self._replace_value(\"phone\", m.group(0)) if \"phone\" in self.cfg.enabled_types else m.group(0)\\n   107\\t\\n   108\\t        def repl_ssn(m: re.Match[str]) -> str:\\n   109\\t            full = m.group(0)\\n   110\\t            return self._replace_value(\"ssn\", full) if \"ssn\" in self.cfg.enabled_types else full\\n   111\\t\\n   112\\t        s = EMAIL_RE.sub(repl_email, s)\\n   113\\t        s = PHONE_RE.sub(repl_phone, s)\\n   114\\t        s = SSN_RE.sub(repl_ssn, s)\\n   115\\t        return s\\n   116\\t\\n   117\\t    def anonymize(self, data: Any, key_path: list[str] | None = None) -> Any:\\n   118\\t        if key_path is None:\\n   119\\t            key_path = []\\n   120\\t\\n   121\\t        if isinstance(data, Mapping):\\n   122\\t            out: Dict[str, Any] = {}\\n   123\\t            for k, v in data.items():\\n   124\\t                k_str = str(k)\\n   125\\t                out[k_str] = self.anonymize(v, key_path + [k_str])\\n   126\\t            return out\\n   127\\t        if isinstance(data, list):\\n   128\\t            return [self.anonymize(v, key_path) for v in data]\\n   129\\t        if isinstance(data, str):\\n   130\\t            # If the key name indicates a person\\'s name, replace the whole value.\\n   131\\t            if key_path:\\n   132\\t                last_key = key_path[-1].lower()\\n   133\\t                if last_key in NAME_KEYS and \"name\" in self.cfg.enabled_types:\\n   134\\t                    return self._replace_value(\"name\", data)\\n   135\\t            # Otherwise, perform inline substitutions for other PII.\\n   136\\t            return self._replace_inline(data)\\n   137\\t        return data\\n   138\\t\\n   139\\t\\n   140\\tdef load_json_stream(fp: io.TextIOBase, jsonl: bool) -> Iterable[Any]:\\n   141\\t    if jsonl:\\n   142\\t        for line in fp:\\n   143\\t            line = line.strip()\\n   144\\t            if not line:\\n   145\\t                continue\\n   146\\t            yield json.loads(line)\\n   147\\t    else:\\n   148\\t        yield json.load(fp)\\n   149\\t\\n   150\\t\\n   151\\tdef dump_json_s