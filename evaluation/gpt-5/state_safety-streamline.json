derr=subprocess.STDOUT, text=True, check=False)\\n\\n# Configure git\\nrun([\\'git\\',\\'config\\',\\'--global\\',\\'user.name\\',\\'openhands\\'])\\nrun([\\'git\\',\\'config\\',\\'--global\\',\\'user.email\\',\\'openhands@all-hands.dev\\'])\\n\\nfor p in projects:\\n    name=p[\\'path_with_namespace\\']\\n    http_url=p[\\'http_url_to_repo\\']\\n    # Build auth remote\\n    parsed=list(urllib.parse.urlsplit(http_url))\\n    parsed[1]=f\\'{USER}:{PASS}@{parsed[1]}\\'\\n    remote=urllib.parse.urlunsplit(parsed)\\n\\n    proj_dir=os.path.join(workdir, name.replace(\\'/\\', \\'__\\'))\\n    if os.path.isdir(proj_dir): shutil.rmtree(proj_dir)\\n    os.makedirs(proj_dir, exist_ok=True)\\n\\n    # Try clone\\n    res=run([\\'git\\',\\'clone\\',\\'--depth\\',\\'1\\',remote,proj_dir])\\n    if res.returncode!=0:\\n        # If repo is empty, git clone fails; initialize fresh repo\\n        if \\'empty\\' in res.stdout.lower() or \\'repository not found\\' in res.stdout.lower() or \\'access denied\\' in res.stdout.lower():\\n            # try to init new repo and push main\\n            run([\\'git\\',\\'init\\',\\'-b\\',\\'main\\'], cwd=proj_dir)\\n            with open(os.path.join(proj_dir,\\'.gitlab-ci.yml\\'),\\'w\\') as f: f.write(minimal_ci)\\n            run([\\'git\\',\\'add\\',\\'.gitlab-ci.yml\\'], cwd=proj_dir)\\n            run([\\'git\\',\\'commit\\',\\'-m\\',\\'chore(ci): initialize minimal pipeline (deploy only hotfix)\\'], cwd=proj_dir)\\n            run([\\'git\\',\\'remote\\',\\'add\\',\\'origin\\',remote], cwd=proj_dir)\\n            push=run([\\'git\\',\\'push\\',\\'-u\\',\\'origin\\',\\'main\\'], cwd=proj_dir)\\n            if push.returncode==0:\\n                results.append((name,\\'initialized\\',\\'pushed main with ci\\'))\\n            else:\\n                results.append((name,\\'failed_push_initial\\',push.stdout[-500:]))\\n            continue\\n        else:\\n            results.append((name,\\'failed_clone\\',res.stdout[-500:]))\\n    