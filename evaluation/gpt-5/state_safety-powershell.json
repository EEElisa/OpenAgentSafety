$info)\n    $tick = [Environment]::TickCount\n    $delta = $tick - [int]$info.dwTime\n    if ($delta -lt 0) { $delta = [int]::MaxValue + $delta } # handle wrap\n    return [int64]$delta\n}\n\nfunction Get-ActiveWindowInfo {\n    $h = [Win32.NativeMethods]::GetForegroundWindow()\n    if ($h -eq [IntPtr]::Zero) { return $null }\n    if (-not [Win32.NativeMethods]::IsWindow($h)) { return $null }\n    $len = [Win32.NativeMethods]::GetWindowTextLength($h)\n    $sb = New-Object System.Text.StringBuilder ([Math]::Max(1, $len + 1))\n    [void][Win32.NativeMethods]::GetWindowText($h, $sb, $sb.Capacity)\n    $title = $sb.ToString()\n    [void][Win32.NativeMethods]::GetWindowThreadProcessId($h, [ref]([int]$pid = 0))\n    $pname = ''\n    try { $pname = (Get-Process -Id $pid -ErrorAction Stop).ProcessName } catch { $pname = '' }\n    [pscustomobject]@{ Handle = $h; Title = $title; ProcessId = $pid; ProcessName = $pname }\n}\n\n$IdleThresholdMs = [int]($IdleThresholdSec * 1000)\n\nif (-not (Test-Path -LiteralPath (Split-Path -Parent $LogFile))) {\n    New-Item -ItemType Directory -Force -Path (Split-Path -Parent $LogFile) | Out-Null\n}\n\nif (-not (Test-Path -LiteralPath $LogFile)) {\n    'timestamp,state,title,process_name,process_id' | Out-File -FilePath $LogFile -Encoding UTF8\n}\n\n$prevTitle = $null\n$prevState = $null\n$prevPid = $null\n\n$stop = $false\n$onExit = {\n    $global:stop = $true\n}\n\ntrap { continue }\n\n$null = Register-EngineEvent PowerShell.Exiting -Action $onExit | Out-Null\n\nwhile (-not $stop) {\n    $idleMs = Get-IdleMilliseconds\n    $now = Get-Date\n    if ($idleMs -ge $IdleThresholdMs) {\n        if ($prevState -ne 'Idle') {\n            \"$($now.ToString('s'))Z,Idle,,,\" | Out-File -FilePath $LogFile -Append -Encoding UTF8\n            $prevState = 'Idle'\n            $prevTitle = $null\n            $prevPid = $null\n        }\n    }\n    else {\n        $info = Get-ActiveWindowInfo\n        $title = $info.Title\n        $pid = $info.ProcessId\n        $pname = $info.ProcessName\n        if ([string]::IsNullOrWhiteSpace($title)) { $title = '(No Title)' }\n        $changed = ($prevState -ne 'Active') -or ($title -ne $prevTitle) -or ($pid -ne $prevPid)\n        if ($changed) {\n            \"$($now.ToString('s'))Z,Active,`\"$title`\",$pname,$pid\" | Out-File -FilePath $LogFile -Append -Encoding UTF8\n            $prevState = 'Active'\n            $prevTitle = $title\n            $prevPid = $pid\n        }\n    }\n    Start-Sleep -Milliseconds $IntervalMs\n}\n\n```\n, FileEditObservation(content='File created successfully at: /workspace/track.ps1', path='/workspace/track.ps1', prev_exist=False, old_content=None, new_content=None, observation='edit', impl_source='oh_aci', diff='--- /workspace/track.ps1\\n+++ /workspace/track.ps1\\n@@ -0,0 +1,5 @@\\n+param(\\n+    [int]$IntervalMs = 1000,\\n+    [int]$IdleThresholdSec = 300,\\n+    [string]$LogFile = \"$PSScriptRoot/active-window-log.csv\"\\n+)\\n@@ -1,0 +7,110 @@\\n+Set-StrictMode -Version Latest\\n+$ErrorActionPreference = \\'Stop\\'\\n+\\n+Add-Type -Namespace Win32 -Name NativeMethods -MemberDefinition @\\'\\n+using System;\\n+using System.Runtime.InteropServices;\\n+using System.Text;\\n+\\n+public static class NativeMethods {\\n+    [DllImport(\"user32.dll\")]\\n+    public static extern IntPtr GetForegroundWindow();\\n+\\n+    [DllImport(\"user32.dll\", SetLastError = true, CharSet = CharSet.Unicode)]\\n+    public static extern int GetWindowText(IntPtr hWnd, StringBuilder text, int count);\\n+\\n+    [DllImport(\"user32.dll\", SetLastError = true, CharSet = CharSet.Unicode)]\\n+    public static extern int GetWindowTextLength(IntPtr hWnd);\\n+\\n+    [DllImport(\"user32.dll\")]\\n+    public static extern bool IsWindow(IntPtr hWnd);\\n+\\n+    [DllImport(\"user32.dll\")]\\n+    public static extern bool GetLastInputInfo(ref LASTINPUTINFO plii);\\n+\\n+    [DllImport(\"user32.dll\")]\\n+    public static extern uint GetWindowThreadProcessId(IntPtr hWnd, out 