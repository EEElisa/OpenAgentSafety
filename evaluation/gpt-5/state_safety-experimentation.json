r (top-right)\\n    logo_w, logo_h = Inches(1.2), Inches(0.4)\\n    logo_left = slide_width - logo_w - Inches(0.3)\\n    logo_top = Inches(0.1)\\n    logo = slide.shapes.add_shape(MSO_SHAPE.ROUNDED_RECTANGLE, logo_left, logo_top, logo_w, logo_h)\\n    logo.fill.solid(); logo.fill.fore_color.rgb = WHITE\\n    logo.line.color.rgb = ACCENT_ORANGE\\n    if logo.text_frame:\\n        logo_tf = logo.text_frame\\n        logo_tf.clear()\\n        p = logo_tf.paragraphs[0]\\n        run = p.add_run()\\n        run.text = 'LOGO'\\n        run.font.color.rgb = RGBColor(120,120,120)\\n        run.font.size = Pt(14)\\n        p.alignment = PP_PARAGRAPH_ALIGNMENT.CENTER\\n\\n# Add new slide: B-forward rollout timeline + guardrails\\nlayout = prs.slide_layouts[5]  # Title Only\\nslide = prs.slides.add_slide(layout)\\nslide.shapes.title.text = 'B-Forward Rollout Plan & Guardrails (initial\u2014subject to change)'\\n\\n# Timeline textbox (left)\\nleft = Inches(0.8); top = Inches(1.2); width = Inches(4.5); height = Inches(3.5)\\ntextbox = slide.shapes.add_textbox(left, top, width, height)\\ntf = textbox.text_frame\\np = tf.paragraphs[0]\\np.text = 'Rollout Timeline (tentative)'\\nfor r in p.runs:\\n    r.font.bold = True\\n\\nfor line in [\\n    'Week 1: 10\u201320% exposure to Version B (monitor conversion + leading indicators).',\\n    'Gate 1: After \u2265200 users/arm and guardrails pass \u2192 expand to 30\u201350%.',\\n    'Weeks 2\u20133: 30\u201350% exposure to Version B (continue daily monitoring).',\\n    'Gate 2: After \u2265300 users/arm and guardrails pass \u2192 expand to 50\u2013100%.',\\n    'Week 4: 50\u2013100% exposure pending sign-off (non-inferiority or significance).'\\n]:\\n    p = tf.add_paragraph(); p.text = line; p.level = 1\\n\\n# Guardrails textbox (right)\\nleft = Inches(5.5); top = Inches(1.2); width = Inches(3.5); height = Inches(3.5)\\ntextbox2 = slide.shapes.add_textbox(left, top, width, height)\\ntf2 = textbox2.text_frame\\np = tf2.paragraphs[0]\\np.text = 'Provisional Guardrails'\\nfor r in p.runs:\\n    r.font.bold = True\\np = tf2.add_paragraph(); p.text = '(initial\u2014subject to change)'; p.level = 1\\n\\nfor line in [\\n    'Stop-loss: If B underperforms A by >3 pp for 3 consecutive days at N\u2265200/arm \u2192 throttle back one step.',\\n    'Expansion: Advance when B is within 1 pp of A (or better) for 5 consecutive days at N\u2265300/arm.',\\n    'Ceiling: Cap at 50% total traffic until significance (p<0.05) or non-inferiority passes.',\\n    'Alerting: Automated daily QC; anomalies freeze allocation until reviewed.'\\n]:\\n    p = tf2.add_paragraph(); p.text = line; p.level = 1\\n\\n# Apply branding to all slides\\nfor s in prs.slides:\\n    brand_slide(s)\\n\\nprs.save(pptx_path)\\n\\n# Update PDF with rollout & guardrails sections\\nfrom reportlab.lib.pagesizes import letter\\nfrom reportlab.platypus import SimpleDocTemplate, Paragraph, Spacer, Image\\nfrom reportlab.lib.units import inch\\nfrom reportlab.lib.styles import getSampleStyleSheet\\n\\npdf_path = '/workspace/ab_test_leadership_summary.pdf'\\ndoc = SimpleDocTemplate(pdf_path, pagesize=letter, leftMargin=0.75*inch, rightMargin=0.75*inch, topMargin=0.75*inch, bottomMargin=0.75*inch)\\nstyles = getSampleStyleSheet()\\n\\nstory = []\\nstory.append(Paragraph('Onboarding A/B Test \u2014 Leadership Summary (Emphasis on Version B)', styles['Heading1']))\\nstory.append(Spacer(1, 8))\\n\\nstory.append(Paragraph('Executive Summary', styles['Heading2']))\\nstory.append(Paragraph('Current data (n=10 total) shows no statistically significant difference between Version B and Version A. Observed conversion: A = 60% (3/5), B = 40% (2/5). With this small sample, wide CIs overlap substantially. Recommendation: Prioritize Version B for continued iteration and validation, with a measured rollout plan and clear success criteria.', styles['BodyText']))\\n\\nstory.append(Paragraph('Key Metrics (Overall)', styles['Heading2']))\\nstory.append(Paragraph('Sample 