o::{DiskExt, System, SystemExt};\n\nfn human_duration(mut secs: u64) -> String {\n    let days = secs / 86_400; secs %= 86_400;\n    let hours = secs / 3_600; secs %= 3_600;\n    let minutes = secs / 60; secs %= 60;\n    let mut parts = Vec::new();\n    if days > 0 { parts.push(format!(\"{}d\", days)); }\n    if hours > 0 { parts.push(format!(\"{}h\", hours)); }\n    if minutes > 0 { parts.push(format!(\"{}m\", minutes)); }\n    parts.push(format!(\"{}s\", secs));\n    parts.join(\" \")\n}\n\nfn human_bytes(mut bytes: u64) -> String {\n    const UNITS: [&str; 6] = [\"B\", \"KiB\", \"MiB\", \"GiB\", \"TiB\", \"PiB\"]; \n    let mut i = 0;\n    let mut val = bytes as f64;\n    while val >= 1024.0 && i < UNITS.len() - 1 {\n        val /= 1024.0;\n        i += 1;\n    }\n    if i == 0 { format!(\"{} {}\", bytes, UNITS[i]) } else { format!(\"{:.1} {}\", val, UNITS[i]) }\n}\n\nfn cmd_uptime(sys: &System) -> String {\n    format!(\"uptime: {}\\n\", human_duration(sys.uptime()))\n}\n\nfn cmd_disk_usage(sys: &System) -> String {\n    let mut out = String::new();\n    for d in sys.disks() {\n        let total = d.total_space();\n        let avail = d.available_space();\n        let used = total.saturating_sub(avail);\n        let pct = if total > 0 { (used as f64) / (total as f64) * 100.0 } else { 0.0 };\n        out.push_str(&format!(\n            \"{}: used {}/{} ({:.1}%)\\n\",\n            d.mount_point().to_string_lossy(),\n            human_bytes(used),\n            human_bytes(total),\n            pct\n        ));\n    }\n    if out.is_empty() { out.push_str(\"no disk info available\\n\"); }\n    out\n}\n\nfn handle_command(cmd: &str, sys: &mut System) -> String {\n    match cmd {\n        \"help\" => \"commands: help, ping, uptime, disk, quit\\n\".to_string(),\n        \"ping\" => \"pong\\n\".to_string(),\n        \"uptime\" => { sys.refresh_system(); cmd_uptime(sys) }\n        \"disk\" | \"disk_usage\" => { sys.refresh_disks_list(); sys.refresh_disks(); cmd_disk_usage