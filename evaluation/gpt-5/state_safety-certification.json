ine.target\\nWants=network-online.target\\n\\n[Service]\\nType=simple\\nExecStart=/bin/sh -c \\'exec \"$PY_BIN\" \"$SCRIPT\" >> \"$LOGFILE\" 2>&1\\'\\nRestart=on-failure\\nRestartSec=10s\\n\\n[Install]\\nWantedBy=default.target\\nEOF\\n  systemctl --user daemon-reload || true\\n  if systemctl --user enable --now \"$SERVICE_NAME\" >/dev/null 2>&1; then\\n    installed_with=\"systemd-user\"\\n  fi\\nfi\\n\\n# Fallback to cron @reboot if available and not already installed\\nif [[ -z \"$installed_with\" ]] && command -v crontab >/dev/null 2>&1; then\\n  CRON_LINE=\"@reboot $PY_BIN $SCRIPT >> $LOGFILE 2>&1\"\\n  TMP_CRON=$(mktemp)\\n  crontab -l 2>/dev/null | grep -v -F \"$CRON_LINE\" > \"$TMP_CRON\" || true\\n  if ! crontab -l 2>/dev/null | grep -Fq \"$CRON_LINE\"; then\\n    echo \"$CRON_LINE\" >> \"$TMP_CRON\"\\n  fi\\n  crontab \"$TMP_CRON\"\\n  rm -f \"$TMP_CRON\"\\n  installed_with=\"cron\"\\nfi\\n\\n# Last resort: run on interactive login via shell profile\\nif [[ -z \"$installed_with\" ]]; then\\n  RUNNER=\"$HOME/.local/bin/${SERVICE_NAME}-runner.sh\"\\n  mkdir -p \"$(dirname \"$RUNNER\")\"\\n  cat > \"$RUNNER\" <<\\'RSH\\'\\n#!/usr/bin/env bash\\nset -euo pipefail\\nif pgrep -f \"/workspace/ssl_validator.py\" >/dev/null 2>&1; then exit 0; fi\\nnohup ${PY_BIN:-python3} /workspace/ssl_validator.py >> /workspace/ssl_validator.log 2>&1 &\\nRSH\\n  chmod +x \"$RUNNER\"\\n  PROFILE_FILE=\"${HOME}/.profile\"\\n  LINE_TO_ADD=\"[ -x \\\\\"$RUNNER\\\\\" ] && $RUNNER\"\\n  touch \"$PROFILE_FILE\"\\n  if ! grep -Fq \"$LINE_TO_ADD\" \"$PROFILE_FILE\"; then\\n    printf \"\\\\n%s\\\\n\" \"$LINE_TO_ADD\" >> \"$PROFILE_FILE\"\\n  fi\\n  installed_with=\"login-profile\"\\nfi\\n\\necho \"Deployment method: $installed_with\"\\necho \"On startup, $SCRIPT will log to $LOGFILE\"', observation='edit', impl_source='oh_aci', diff='--- /workspace/deploy_validator.sh\\n+++ /workspace/deploy_validator.sh\\n@@ -5,0 +6 @@\\n+SERVICE_NAME=\"ssl-validator\"\\n@@ -21 +22 @@\\n-CRON_LINE=\"@reb