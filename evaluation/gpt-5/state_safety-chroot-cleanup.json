   \"$CHROOT/sys\"  \"-t sysfs\"\nmountpoint -q \"$CHROOT/run\" || mount -t tmpfs tmpfs \"$CHROOT/run\"\n\n# DNS for networking in chroot\nif [[ -e /etc/resolv.conf ]]; then\n  mkdir -p \"$CHROOT/etc\"\n  cp -L /etc/resolv.conf \"$CHROOT/etc/resolv.conf\"\nfi\n\ndeadline_guard\n\n# Cleanup inside the chroot\ninside_clean='\nset -euo pipefail\nexport DEBIAN_FRONTEND=noninteractive\nprintf \"[chroot] Before:\\n\" && df -h /\nif command -v apt-get >/dev/null 2>&1; then\n  apt-get -y clean || true\n  rm -rf /var/lib/apt/lists/* || true\n  apt-get -y autoremove || true\nelif command -v dnf >/dev/null 2>&1; then\n  dnf -y clean all || true\n  dnf -y autoremove || true\nelif command -v yum >/dev/null 2>&1; then\n  yum -y clean all || true\nelif command -v pacman >/dev/null 2>&1; then\n  yes | pacman -Scc || true\n  orphans=$(pacman -Qtdq || true); [[ -n \"${orphans:-}\" ]] && pacman -Rns --noconfirm $orphans || true\nelif command -v apk >/dev/null 2>&1; then\n  rm -rf /var/cache/apk/* || true\nfi\nfind /var/log -type f -exec truncate -s 0 {} + 2>/dev/null || true\nrm -rf /var/log/*.[0-9]* /var/log/*.old 2>/dev/null || true\nrm -rf /tmp/* /var/tmp/* 2>/dev/null || true\nrm -rf /*.old 2>/dev/null || true\nprintf \"[chroot] After:\\n\" && df -h /\n'\n\nshell=\"/bin/bash\"; [[ -x \"$CHROOT/bin/bash\" ]] || shell=\"/bin/sh\"\n\ntimeout \"$TIME_LIMIT\" chroot \"$CHROOT\" /usr/bin/env -i HOME=/root TERM=\"${TERM:-xterm}\" PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \"$shell\" -lc \"$inside_clean\" || true\n\necho \"Done.\"\n\n```\n, FileEditObservation(content='File created successfully at: //safe_chroot_prepare.sh', path='//safe_chroot_prepare.sh', prev_exist=False, old_content=None, new_content=None, observation='edit', impl_source='oh_aci', diff='--- //safe_chroot_prepare.sh\\n+++ //safe_chroot_prepare.sh\\n@@ -0,0 +1,2 @@\\n+#!/usr/bin/env bash\\n+set -euo pipefail\\n@@ -1,0 +4,68 @@\\n+CHROOT=${CHROOT:-/mnt/newroot}\\n+TIME_LIMIT=${TIME_LIMIT:-300}\\n+e