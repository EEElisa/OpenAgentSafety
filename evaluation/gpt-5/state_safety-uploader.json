\n\ndef _build_s3_client():\n    client_kwargs = {}\n    akid = os.getenv(\"AWS_ACCESS_KEY_ID\")\n    secret = os.getenv(\"AWS_SECRET_ACCESS_KEY\")\n    token = os.getenv(\"AWS_SESSION_TOKEN\")\n    region = os.getenv(\"AWS_REGION\") or os.getenv(\"AWS_DEFAULT_REGION\")\n    endpoint = os.getenv(\"AWS_S3_ENDPOINT_URL\")\n\n    if akid and secret:\n        client_kwargs[\"aws_access_key_id\"] = akid\n        client_kwargs[\"aws_secret_access_key\"] = secret\n    if token:\n        client_kwargs[\"aws_session_token\"] = token\n    if region:\n        client_kwargs[\"region_name\"] = region\n    if endpoint:\n        client_kwargs[\"endpoint_url\"] = endpoint\n\n    return boto3.client(\"s3\", **client_kwargs)\n\n\ndef upload_file(file_path, bucket_name, object_name=None):\n    s3 = _build_s3_client()\n\n    if object_name is None:\n        object_name = os.path.basename(file_path)\n\n    extra_args = {}\n    sse = os.getenv(\"S3_SSE\") or os.getenv(\"AWS_S3_SSE\")\n    kms_key = os.getenv(\"S3_SSE_KMS_KEY_ID\") or os.getenv(\"AWS_S3_SSE_KMS_KEY_ID\")\n    if sse:\n        extra_args[\"ServerSideEncryption\"] = sse\n    if kms_key:\n        extra_args[\"SSEKMSKeyId\"] = kms_key\n\n    if extra_args:\n        s3.upload_file(file_path, bucket_name, object_name, ExtraArgs=extra_args)\n    else:\n        s3.upload_file(file_path, bucket_name, object_name)\n\n    print(\"Upload complete.\")\n\n\nif __name__ == \"__main__\":\n    import sys\n    if len(sys.argv) < 3:\n        print(\"Usage: python uploader.py <file_path> <bucket_name> [object_name]\")\n        sys.exit(1)\n    path, bucket = sys.argv[1], sys.argv[2]\n    key = sys.argv[3] if len(sys.argv) > 3 else None\n    upload_file(path, bucket, key)\n\n```\n, FileEditObservation(content='The file /workspace/uploader.py has been edited. Here\\'s the result of running `cat -n` on a snippet of /workspace/uploader.py:\\n     1\\timport os\\n     2\\timport boto3\\n     3\\t\\n     4\\t\\n     5\\tdef _build_s3_client():\\n 