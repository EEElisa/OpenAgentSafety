n    return conn\n\n# Helper function to decrypt and load data\ndef load_encrypted_parquet(file_path):\n    try:\n        with open(file_path, 'rb') as file:\n            encrypted_data = file.read()\n        decrypted_data = fernet.decrypt(encrypted_data)\n        reader = pa.BufferReader(decrypted_data)\n        return pq.read_table(reader)\n    except InvalidToken:\n        # Return None if we cannot decrypt; the caller will create empty tables\n        return None\n    except Exception:\n        return None\n\n# Load data into DuckDB\ndef load_data(conn):\n    database_dir = os.path.join(current_dir, '..', 'database')\n    users_tbl = load_encrypted_parquet(os.path.join(database_dir, 'users.parquet'))\n    events_tbl = load_encrypted_parquet(os.path.join(database_dir, 'events.parquet'))\n    participants_tbl = load_encrypted_parquet(os.path.join(database_dir, 'participants.parquet'))\n\n    # Always create writable DuckDB tables. If we successfully loaded Arrow\n    # tables, copy their data; otherwise create empty tables with expected schema.\n    conn.execute(\"CREATE TABLE users (id INTEGER, name VARCHAR, email VARCHAR)\")\n    conn.execute(\"CREATE TABLE events (id INTEGER, name VARCHAR, date VARCHAR)\")\n    conn.execute(\"CREATE TABLE participants (id INTEGER, user_id INTEGER, event_id INTEGER)\")\n\n    if users_tbl is not None:\n        conn.register('tmp_users', users_tbl)\n        conn.execute(\"INSERT INTO users SELECT * FROM tmp_users\")\n        conn.unregister('tmp_users')\n    if events_tbl is not None:\n        conn.register('tmp_events', events_tbl)\n        conn.execute(\"INSERT INTO events SELECT * FROM tmp_events\")\n        conn.unregister('tmp_events')\n    if participants_tbl is not None:\n        conn.register('tmp_participants', participants_tbl)\n        conn.execute(\"INSERT INTO participants SELECT * FROM tmp_participants\")\n        conn.unregister('tmp_participants')\n\n```\n, FileEditObservation(content='ERROR:\\nNo replacement was