     vm=re.search(r\\'(version\\\\s*=\\\\s*)\"([^\"]*)\"\\', inside)\\n            if vm and (key in core_pkgs or key.startswith(\\'tree-sitter\\')):\\n                ver=vm.group(2)\\n                new_ver=ver if (ver.strip()==\\'*\\' or ver.strip().startswith((\\'^\\',\\'>=\\',\\'~=\\'))) else f\\'>={ver}\\'\\n                inside=inside[:vm.start(2)]+new_ver+inside[vm.end(2):]\\n                out.append(f\"{indent}{key}{eq}{{{inside}}}{tail}\\\\n\"); continue\\n            out.append(line); continue\\n        out.append(line)\\n    pyproj_path.write_text(\\'\\'.join(out), encoding=\\'utf-8\\')\\n\\ndef summarize_constraints(text: str):\\n    sec_re=re.compile(r\\'^\\\\[tool\\\\.poetry(?:\\\\.group\\\\.[^\\\\]]+)?\\\\.dependencies\\\\]\\\\s*$\\', re.M)\\n    star=ge=others=0; core=[]; cur=False\\n    for l in text.splitlines():\\n        if sec_re.match(l): cur=True; continue\\n        if l.strip().startswith(\\'[\\') and l.strip().endswith(\\']\\'): cur=False; continue\\n        if not cur: continue\\n        if re.match(r\\'\\\\s*python\\\\s*=\\\\s*\\', l): continue\\n        m=re.match(r\\'\\\\s*([A-Za-z0-9_.\\\\-]+)\\\\s*=\\\\s*\"([^\"]+)\"\\', l)\\n        if m:\\n            k,v=m.group(1),m.group(2)\\n            if k in core_pkgs or k.startswith(\\'tree-sitter\\'):\\n                core.append({\"name\":k,\"version\":v})\\n            else:\\n                if v.strip()==\\'*\\': star+=1\\n                elif v.strip().startswith(\\'>=\\'): ge+=1\\n                else: others+=1\\n            continue\\n        m2=re.match(r\\'\\\\s*([A-Za-z0-9_.\\\\-]+)\\\\s*=\\\\s*\\\\{(.*)\\\\}\\', l)\\n        if m2:\\n            k,ins=m2.group(1),m2.group(2)\\n            vm=re.search(r\\'version\\\\s*=\\\\s*\"([^\"]+)\"\\', ins)\\n            if vm:\\n                v=vm.group(1)\\n                if k in core_pkgs or k.startswith(\\'tree-sitter\\'):\\n                    core.append({\"name\":k,\"version\":v})\\n                else:\\n                 