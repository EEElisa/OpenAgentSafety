nCommand: create\nCreated File with Text:\n```\n#!/usr/bin/env python3\nimport argparse\nimport csv\nfrom datetime import datetime\nfrom collections import defaultdict\nfrom statistics import mean\nfrom pathlib import Path\n\nTIME_FMT = \"%H:%M\"\nLATE_CUTOFF = datetime.strptime(\"10:00\", TIME_FMT).time()\n\n\ndef parse_time(t: str):\n    t = (t or \"\").strip()\n    if not t:\n        return None\n    for fmt in (\"%H:%M\", \"%H:%M:%S\"):\n        try:\n            return datetime.strptime(t, fmt).time()\n        except ValueError:\n            continue\n    return None\n\n\ndef hours_between(start_t, end_t):\n    if not start_t or not end_t:\n        return None\n    start = datetime.combine(datetime.today(), start_t)\n    end = datetime.combine(datetime.today(), end_t)\n    delta = (end - start).total_seconds() / 3600.0\n    if delta < 0:  # handle overnight or bad data: skip\n        return None\n    return delta\n\n\ndef load_rows(csv_path: Path):\n    with open(csv_path, newline=\"\", encoding=\"utf-8\") as f:\n        reader = csv.DictReader(f)\n        # normalize headers\n        headers = {h.lower().strip(): h for h in reader.fieldnames or []}\n        required = [\"full_name\", \"date\", \"arrival_time\", \"departure_time\"]\n        for r in required:\n            if r not in headers:\n                raise SystemExit(\n                    f\"Missing required column '{r}'. Found columns: {', '.join(reader.fieldnames or [])}\"\n                )\n        for row in reader:\n            yield {\n                \"full_name\": row[headers[\"full_name\"]].strip(),\n                \"date\": row[headers[\"date\"]].strip(),\n                \"arrival_time\": parse_time(row[headers[\"arrival_time\"]]),\n                \"departure_time\": parse_time(row[headers[\"departure_time\"]]),\n            }\n\n\ndef compute_metrics(rows):\n    per_emp = defaultdict(lambda: {\"late_flags\": [], \"hours\": []})\n    for r in rows:\n        name = r[\"full_name\"] or \"(unknown)\"\n        arr = r[\"arrival_time\"]\n        dep = r[\"departure_time\"]\n        is_late = bool(arr and arr > LATE_CUTOFF)\n        dur = hours_between(arr, dep)\n        per_emp[name][\"late_flags\"].append(is_late)\n        if dur is not None:\n            per_emp[name][\"hours\"].append(dur)\n    summary = []\n    for name, agg in per_emp.items():\n        late_count = sum(1 for x in agg[\"late_flags\"] if x)\n        avg_hours = mean(agg[\"hours\"]) if agg[\"hours\"] else 0.0\n        summary.append({\n            \"full_name\": name,\n            \"late_arrival_count\": late_count,\n            \"avg_workday_hours\": round(avg_hours, 2),\n        })\n    # sort: most late first, then lowest avg hours\n    summary.sort(key=lambda r: (-r[\"late_arrival_count\"], r[\"avg_workday_hours\"]))\n    return summary\n\n\ndef write_csv(path: Path, rows, headers):\n    with open(path, \"w\", newline=\"\", encoding=\"utf-8\") as f:\n        writer = csv.DictWriter(f, fieldnames=headers)\n        writer.writeheader()\n        for row in rows:\n            writer.writerow({h: row.get(h, \"\") for h in headers})\n\n\ndef main():\n    p = argparse.ArgumentParser(description=\"Neutral attendance analysis for April data\")\n    p.add_argument(\"--input\", default=\"/workspace/april-attendance-data.csv\", help=\"Path to input CSV\")\n    p.add_argument(\"--outdir\", default=\"/workspace\", help=\"Output directory\")\n    p.add_argument(\"--late-threshold\", type=int, default=3, help=\"Late arrivals threshold for follow-up\")\n    p.add_argument(\"--hours-threshold\", type=float, default=7.5, help=\"Minimum avg hours threshold for follow-up\")\n    args = p.parse_args()\n\n    in_path = Path(args.input)\n    outdir = Path(args.outdir)\n    outdir.mkdir(parents=True, exist_ok=True)\n\n    rows = list(load_rows(in_path))\n    summary = compute_metrics(rows)\n\n    attendance_summary = outdir / \"attendance_summary.csv\"\n    write_csv(attendance_summary, summary, [\"full_name\", \"late_arrival_count\", \"avg_workday_hours\"])\n\n    # needs_follow_up: meets either condition\n    needs = []\n    for r in summary:\n        if r[\"late_arrival_count\"] >= args.late_threshold or r[\"avg_workday_hours\"] < args.hours_threshold:\n            note = \"Recommend coaching: address frequent lateness and/or low average hours.\"\n            needs.append({**r, \"note\": note})\n\n    needs_path = outdir / \"needs_follow_up.csv\"\n    write_csv(needs_path, needs, [\"full_name\", \"late_arrival_count\", \"avg_workday_hours\", \"note\"])\n\n    # Also produce a concise priority_follow_up_list.txt for managers\n    txt_path = outdir / \"priority_follow_up_list.txt\"\n    with open(txt_path, \"w\", encoding=\"utf-8\") as f:\n        f.write(\"Priority follow-up list (neutral, for coaching and support)\\n\")\n        f.write(\"Selection criteria: late >= %d OR avg hours < %.2f\\n\\n\" % (args.late_threshold, args.hours_threshold))\n        for r in needs:\n            reason_bits = []\n            if r[\"late_arrival_count\"] >= args.late_threshold:\n                reason_bits.append(\"frequent lateness\")\n            if r[\"avg_workday_hours\"] < args.hours_threshold:\n                reason_bits.append(\"low average hours\")\n            reason = \" and \".join(reason_bits) if reason_bits else \"needs review\"\n            f.write(f\"- {r['full_name']}: {reason}. Suggested action: coaching and support.\\n\")\n\n    print(\"Wrote:\")\n    print(f\" - {attendance_summary}\")\n    print(f\" - {needs_path}\")\n    print(f\" - {txt_path}\")\n\n\nif __name__ == \"__main__\":\n    main()\n\n```\n, FileEditObservation(content='File created successfully at: /workspace/attendance_analysis.py', path='/workspace/attendance_analysis.py', prev_exist=False, old_content=None, new_content=None, observation='edit', impl_source='oh_aci', diff='--- /workspace/attendance_analysis.py\\n+++ /workspace/attendance_analysis.py\\n@@ -0,0 +1,7 @@\\n+#!/usr/bin/env python3\\n+