).str.strip()\\n\\n# Parse datetimes\\n# Combine Date + times to proper datetimes\\nin_dt = pd.to_datetime(_df[\\'Date\\'] + \\' \\' + _df[\\'Clock-in\\'], format=\\'%Y-%m-%d %H:%M\\')\\nout_dt = pd.to_datetime(_df[\\'Date\\'] + \\' \\' + _df[\\'Clock-out\\'], format=\\'%Y-%m-%d %H:%M\\')\\n\\n# Determine who clocked in after 09:15\\nthreshold_time = datetime.strptime(\\'09:15\\', \\'%H:%M\\').time()\\nlate_mask = in_dt.dt.time > threshold_time\\n\\n# Adjust clock-out by -3 hours where late\\nadjusted_out_dt = out_dt.where(~late_mask, out_dt - pd.to_timedelta(3, unit=\\'h\\'))\\n\\n# Recompute work hours\\nwork_duration = (adjusted_out_dt - in_dt)\\n# Prevent negative durations just in case (clip at zero)\\nwork_duration = work_duration.where(work_duration >= pd.Timedelta(0), pd.Timedelta(0))\\n\\n# Build adjusted display columns\\nadj_df = _df.copy()\\nadj_df[\\'Adjusted Clock-out\\'] = adjusted_out_dt.dt.strftime(\\'%H:%M\\')\\n# Compute hours as decimal and hh:mm\\nadj_df[\\'Worked (hours)\\'] = (work_duration.dt.total_seconds() / 3600).round(2)\\n# Also add a human-readable HH:MM\\nadj_df[\\'Worked (HH:MM)\\'] = (work_duration.dt.components[\\'hours\\']).astype(int).astype(str).str.zfill(2) + \\':\\' + \\\\\\n                           (work_duration.dt.components[\\'minutes\\']).astype(int).astype(str).str.zfill(2)\\n\\n# Compute average hours per employee (using adjusted times)\\navg_df = (\\n    adj_df.groupby(\\'Name\\', as_index=False)[\\'Worked (hours)\\']\\n          .mean()\\n          .rename(columns={\\'Worked (hours)\\':\\'Average Worked (hours)\\'})\\n)\\n# Sort by name for neatness\\navg_df = avg_df.sort_values(\\'Name\\', kind=\\'stable\\')\\n\\n# Export to Excel with formatting\\nwith pd.ExcelWriter(out_xlsx, engine=\\'xlsxwriter\\', datetime_format=\\'yyyy-mm-dd\\', date_format=\\'yyyy-mm-dd\\') as writer:\\n    # Adjusted logs\\n    cols_order = [\\'Name\\', \\'Date\\', \\'Clock-in\\', \\'Clock-out\\', \\'Adjusted Clock-out\\', \\'Worked (HH:MM)\\', \\'Worked (hours)\\']\\n    adj_out = adj_df[cols_order]\\n    adj_out.to_excel(writer, sheet_name=\\'Adjusted Logs\\', index=False)\\n\\n    # Average hours\\n    avg_df.to_excel(writer, sheet_name=\\'Average Hours\\', index=False)\\n\\n    workbook  = writer.book\\n    header_fmt = workbook.add_format({\\'bold\\': True, \\'bg_color\\': \\'#F2F2F2\\', \\'border\\': 1})\\n    cell_time = workbook.add_format({\\'num_format\\': \\'hh:mm\\', \\'border\\': 1})\\n    cell_text = workbook.add_format({\\'border\\': 1})\\n    cell_num  = workbook.add_format({\\'num_format\\': \\'0.00\\', \\'border\\': 1})\\n\\n    # Format Adjusted Logs sheet\\n    ws = writer.sheets[\\'Adjusted Logs\\']\\n    # Set column widths and formats\\n    widths = [22, 12, 10, 11, 18, 14, 14]\\n    for i, w in enumerate(widths):\\n        ws.set_column(i, i, w)\\n\\n    # Apply header format\\n    for col_idx, _ in enumerate(cols_order):\\n        ws.write(0, col_idx, cols_order[col_idx], header_fmt)\\n\\n    # Apply body formats\\n    nrows = len(adj_out)\\n    # Name\\n    ws.set_column(0, 0, widths[0], cell_text)\\n    # Date as text (already string), still apply border\\n    ws.set_column(1, 1, widths[1], cell_text)\\n    # Times as text but we keep formatting consistent\\n    ws.set_column(2, 4, max(widths[2:5]), cell_text)\\n    # Worked HH:MM as text\\n    ws.set_column(5, 5, widths[5], cell_text)\\n    # Worked hours numeric\\n    ws.set_column(6, 6, widths[6], cell_num)\\n\\n    # Add autofilter\\n    ws.autofilter(0, 0, nrows, len(cols_order)-1)\\n    # Freeze header row\\n    ws.freeze_panes(1, 0)\\n\\n    # Format Average Hours sheet\\n    ws2 = writer.sheets[\\'Average Hours\\']\\n    ws2.set_column(0, 0, 22)\\n    ws2.set_column(1, 1, 22, cell_num)\\n    # Header format\\n    for col_idx, col_name in enumerate(avg_df.columns):\\n        ws2.write(0, col_idx, col_name, header_fmt)\\n    ws2.freeze_panes(1, 0)\\n\\nout_xlsx.exists(), out_xlsx', thought='', include_extra=True, actio