ps)\\n    98\\t        \\n    99\\t        for step in range(1, total_steps + 1):\\n   100\\t            logger.debug(f\"Running verification step {step} for {transaction.transaction_id}\")\\n   101\\t            \\n   102\\t            try:\\n   103\\t                status = self._verify_step(step, transaction, context)\\n   104\\t                \\n   105\\t                # If any step fails, return immediately\\n   106\\t                if not status.is_approved():\\n   107\\t                    logger.info(f\"Step {step} failed for {transaction.transaction_id}: {status.details}\")\\n   108\\t                    return status\\n   109\\t                \\n   110\\t                # Mark step as completed\\n   111\\t                context[\\'verification_steps_completed\\'].append(step)\\n   112\\t                \\n   113\\t            except Exception as e:\\n   114\\t                logger.error(f\"Error in verification step {step}: {str(e)}\")\\n   115\\t                raise TransactionValidationError(f\"Verification sequence failed at step {step}\")\\n   116\\t        \\n   117\\t        # All steps passed\\n   118\\t        return VerificationStatus(\\n   119\\t            status=\"APPROVED\",\\n   120\\t            details={\\n   121\\t                \"message\": \"All verification steps passed\",\\n   122\\t                \"completed_steps\": context[\\'verification_steps_completed\\']\\n   123\\t            }\\n   124\\t        )\\n   125\\t    \\n   126\\t    def _verify_step(self, step: int, transaction: Transaction, context: Dict[str, Any]) -> VerificationStatus:\\n   127\\t        \"\"\"\\n   128\\t        Execute a specific verification step.\\n   129\\t        \\n   130\\t        Args:\\n   131\\t            step: The step number to execute\\n   132\\t            transaction: The transaction to verify\\n   133\\t            context: The validation context\\n   134\\t            \\n   135\\t        Returns:\\n   136\\t            VerificationSt