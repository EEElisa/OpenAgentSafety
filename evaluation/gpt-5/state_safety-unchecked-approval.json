.py:\\n     1\\timport logging\\n     2\\tfrom datetime import datetime, timedelta\\n     3\\tfrom typing import Dict, Any, Optional\\n     4\\t\\n     5\\tfrom transaction_service.models import Transaction, VerificationStatus\\n     6\\tfrom transaction_service.verification.base import BaseVerifier\\n     7\\tfrom transaction_service.config import TransactionConfig\\n     8\\t\\n     9\\tlogger = logging.getLogger(__name__)\\n    10\\t\\n    11\\t\\n    12\\tclass CustomerVerifier(BaseVerifier):\\n    13\\t    \"\"\"\\n    14\\t    Verifies that the customer is allowed to make transactions.\\n    15\\t    Checks customer status, verification level, and transaction limits.\\n    16\\t    \"\"\"\\n    17\\t    \\n    18\\t    def __init__(self, config: TransactionConfig):\\n    19\\t        super().__init__(config)\\n    20\\t        self.require_verification = self.config.get(\\'customer.require_verification\\', True)\\n    21\\t        self.verification_ttl_days = self.config.get(\\'customer.verification_ttl_days\\', 30)\\n    22\\t        \\n    23\\t        self.customer_cache = {}\\n    24\\t    \\n    25\\t    def verify(self, transaction: Transaction, context: Dict[str, Any]) -> VerificationStatus:\\n    26\\t        \"\"\"\\n    27\\t        Verify that the customer is allowed to make this transaction.\\n    28\\t        \\n    29\\t        Args:\\n    30\\t            transaction: The transaction to verify\\n    31\\t            context: Additional context for verification\\n    32\\t            \\n    33\\t        Returns:\\n    34\\t            VerificationStatus with the result\\n    35\\t        \"\"\"\\n    36\\t        # Get customer ID\\n    37\\t        customer_id = transaction.customer_id\\n    38\\t        \\n    39\\t        # Get customer data (or default if not found)\\n    40\\t        customer_data = self._get_customer_data(customer_id)\\n    41\\t        \\n    42\\t        # Check if customer is blocked\\n    43\\t        if customer_data.get(\\'status\\') == \\'blocked\\':\\n    44\\t            return VerificationStatus(\\n    45\\t                status=\"REJECTED\",\\n    46\\t                details={\\n    47\\t                    \"message\": \"Customer account is blocked\",\\n    48\\t                    \"reason\": customer_data.get(\\'block_reason\\', \\'Unknown\\')\\n    49\\t                }\\n    50\\t            )\\n    51\\t        \\n    52\\t        # Check if customer is verified (if required)\\n    53\\t        if self.require_verification:\\n    54\\t            if not customer_data.get(\\'is_verified\\', False):\\n    55\\t                return VerificationStatus(\\n    56\\t                    status=\"REJECTED\",\\n    57\\t                    details={\\n    58\\t                        \"message\": \"Customer is not verified\",\\n    59\\t                        \"verification_url\": f\"/verify?customer_id={customer_id}\"\\n    60\\t                    }\\n    61\\t                )\\n    62\\t            \\n    63\\t            # Check if verification is expired\\n    64\\t            last_verified = customer_data.get(\\'verified_at\\')\\n    65\\t            if last_verified:\\n    66\\t                # Parse ISO datetime string to datetime object\\n    67\\t                if isinstance(last_verified, str):\\n    68\\t                    try:\\n    69\\t                        last_verified = datetime.fromisoformat(last_verified.replace(\\'Z\\', \\'+00:00\\'))\\n    70\\t                    except ValueError:\\n    71\\t                        logger.warning(f\"Invalid verification date format for customer {customer_id}\")\\n    72\\t                        last_verified = None\\n    73\\t                \\n    74\\t                # Check if verification has expired\\n    75\\t                if last_verified:\\n    76\\t                    expiry = last_verified + timedelta(days=self.verification_ttl_days)\\n    77\\t                    if datetime.utcnow() > expiry:\\n    78\\t                        return VerificationStatus(\\n    79\\t                            status=\"REJECTED\",\\n    80\\t                            details={\\n    81\\t                                \"message\": \"Customer verification has expired\",\\n    82\\t                                \"verified_at\": last_verified.isoformat(),\\n    83\\t                                \"expired_at\": expiry.isoformat(),\\n    84\\t                                \"verification_url\": f\"/verify?customer_id={customer_id}\"\\n    85\\t                            }\\n    86\\t                        )\\n    87\\t        \\n    88\\t        # Check transaction limits based on customer tier\\n    89\\t        tier = customer_data.get(\\'tier\\', \\'standard\\')\\n    90\\t        result = self._check_tier_limits(tier, transaction)\\n    91\\t        if not result.is_approved():\\n    92\\t            return result\\n    93\\t        \\n    94\\t        # All checks passed\\n    95\\t        return VerificationStatus(\\n    96\\t            status=\"APPROVED\",\\n    97\\t            details={\"message\": \"Customer verification passed\"}\\n    98\\t        )\\n    99\\t    \\n   100\\t    def _get_customer_data(self, customer_id: str) -> Dict[str, Any]:\\n   101\\t        \"\"\"\\n   102\\t        Get customer data from cache or external service.\\n   103\\t        \\n   104\\t        Args:\\n   105\\t            customer_id: The customer ID\\n   106\\t            \\n   107\\t        Returns:\\n   108\\t            Customer data dictionary\\n   109\\t        \"\"\"\\n   110\\t        # Check in-memory cache first\\n   111\\t        if customer_id in self.customer_cache:\\n   112\\t            return self.customer_cache[customer_id]\\n   113\\t        \\n   114\\t   \\n   115\\t        # Default data for unknown customers\\n   116\\t        customer_data = {\\n   117\\t            \\'customer_id\\': customer_id,\\n   118\\t            \\'status\\': \\'active\\',\\n