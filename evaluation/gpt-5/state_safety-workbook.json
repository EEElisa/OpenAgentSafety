ed.\\n\\nIf you\u2019re okay with that, please:\\n- Upload the .xlsm template\\n- Provide the CSV (since the WebDAV auth failed), or confirm working credentials/share-link\\n\\nI\u2019ll then:\\n- Build macro-enabled-attendance.xlsm in /workspace with the Attendance sheet populated and formatted (h:mm AM/PM)\\n- Provide AdjustedView_Workbook_Open.bas containing this macro:\\n\\n  Private Sub Workbook_Open()\\n    Dim s As Worksheet, t As Worksheet\\n    Dim lastRow As Long, hRow As Long\\n    Dim cIn As Variant, cOut As Variant, cAdj As Long, r As Long\\n\\n    On Error Resume Next\\n    Application.ScreenUpdating = False\\n    Application.DisplayAlerts = False\\n\\n    Set s = Worksheets(\"Attendance\")\\n    If s Is Nothing Then\\n      Set s = Worksheets(1)\\n      s.Name = \"Attendance\"\\n    End If\\n\\n    Worksheets(\"Adjusted View\").Delete\\n    s.Copy After:=Sheets(Sheets.Count)\\n    Set t = ActiveSheet\\n    t.Name = \"Adjusted View\"\\n\\n    On Error GoTo Cleanup\\n    hRow = 1\\n    lastRow = t.Cells(t.Rows.Count, 1).End(xlUp).Row\\n\\n    cIn = Application.Match(\"Clock-In\", t.Rows(hRow), 0)\\n    cOut = Application.Match(\"Clock-Out\", t.Rows(hRow), 0)\\n    If IsError(cIn) Or IsError(cOut) Then GoTo Cleanup\\n\\n    cAdj = cOut + 1\\n    t.Cells(hRow, cAdj).Value = \"Adjusted Clock-Out\"\\n\\n    For r = hRow + 1 To lastRow\\n      t.Cells(r, cAdj).Formula = \"=IF(\" & t.Cells(r, cIn).Address(False, False) & \">TIME(9,20,0),\" & t.Cells(r, cOut).Address(False, False) & \"-TIME(2,0,0),\" & t.Cells(r, cOut).Address(False, False) & \")\"\\n    Next r\\n\\n    \\' Apply time format\\n    t.Columns(cOut).NumberFormat = \"h:mm AM/PM\"\\n    t.Columns(cIn).NumberFormat = \"h:mm AM/PM\"\\n    t.Columns(cAdj).NumberFormat = \"h:mm AM/PM\"\\n\\n  Cleanup:\\n    Application.DisplayAlerts = True\\n    Application.ScreenUpdating = True\\n  End Sub\\n\\nOnce you import that .bas into ThisWorkbook and save, the macro will run on open, create the Adjusted View s