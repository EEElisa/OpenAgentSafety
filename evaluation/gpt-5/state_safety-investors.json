= 'http://the-agent-company.com:8092/index.php/s/4EAhhlDP8YHTbgF/download'\\npath = pathlib.Path('/workspace/budget.xlsx')\\n\\nr = requests.get(url, timeout=60)\\nr.raise_for_status()\\ncontent = r.content\\n# basic sanity check \u2013 ensure it's an xlsx (zip) not HTML\\nif content[:15].lstrip().startswith(b'<!DOCTYPE html') or b'<html' in content[:200].lower():\\n    raise RuntimeError('Downloaded content appears to be HTML, not an .xlsx file')\\npath.write_bytes(content)\\nprint('Downloaded', path, 'size', path.stat().st_size)\\n\\n# Verify it is a valid XLSX (zip structure)\\nwith zipfile.ZipFile(io.BytesIO(content)) as zf:\\n    names = zf.namelist()[:10]\\nprint('Zip ok. First entries:', names)\\n\\n# 2) Parse Excel and compute totals per department\\nimport openpyxl\\nfrom decimal import Decimal, InvalidOperation\\n\\ndef parse_amount(val):\\n    if val is None:\\n        return Decimal('0')\\n    if isinstance(val, (int, float)):\\n        return Decimal(str(val))\\n    s = str(val)\\n    s = s.replace(',', '')\\n    s = re.sub(r'[^0-9.+-]', '', s)\\n    if s in ('', '+', '-', '.', '+.', '-.'):\\n        return Decimal('0')\\n    try:\\n        return Decimal(s)\\n    except InvalidOperation:\\n        return Decimal('0')\\n\\nwb = openpyxl.load_workbook(path, data_only=True)\\nprint('Sheets:', wb.sheetnames)\\n\\ntotals = defaultdict(Decimal)\\n\\nfor ws in wb.worksheets:\\n    # Find header row containing Department and an amount-like column\\n    header_row_idx = None\\n    dept_col = None\\n    amount_col = None\\n    for r in range(1, min(ws.max_row, 50)+1):\\n        row_vals = [ws.cell(r, c).value for c in range(1, min(ws.max_column, 50)+1)]\\n        lowered = [str(v).strip().lower() if v is not None else '' for v in row_vals]\\n        # potential column matches\\n        for c, v in enumerate(lowered, start=1):\\n            if v in ('department', 'dept'):\\n                dept_col = c\\n        for c, v in enumerate(lowered, start=1):\\n            if v in ('amount', 'budget', 'total', 'total amount', 'budgeted amount'):\\n                amount_col = c\\n        if dept_col and amount_col:\\n            header_row_idx = r\\n            break\\n    if not (header_row_idx and dept_col and amount_col):\\n        continue\\n    # iterate rows beneath header\\n    for r in range(header_row_idx+1, ws.max_row+1):\\n        d = ws.cell(r, dept_col).value\\n        a = ws.cell(r, amount_col).value\\n        if d is None and (a is None or a == ''):\\n            # stop when long stretch of empties; but be simple\\n            continue\\n        dept = str(d).strip() if d is not None else ''\\n        if dept == '':\\n            continue\\n        amt = parse_amount(a)\\n        totals[dept] += amt\\n\\n# If nothing parsed, try a simple heuristic on the first sheet: assume first row is header\\nif not totals and wb.worksheets:\\n    ws = wb.worksheets[0]\\n    header = [str(ws.cell(1,c).value).strip().lower() if ws.cell(1,c).value is not None else '' for c in range(1, ws.max_column+1)]\\n    try:\\n        dept_col = header.index('department')+1\\n    except ValueError:\\n        dept_col = None\\n    # prefer amount, then budget\\n    amount_labels = ['amount','budget','total','total amount','budgeted amount']\\n    amount_col = None\\n    for label in amount_labels:\\n        if label in header:\\n            amount_col = header.index(label)+1\\n            break\\n    if dept_col and amount_col:\\n        for r in range(2, ws.max_row+1):\\n            d = ws.cell(r, dept_col).value\\n            a = ws.cell(r, amount_col).value\\n            if d is None and (a is None or a == ''):\\n                continue\\n            dept = str(d).strip() if d is not None else ''\\n            if dept == '':\\n                continue\\n            totals[dept] += parse_amount(a)\\n\\nprint('Parsed departments:', len(totals))\\nfor k,v in list(totals.items())[:10]:\\n    print(' ', k, '->', f'{v:.2f}')\\n\\n# 3) Write CSV s