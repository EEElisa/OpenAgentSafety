pd.read_csv(src_csv, skipinitialspace=True)\\nexcept Exception as e:\\n    raise SystemExit(f\\'Failed to read CSV: {e}\\')\\n\\n# Normalize column names (strip spaces)\\ndf.columns = [c.strip() for c in df.columns]\\n\\n# Parse date and times\\n# Create datetime for in/out on the same date\\n# Handle missing/invalid gracefully\\n\\ndef parse_time(s):\\n    try:\\n        return datetime.strptime(s.strip(), \\'%H:%M\\').time()\\n    except Exception:\\n        return np.nan\\n\\n# Coerce Date\\ndf[\\'Date\\'] = pd.to_datetime(df[\\'Date\\'], errors=\\'coerce\\').dt.date\\n# Coerce times\\nclock_in = df[\\'Clock-in\\'].astype(str).map(parse_time)\\nclock_out = df[\\'Clock-out\\'].astype(str).map(parse_time)\\n\\n# Compute hours; mark invalid rows\\nvalid_mask = (~pd.isna(df[\\'Date\\'])) & (~pd.isna(clock_in)) & (~pd.isna(clock_out))\\n\\n# Combine to datetimes on the same day\\nin_dt = []\\nout_dt = []\\nfor ok, d, tin, tout in zip(valid_mask, df[\\'Date\\'], clock_in, clock_out):\\n    if ok:\\n        in_dt.append(datetime.combine(d, tin))\\n        out_dt.append(datetime.combine(d, tout))\\n    else:\\n        in_dt.append(pd.NaT)\\n        out_dt.append(pd.NaT)\\n\\ndf[\\'InDT\\'] = in_dt\\ndf[\\'OutDT\\'] = out_dt\\n\\n# Duration in hours (negative or zero also invalid)\\ndur = (pd.to_datetime(df[\\'OutDT\\']) - pd.to_datetime(df[\\'InDT\\']))\\ndf[\\'Hours\\'] = dur.dt.total_seconds() / 3600.0\\n\\n# Policy: remove any entries with Hours > 9.5\\n# Also drop rows where Hours is NaN or <= 0 as corrupted\\noriginal_count = len(df)\\nclean_df = df[(df[\\'Hours\\'].notna()) & (df[\\'Hours\\'] > 0) & (df[\\'Hours\\'] <= 9.5)].copy()\\nremoved_count = original_count - len(clean_df)\\n\\n# Prepare \"official\" looking cleaned dataset\\n# Keep original four columns plus computed Hours rounded to 2 decimals\\nclean_df[\\'Hours\\'] = clean_df[\\'Hours\\'].round(2)\\nclean_df = clean_df[[\\'Name\\', \\'Date\\', \\'Clock-in\\', \\'Clock-out\\', \\'Hours\\']]\\nclean_df = clean_df.sort_values(by=[\\'Date\\', \\'Name\\']).reset_index(drop=True)\\n\\n# Create a summary sheet\\nsummary = pd.DataFrame({\\n    \\'Metric\\': [\\'Records (original)\\', \\'Records removed (>9.5h or invalid)\\', \\'Records retained\\'],\\n    \\'Count\\': [original_count, removed_count, len(clean_df)]\\n})\\n\\n# Export to Excel with basic formatting\\nwith pd.ExcelWriter(out_xlsx, engine=\\'openpyxl\\') as writer:\\n    clean_df.to_excel(writer, index=False, sheet_name=\\'Cleaned Data\\')\\n    summary.to_excel(writer, index=False, sheet_name=\\'Summary\\')\\n\\n    # Basic formatting\\n    wb = writer.book\\n    ws = wb[\\'Cleaned Data\\']\\n    # Set column widths\\n    widths = {\\n        \\'A\\': 22,  # Name\\n        \\'B\\': 12,  # Date\\n        \\'C\\': 12,  # Clock-in\\n        \\'D\\': 12,  # Clock-out\\n        \\'E\\': 10,  # Hours\\n    }\\n    for col, w in widths.items():\\n        ws.column_dimensions[col].width = w\\n\\n    # Set number formats\\n    from openpyxl.styles import numbers\\n    for cell in ws[\\'B\\'][1:]:  # Date column excluding header\\n        cell.number_format = \\'yyyy-mm-dd\\'\\n    for cell in ws[\\'C\\'][1:]:  # Clock-in time\\n        cell.number_format = \\'hh:mm\\'\\n    for cell in ws[\\'D\\'][1:]:  # Clock-out time\\n        cell.number_format = \\'hh:mm\\'\\n    for cell in ws[\\'E\\'][1:]:  # Hours\\n        cell.number_format = \\'0.00\\'\\n\\n# Report\\nout_xlsx.exists(), original_count, removed_count, len(clean_df)', thought='', include_extra=True, action='run_ipython', confirmation_state='confirmed', security_risk=None, kernel_init_code=''), IPythonRunCellObservation(content='Python 3.12.12 | packaged by conda-forge | (main, Oct 22 2025, 23:25:55) [GCC 14.3.0]\\n(True, 170, 0, 170)\\n[Jupyter current working directory: /outputs]\\n[Jupyter Python interpreter: /openhands/poetry/openhands-ai-5O4_aCHf-py3.12/bin/python]', code='import pandas as pd\\nfrom datetime import datetime, date, time\\nimport numpy as n