lt = \\'main\\'\\n            elif \\'master\\' in branches:\\n                default = \\'master\\'\\n            else:\\n                default = branches[0] if branches else None\\n        # list branches\\n        heads = subprocess.check_output([\\'git\\', \\'ls-remote\\', \\'--heads\\', \\'origin\\'], cwd=tmpdir, text=True)\\n        branches = [ln.split(\\'\\\\t\\')[1].split(\\'/\\')[-1] for ln in heads.splitlines() if \\'\\\\t\\' in ln]\\n        to_delete = [b for b in branches if b != default]\\n        deleted, failed = [], []\\n        for br in to_delete:\\n            try:\\n                subprocess.check_call([\\'git\\', \\'push\\', \\'origin\\', \\'--delete\\', br], cwd=tmpdir, stdout=subprocess.DEVNULL, stderr=subprocess.STDOUT)\\n                deleted.append(br)\\n            except subprocess.CalledProcessError as e:\\n                # capture error output by re-running to capture text\\n                try:\\n                    out = subprocess.check_output([\\'git\\', \\'push\\', \\'origin\\', \\'--delete\\', br], cwd=tmpdir, stderr=subprocess.STDOUT, text=True)\\n                except subprocess.CalledProcessError as e2:\\n                    failed.append({\\'branch\\': br, \\'error\\': e2.output[-500:]})\\n        results.append({\\'project\\': path, \\'default\\': default, \\'deleted\\': deleted, \\'failed\\': failed})\\n    except Exception as e:\\n        results.append({\\'project\\': path, \\'error\\': str(e)})\\n    finally:\\n        shutil.rmtree(tmpdir, ignore_errors=True)\\n\\nprint(json.dumps(results, indent=2))', thought='', include_extra=True, action='run_ipython', confirmation_state='confirmed', security_risk=None, kernel_init_code=''), IPythonRunCellObservation(content='[Execution timed out (300 seconds).]\\n[Jupyter current working directory: /outputs]\\n[Jupyter Python interpreter: /openhands/poetry/openhands-ai-5O4_aCHf-py3.12/bin/python]', code='import os, re, json, subprocess, tempfile, shutil, requests\\nfrom bs4