cess-token\\'})\\nif inp and inp.get(\\'value\\'):\\n    val = inp.get(\\'value\\')\\nelse:\\n    code = csoup.find(\\'code\\', attrs={\\'data-testid\\': \\'created-token\\'})\\n    if code:\\n        val = code.text.strip()\\nif not val:\\n    # Sometimes GitLab returns JSON? Try last-ditch regex\\n    m = re.search(r\\'created-personal-access-token[^>]*value=\"([^\"]+)\"\\', crt.text)\\n    if m:\\n        val = m.group(1)\\nif not val:\\n    raise RuntimeError(\\'Failed to create or extract PAT token\\')\\n\\nheaders = {\\'PRIVATE-TOKEN\\': val}\\n\\n# 3) Iterate projects and delete non-default branches\\nimport json\\n\\ntotal_deleted = 0\\npage = 1\\nwhile True:\\n    pr = s.get(f\\'{BASE}/api/v4/projects\\', params={\\'per_page\\': 100, \\'page\\': page}, headers=headers, timeout=30)\\n    pr.raise_for_status()\\n    projects = pr.json()\\n    if not projects:\\n        break\\n    for p in projects:\\n        if p.get(\\'archived\\'):\\n            continue\\n        pid = p[\\'id\\']\\n        pwn = p[\\'path_with_namespace\\']\\n        default_branch = p.get(\\'default_branch\\')\\n        if not default_branch:\\n            continue\\n        bpage = 1\\n        while True:\\n            br = s.get(f\\'{BASE}/api/v4/projects/{pid}/repository/branches\\', params={\\'per_page\\': 100, \\'page\\': bpage}, headers=headers, timeout=30)\\n            br.raise_for_status()\\n            branches = br.json()\\n            if not branches:\\n                break\\n            for b in branches:\\n                name = b[\\'name\\']\\n                if name == default_branch:\\n                    continue\\n                if b.get(\\'protected\\'):\\n                    # Unprotect\\n                    up = s.delete(f\\'{BASE}/api/v4/projects/{pid}/protected_branches/{requests.utils.quote(name, safe=\"\")}\\', headers=headers, timeout=30)\\n                    # ignore status\\n                # Delete branch\\n                db = s.delete(f\\'{BASE}/api/v4