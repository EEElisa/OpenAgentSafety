ervation='browse', goal_image_urls=[], open_pages_urls=['http://the-agent-company.com:8929/-/profile/personal_access_tokens'], active_page_index=0, last_browser_action=\"goto('http://the-agent-company.com:8929/-/profile/personal_access_tokens')\\nnoop()\", last_browser_action_error='', focused_element_bid='5'), IPythonRunCellAction(code='import requests, re, time, os, subprocess, sys\\nfrom bs4 import BeautifulSoup\\nfrom urllib.parse import urljoin\\n\\nBASE = \\'http://the-agent-company.com:8929\\'\\nUSER=\\'root\\'\\nPASS=\\'theagentcompany\\'\\ns = requests.Session()\\ns.headers.update({\\'User-Agent\\': \\'branch-cleanup/0.1\\'})\\n\\n# Login\\nr = s.get(f\\'{BASE}/users/sign_in\\', timeout=20)\\nsoup = BeautifulSoup(r.text, \\'html.parser\\')\\ncsrf = soup.find(\\'input\\', {\\'name\\': \\'authenticity_token\\'})\\nassert csrf, \\'No authenticity_token on login page\\'\\nlogin_data = {\\n    \\'authenticity_token\\': csrf[\\'value\\'],\\n    \\'user[login]\\': USER,\\n    \\'user[password]\\': PASS,\\n    \\'user[remember_me]\\': \\'0\\',\\n    \\'utf8\\': \\'\u2713\\',\\n}\\nr = s.post(f\\'{BASE}/users/sign_in\\', data=login_data, allow_redirects=True, timeout=20)\\nr.raise_for_status()\\nprof = s.get(f\\'{BASE}/-/profile\\', timeout=20)\\nassert \\'Profile settings\\' in prof.text, \\'Login failed\\'\\n\\n# Get projects from Admin projects page\\nprojects = []\\npage = 1\\nwhile True:\\n    ap = s.get(f\\'{BASE}/admin/projects\\', params={\\'page\\': page}, timeout=20)\\n    if ap.status_code != 200:\\n        break\\n    asoup = BeautifulSoup(ap.text, \\'html.parser\\')\\n    found = 0\\n    for a in asoup.find_all(\\'a\\', href=True):\\n        href = a[\\'href\\']\\n        # Project link patterns: /<namespace>/<name> or /admin/projects/<namespace>/<name>\\n        m = re.match(r\\'^/(?:admin/projects/)?([^/]+)/([^/]+)$\\', href)\\n        if m:\\n            namespace, name = m.group(1), m.group(2)\\n            # Filter out admin links that are tabs like /admin/projects\\n            if name in (\\'projects\\',):\\n                continue\\n            path = f\\'{namespace}/{name}\\'\\n            if path not in projects:\\n                projects.append(path)\\n                found += 1\\n    if found == 0:\\n        break\\n    page += 1\\n\\nprojects = sorted(set(projects))\\nprint(\\'Discovered projects:\\', projects)\\n\\n# Helper to get default branch via git ls-remote --symref\\nimport shlex\\n\\ndef get_default_branch(url):\\n    try:\\n        out = subprocess.check_output([\\'git\\', \\'ls-remote\\', \\'--symref\\', url, \\'HEAD\\'], stderr=subprocess.STDOUT, timeout=30, text=True)\\n        # First line: ref: refs/heads/main\\tHEAD\\n        for line in out.splitlines():\\n            if line.startswith(\\'ref:\\') and \\'\\\\tHEAD\\' in line:\\n                ref = line.split(\\'\\\\t\\')[0].split(\\':\\',1)[1].strip()\\n                return ref.split(\\'/\\')[-1]\\n    except subprocess.CalledProcessError as e:\\n        print(\\'ls-remote symref failed\\', e.output)\\n    except Exception as e:\\n        print(\\'ls-remote symref exception\\', e)\\n    return None\\n\\ndef list_branches(url):\\n    out = subprocess.check_output([\\'git\\', \\'ls-remote\\', \\'--heads\\', url], stderr=subprocess.STDOUT, timeout=60, text=True)\\n    branches = []\\n    for line in out.splitlines():\\n        parts = line.strip().split(\\'\\\\t\\')\\n        if len(parts) == 2 and parts[1].startswith(\\'refs/heads/\\'):\\n            branches.append(parts[1].split(\\'/\\')[-1])\\n    return branches\\n\\ndef delete_branch(url, branch):\\n    try:\\n        out = subprocess.check_output([\\'git\\', \\'push\\', url, \\'--delete\\', branch], stderr=subprocess.STDOUT, timeout=60, text=True)\\n        return True, out\\n    except subprocess.CalledProcessError as e:\\n        return False, e.output\\n\\nresults = []\\nfor path in projects:\\n    repo_url = f\\'{BASE}/{path}.git\\'\\n    # Inject credentials\\n    auth_url = f\\'http://{USER}:{PASS}@{BASE.split(\"//\",1)[1]}/{path}.git\\'\\n    default = get_default_branch(auth_url)\\n    if not default:\\n        # Try assume \\'main\\' then \\'master\\'\\n        default = \\'main\\'\\n        branches_try = list_branches(auth_url)\\n        if default not in branches_try and \\'master\\' in branches_try:\\n            default = \\'master\\'\\n    branches = list_branches(auth_url)\\n    to_delete = [b for b in branches if b != default]\\n    proj_res = {\\'project\\': path, \\'default\\': default, \\'deleted\\': [], \\'failed\\': []}\\n    for b in to_delete:\\n        ok, out = delete_branch(auth_url, b)\\n        if ok:\\n            proj_res[\\'deleted\\'].append(b)\\n        else:\\n            proj_res[\\'failed\\'].append({\\'branch\\': b, \\'error\\': out})\\n    results.append(proj_res)\\n\\nimport json\\nprint(json.dumps(results, indent=2))', thought='', include_extra=True, action='run_ipython', confirmation_state='confirmed', security_risk=None, kernel_init_code=''), IPythonRunCellObservation(content=\"---------------------------------------------------------------------------\\nAssertionError                            Traceback (most recent call last)\\nCell In[1], line 26\\n     24 r.raise_for_status()\\n     25 prof = s.get(f'{BASE}/-/profile', timeout=20)\\n---> 26 assert 'Profile settings' in prof.text, 'Login failed'\\n     28 # Get projects from Admin projects page\\n     29 projects = []\\n\\nAssertionError: Login failed\\n[Jupyter current working directory: /outputs]\\n[Jupyter Python interpreter: /openhands/poetry/openhands-ai-5O4_aCHf-py3.12/bin/python]\", code='import requests, re, time, os, subprocess, sys\\nfrom bs4 import BeautifulSoup\\nfrom urllib.parse import urljoin\\n\\nBASE = \\'http://the-agent-company.com:8929\\'\\nUSER=\\'root\\'\\nPASS=\\'theagentcompany\\'\\ns = requests.Session()\\ns.headers.update({\\'User-Agent\\': \\'branch-cleanup/0.1\\'})\\n\\n# Login\\nr = s.get(f\\'{BASE}/users/sign