\\t  tags TEXT NOT NULL DEFAULT \\'\\',\\n    50\\t  content BLOB NOT NULL DEFAULT \\'\\',\\n    51\\t  is_encrypted INTEGER NOT NULL DEFAULT 0,\\n    52\\t  updated_at TEXT NOT NULL\\n    53\\t);\\n    54\\tCREATE TABLE IF NOT EXISTS settings (\\n    55\\t  key TEXT PRIMARY KEY,\\n    56\\t  value TEXT NOT NULL\\n    57\\t);\\n    58\\t\"\"\"\\n    59\\t\\n    60\\tclass Storage:\\n    61\\t    def __init__(self, path: str):\\n    62\\t        self.path = path\\n    63\\t        self.conn = sqlite3.connect(self.path)\\n    64\\t        self.conn.execute(\"PRAGMA journal_mode=WAL;\")\\n    65\\t        self.conn.execute(\"PRAGMA foreign_keys=ON;\")\\n    66\\t        self.conn.executescript(SCHEMA_SQL)\\n    67\\t        self._ensure_fts()\\n    68\\t\\n    69\\t    def _ensure_fts(self):\\n    70\\t        cur = self.conn.execute(\"SELECT name FROM sqlite_master WHERE type=\\'table\\' AND name=\\'notes_fts\\'\")\\n    71\\t        has = cur.fetchone() is not None\\n    72\\t        if not has:\\n    73\\t            # Create FTS5 virtual table and triggers\\n    74\\t            self.conn.execute(\\n    75\\t                \"CREATE VIRTUAL TABLE notes_fts USING fts5(title, tags, content, content=\\'notes\\', content_rowid=\\'id\\')\"\\n    76\\t            )\\n    77\\t            self.conn.executescript(\\n    78\\t                \"\"\"\\n    79\\t                CREATE TRIGGER notes_ai AFTER INSERT ON notes BEGIN\\n    80\\t                  INSERT INTO notes_fts(rowid, title, tags, content)\\n    81\\t                  VALUES (new.id, new.title, new.tags, CASE WHEN new.is_encrypted=0 THEN new.content ELSE \\'\\' END);\\n    82\\t                END;\\n    83\\t                CREATE TRIGGER notes_ad AFTER DELETE ON notes BEGIN\\n    84\\t                  INSERT INTO notes_fts(notes_fts, rowid) VALUES(\\'delete\\', old.id);\\n    85\\t                END;\\n    86\\t                CREATE TRIGGER notes_au AFTER UPDATE ON notes BEGIN\\n    87\\t                