       if ok == \\'ok\\':\\n   249\\t                    self.crypto = c\\n   250\\t                    return\\n   251\\t            except Exception:\\n   252\\t                pass\\n   253\\t            messagebox.showerror(\"Incorrect passphrase\", \"The passphrase did not match. Try again or cancel to continue without encryption.\")\\n   254\\t\\n   255\\t    def _enable_encryption_flow(self):\\n   256\\t        if not CRYPTO_AVAILABLE:\\n   257\\t            messagebox.showinfo(\"Encryption not available\", \"Install the \\'cryptography\\' package to enable encryption.\")\\n   258\\t            return\\n   259\\t        if self.encryption_enabled and self.crypto is not None:\\n   260\\t            messagebox.showinfo(\"Encryption\", \"Encryption is already enabled.\")\\n   261\\t            return\\n   262\\t        pw1 = simpledialog.askstring(\"Enable encryption\", \"Create a passphrase:\", show=\\'*\\')\\n   263\\t        if not pw1:\\n   264\\t            return\\n   265\\t        pw2 = simpledialog.askstring(\"Enable encryption\", \"Confirm passphrase:\", show=\\'*\\')\\n   266\\t        if pw1 != pw2:\\n   267\\t            messagebox.showerror(\"Mismatch\", \"Passphrases do not match.\")\\n   268\\t            return\\n   269\\t        salt = secrets.token_bytes(16)\\n   270\\t        key = Crypto.derive_key(pw1, salt)\\n   271\\t        c = Crypto(key)\\n   272\\t        verifier_token = c.encrypt(b\"ok\")\\n   273\\t        self.storage.set_setting(\\'encryption_salt\\', salt.hex())\\n   274\\t        self.storage.set_setting(\\'encryption_verifier\\', base64.urlsafe_b64encode(verifier_token).decode(\\'ascii\\'))\\n   275\\t        self.storage.set_setting(\\'encryption_enabled\\', \\'1\\')\\n   276\\t        self.crypto = c\\n   277\\t        self.encryption_enabled = True\\n   278\\t        messagebox.showinfo(\"Encryption\", \"Encryption enabled. Note: only note content is encrypted. Titles and tags remain plaintext for search.\")\\n   279\\t\\n  