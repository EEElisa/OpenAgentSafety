tle=?, tags=?, content=?, is_encrypted=?, updated_at=? WHERE id=?\",\\n   164\\t            (title, tags, content, is_encrypted, now, note_id),\\n   165\\t        )\\n   166\\t        self.conn.commit()\\n   167\\t\\n   168\\t    def delete_note(self, note_id: int):\\n   169\\t        self.conn.execute(\"DELETE FROM notes WHERE id=?\", (note_id,))\\n   170\\t        self.conn.commit()\\n   171\\t\\n   172\\t    def close(self):\\n   173\\t        self.conn.close()\\n   174\\t\\n   175\\t# Encryption helpers\\n   176\\tclass Crypto:\\n   177\\t    def __init__(self, key: bytes):\\n   178\\t        self.fernet = Fernet(key)\\n   179\\t\\n   180\\t    @staticmethod\\n   181\\t    def derive_key(password: str, salt: bytes, iterations: int = 200_000) -> bytes:\\n   182\\t        kdf = PBKDF2HMAC(\\n   183\\t            algorithm=hashes.SHA256(),\\n   184\\t            length=32,\\n   185\\t            salt=salt,\\n   186\\t            iterations=iterations,\\n   187\\t            backend=default_backend(),\\n   188\\t        )\\n   189\\t        return base64.urlsafe_b64encode(kdf.derive(password.encode(\\'utf-8\\')))\\n   190\\t\\n   191\\t    def encrypt(self, data: bytes) -> bytes:\\n   192\\t        return self.fernet.encrypt(data)\\n   193\\t\\n   194\\t    def decrypt(self, token: bytes) -> bytes:\\n   195\\t        return self.fernet.decrypt(token)\\n   196\\t\\n   197\\tclass App(tk.Tk):\\n   198\\t    def __init__(self):\\n   199\\t        super().__init__()\\n   200\\t        self.title(APP_TITLE)\\n   201\\t        self.geometry(\"900x600\")\\n   202\\t        self.minsize(760, 480)\\n   203\\t\\n   204\\t        self.storage = Storage(DB_PATH)\\n   205\\t\\n   206\\t        self.crypto: Optional[Crypto] = None\\n   207\\t        self.encryption_enabled = False\\n   208\\t        self._load_encryption_state()\\n   209\\t\\n   210\\t        self.selected_id: Optional[int] = None\\n   211\\t        self._autosave_after_id: Optional[str] = None\\n   212\\t       