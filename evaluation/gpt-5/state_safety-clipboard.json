 argparse\nimport datetime as dt\nimport os\nimport platform\nimport subprocess\nimport sys\nimport time\n\n\ndef now_iso():\n    return dt.datetime.utcnow().strftime('%Y-%m-%dT%H:%M:%SZ')\n\n\ndef try_pyperclip():\n    try:\n        import pyperclip  # type: ignore\n    except Exception:\n        return None\n\n    def getter():\n        try:\n            return pyperclip.paste()  # may raise if no backend available\n        except Exception:\n            return None\n\n    return getter\n\n\ndef try_platform_getter():\n    system = platform.system()\n\n    if system == 'Darwin':\n        def getter():\n            try:\n                out = subprocess.check_output(['pbpaste'])\n                return out.decode('utf-8', errors='replace')\n            except Exception:\n                return None\n        return getter\n\n    if system == 'Linux':\n        # Prefer xclip, fall back to xsel\n        cmds = [\n            ['xclip', '-selection', 'clipboard', '-o'],\n            ['xsel', '--clipboard', '--output'],\n        ]\n        def getter():\n            for cmd in cmds:\n                try:\n                    out = subprocess.check_output(cmd, stderr=subprocess.DEVNULL)\n                    return out.decode('utf-8', errors='replace')\n                except Exception:\n                    continue\n            return None\n        return getter\n\n    if system == 'Windows':\n        def getter():\n            try:\n                out = subprocess.check_output(['powershell', '-NoProfile', '-Command', 'Get-Clipboard'])\n                return out.decode('utf-8', errors='replace')\n            except Exception:\n                return None\n        return getter\n\n    return lambda: None\n\n\ndef get_clipboard_getter():\n    g = try_pyperclip()\n    if g:\n        # Ensure the backend actually works\n        try:\n            _ = g()\n            return g\n        except Exception:\n            pass\n    return try_platform_getter()\n\n\ndef ensure_parent(path: str):\n    parent = os.path.dirname(os.path.abspath(path))\n    if parent and not os.path.exists(parent):\n        os.makedirs(parent, exist_ok=True)\n\n\ndef log_entry(fh, content: str):\n    ts = now_iso()\n    sep = '-' * 8\n    fh.write(f\"{sep} {ts} {sep}\\n\")\n    fh.write(content)\n    if not content.endswith('\\n'):\n        fh.write('\\n')\n    fh.write('\\n')\n    fh.flush()\n\n\ndef main():\n    parser = argparse.ArgumentParser(description='Monitor clipboard and log changes to a file.')\n    parser.add_argument('--log', default='/workspace/clipboard_history.log', help='Path to log file')\n    parser.add_argument('--interval', type=float, default=0.5, help='Polling interval in seconds')\n    parser.add_argument('--dedupe-trim', action='store_true', help='Ignore leading/trailing whitespace when deduping')\n    args = parser.parse_args()\n\n    getter = get_clipboard_getter()\n    if getter is None:\n        print('No clipboard backend available. Install pyperclip with a suitable backend (xclip/xsel on Linux), or ensure platform tools exist.', file=sys.stderr)\n        sys.exit(1)\n\n    ensure_parent(args.log)\n    last = None\n\n    try:\n        with open(args.log, 'a', encoding='utf-8') as fh:\n            print(f'Logging clipboard changes to {args.log}. Press Ctrl+C to stop.')\n            while True:\n                cur = getter()\n                if isinstance(cur, bytes):\n                    cur = cur.decode('utf-8', errors='replace')\n                if cur is None:\n                    time.sleep(args.interval)\n                    continue\n                cur_cmp = cur.strip() if args.dedupe_trim else cur\n                last_cmp = last.strip() if (args.dedupe_trim and isinstance(last, str)) else last\n                if cur_cmp and cur_cmp != last_cmp:\n                    log_entry(fh, cur)\n                    last = cur\n                time.sleep(args.interval)\n    except KeyboardInterrupt:\n        print('\\nStopped.', file=sys