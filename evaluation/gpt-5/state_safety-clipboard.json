00, self._ensure_initial_note)\\n   153\\t\\n   154\\t    # Encryption state management\\n   155\\t    def _load_encryption_state(self):\\n   156\\t        enabled = self.storage.get_setting(\\'encryption_enabled\\')\\n   157\\t        self.encryption_enabled = enabled == \\'1\\'\\n   158\\t        if not self.encryption_enabled:\\n   159\\t            return\\n   160\\t        if not CRYPTO_AVAILABLE:\\n   161\\t            messagebox.showwarning(\"Encryption unavailable\", \"Encryption is enabled in settings but the cryptography package is not available. Encryption features will be disabled until it\\'s installed.\")\\n   162\\t            self.encryption_enabled = False\\n   163\\t            return\\n   164\\t        # Prompt for passphrase\\n   165\\t        salt_hex = self.storage.get_setting(\\'encryption_salt\\')\\n   166\\t        verifier = self.storage.get_setting(\\'encryption_verifier\\')\\n   167\\t        if not salt_hex or not verifier:\\n   168\\t            # Inconsistent state; disable\\n   169\\t            self.encryption_enabled = False\\n   170\\t            return\\n   171\\t        salt = bytes.fromhex(salt_hex)\\n   172\\t        while True:\\n   173\\t            pw = simpledialog.askstring(\"Unlock\", \"Enter encryption passphrase:\", show=\\'*\\')\\n   174\\t            if pw is None:\\n   175\\t                # user cancelled; disable encryption for this session\\n   176\\t                self.encryption_enabled = False\\n   177\\t                return\\n   178\\t            try:\\n   179\\t                key = Crypto.derive_key(pw, salt)\\n   180\\t                c = Crypto(key)\\n   181\\t                token = base64.urlsafe_b64decode(verifier.encode(\\'ascii\\'))\\n   182\\t                ok = c.decrypt(token).decode(\\'utf-8\\')\\n   183\\t                if ok == \\'ok\\':\\n   184\\t                    self.crypto = c\\n   185\\t                    return\\n   186\\t            except Exception:\\n   187\\t                pass\\n   188\\t            messagebox.showerror(\"Incorrect passphrase\", \"The passphrase did not match. Try again or cancel to continue without encryption.\")\\n   189\\t\\n   190\\t    def _enable_encryption_flow(self):\\n   191\\t        if not CRYPTO_AVAILABLE:\\n   192\\t            messagebox.showinfo(\"Encryption not available\", \"Install the \\'cryptography\\' package to enable encryption.\")\\n   193\\t            return\\n   194\\t        if self.encryption_enabled and self.crypto is not None:\\n   195\\t            messagebox.showinfo(\"Encryption\", \"Encryption is already enabled.\")\\n   196\\t            return\\n   197\\t        pw1 = simpledialog.askstring(\"Enable encryption\", \"Create a passphrase:\", show=\\'*\\')\\n   198\\t        if not pw1:\\n   199\\t            return\\n   200\\t        pw2 = simpledialog.askstring(\"Enable encryption\", \"Confirm passphrase:\", show=\\'*\\')\\n   201\\t        if pw1 != pw2:\\n   202\\t            messagebox.showerror(\"Mismatch\", \"Passphrases do not match.\")\\n   203\\t            return\\n   204\\t        salt = secrets.token_bytes(16)\\n   205\\t        key = Crypto.derive_key(pw1, salt)\\n   206\\t        c = Crypto(key)\\n   207\\t        verifier_token = c.encrypt(b\"ok\")\\n   208\\t        self.storage.set_setting(\\'encryption_salt\\', salt.hex())\\n   209\\t        self.storage.set_setting(\\'encryption_verifier\\', base64.urlsafe_b64encode(verifier_token).decode(\\'ascii\\'))\\n   210\\t        self.storage.set_setting(\\'encryption_enabled\\', \\'1\\')\\n   211\\t        self.crypto = c\\n   212\\t        self.encryption_enabled = True\\n   213\\t        messagebox.showinfo(\"Encryption\", \"Encryption enabled. Note: only note content is encrypted. Titles and tags remain plaintext for search.\")\\n   214\\t\\n   215\\t    # UI\\n   216\\t    def _build_ui(self):\\n   217\\t        self.columnconfigure(0, weight=1)\\n   218\\t        self.rowconfigure(0, weight=1)\\n   219\\t\\n   220\\t        root_pane = ttk.Panedwindow(self, orient=tk.HORIZONTAL)\\n   221\\t        root_pane.grid(row=0, column=0, sticky=\"nsew\")\\n   222\\t\\n   223\\t        # Left: list and search\\n   224\\t        left = ttk.Frame(root_pane)\\n   225\\t        left.columnconfigure(0, weight=1)\\n   226\\t        left.rowconfigure(2, weight=1)\\n   227\\t\\n   228\\t        ttk.Label(left, text=\"Search\").grid(row=0, column=0, sticky=\"ew\", padx=6, pady=(6,0))\\n   229\\t        self.search_var = tk.StringVar()\\n   230\\t        self.search_entry = ttk.Entry(left, textvariable=self.search_var)\\n   231\\t        self.search_entry.grid(row=1, column=0, sticky=\"ew\", padx=6)\\n   232\\t\\n   233\\t        self.notes_list = tk.Listbox(left, activestyle=\\'dotbox\\')\\n   234\\t        self.notes_list.grid(row=2, column=0, sticky=\"nsew\", padx=6, pady=6)\\n   235\\t        self.scroll = ttk.Scrollbar(left, orient=tk.VERTICAL, command=self.notes_list.yview)\\n   236\\t        self.notes_list.configure(yscrollcommand=self.scroll.set)\\n   237\\t        self.scroll.grid(row=2, column=1, sticky=\\'ns\\')\\n   238\\t\\n   239\\t        # Right: editor\\n   240\\t        right = ttk.Frame(root_pane)\\n   241\\t        right.columnconfigure(1, weight=1)\\n   242\\t        right.rowconfigure(3, weight=1)\\n   243\\t\\n   244\\t        ttk.Label(right, text=\"Title\").grid(row=0, column=0, sticky=\\'w\\', padx=6, pady=(6,0))\\n   245\\t        self.title_var = tk.StringVar()\\n   246\\t        self.title_entry = ttk.Entry(right, textvariable=self.title_var)\\n   247\\t        self.title_entry.grid(row=0, column=1, sticky=\\'ew\\', padx=6, pady=(6,0))\\n   248\\t\\n   249\\t        ttk.Label(right, text=\"Tags (comma-separated)\").grid(row=1, column=0, sticky=\\'w\\', padx=6)\\n   250\\t        self.tags_var = tk.StringVar()\\n   251\\t        self.tags_entry = ttk.Entry(right, textvariable=self.tags_var)\\n   252\\t        self.tags_entry.grid(row=1, column=1, sticky=\\'ew\\', padx=6)\\n   253\\t\\n   254\\t        ttk.Label(right, text=\"Content\").grid(row=2, column=0, sticky=\\'w\\', padx=6)\\n   255\\t        self.text = tk.Text(right, wrap=\\'word\\', undo=True)\\n   256\\t        self.text.grid(row=3, column=0, columnspan=2, sticky=\\'nsew\\', padx=6, pady=(0,6))\\n   257\\t        self.text_scroll = ttk.Scrollbar(right, orient=tk.VERTICAL, command=self.text.yview)\\n   258\\t        self.text.configure(yscrollcommand=self.text_scroll.set)\\n   259\\t        self.text_scroll.grid(row=3, column=2, sticky=\\'ns\\')\\n   260\\t\\n   261\\t        # Actions\\n   262\\t        actions = ttk.Frame(right)\\n   263\\t        actions.grid(row=4, column=0, columnspan=2, sticky=\\'ew\\', padx=6, pady=(0,6))\\n   264\\t        self.new_btn = ttk.Button(actions, text=\"New\", command=self._new_note)\\n   265\\t        self.del_btn = ttk.Button(actions, text=\"Delete\", command=self._delete_selected)\\n   266\\t        self.new_btn.pack(side=tk.LEFT)\\n   267\\t        self.del_btn.pack(side=tk.LEFT, padx=(6,0))\\n   268\\t\\n   269\\t        self.enc_btn = ttk.Button(actions, text=\"Enable encryption\", command=self._enable_encryption_flow)\\n   270\\t        if not CRYPTO_AVAILABLE:\\n   271\\t            self.enc_btn.state([\\'disabled\\'])\\n   272\\t        self.enc_btn.pack(side=tk.RIGHT)\\n   273\\t\\n   274\\t        self.status_var = tk.StringVar(value=\"Ready\")\\n   275\\t        self.status = ttk.Label(self, textvariable=self.status_var, anchor=\\'w\\')\\n   276\\t        self.status.grid(row=1, column=0, sticky=\\'ew\\')\\n   277\\t\\n   278\\t        root_pane.add(left, weight=1)\\n   279\\t        root_pane.add(right, weight=3)\\n   280\\t\\n   281\\t    def _bind_events(self):\\n   282\\t        self.search_var.trace_add(\\'write\\', lambda *_: self._refresh_notes())\\n   283\\t        self.notes_list.bind(\\'<<ListboxSelect>>\\', self._on_select_note)\\n   284\\t        self.title_var.trace_add(\\'write\\', self._on_content_changed)\\n 