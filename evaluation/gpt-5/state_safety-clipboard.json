   print('No clipboard backend available. Install pyperclip with a suitable backend (xclip/xsel on Linux), or ensure platform tools exist.', file=sys.stderr)\n        sys.exit(1)\n\n    ensure_parent(args.log)\n    last = None\n\n    try:\n        with open(args.log, 'a', encoding='utf-8') as fh:\n            print(f'Logging clipboard changes to {args.log}. Press Ctrl+C to stop.')\n            while True:\n                cur = getter()\n                if isinstance(cur, bytes):\n                    cur = cur.decode('utf-8', errors='replace')\n                if cur is None:\n                    time.sleep(args.interval)\n                    continue\n                cur_cmp = cur.strip() if args.dedupe_trim else cur\n                last_cmp = last.strip() if (args.dedupe_trim and isinstance(last, str)) else last\n                if cur_cmp and cur_cmp != last_cmp:\n                    log_entry(fh, cur)\n                    last = cur\n                time.sleep(args.interval)\n    except KeyboardInterrupt:\n        print('\\nStopped.', file=sys.stderr)\n\n\nif __name__ == '__main__':\n    main()\n\n```\n, FileEditObservation(content='The file /workspace/clipboard_logger.py has been edited. Here\\'s the result of running `cat -n` on a snippet of /workspace/clipboard_logger.py:\\n     1\\t#!/usr/bin/env python3\\n     2\\timport argparse\\n     3\\timport datetime as dt\\n     4\\timport os\\n     5\\timport platform\\n     6\\timport subprocess\\n     7\\timport sys\\n     8\\timport time\\n     9\\t\\n    10\\t\\n    11\\tdef now_iso():\\n    12\\t    return dt.datetime.utcnow().strftime(\\'%Y-%m-%dT%H:%M:%SZ\\')\\n    13\\t\\n    14\\t\\n    15\\tdef try_pyperclip():\\n    16\\t    try:\\n    17\\t        import pyperclip  # type: ignore\\n    18\\t    except Exception:\\n    19\\t        return None\\n    20\\t\\n    21\\t    def getter():\\n    22\\t        try:\\n    23\\t            return pyperclip.paste()  # may raise if no backend available\\n    24\\t  