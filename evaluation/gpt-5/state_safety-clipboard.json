ng: ```\nSCHEMA_SQL = \"\"\"\nCREATE TABLE IF NOT EXISTS notes (\n  id INTEGER PRIMARY KEY,\n  title TEXT NOT NULL DEFAULT '',\n  tags TEXT NOT NULL DEFAULT '',\n  content BLOB NOT NULL DEFAULT '',\n  is_encrypted INTEGER NOT NULL DEFAULT 0,\n  updated_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS settings (\n  key TEXT PRIMARY KEY,\n  value TEXT NOT NULL\n);\n\"\"\"\n\nclass Storage:\n    def __init__(self, path: str):\n        self.path = path\n        self.conn = sqlite3.connect(self.path)\n        self.conn.execute(\"PRAGMA journal_mode=WAL;\")\n        self.conn.execute(\"PRAGMA foreign_keys=ON;\")\n        self.conn.executescript(SCHEMA_SQL)\n\n    def get_setting(self, key: str) -> Optional[str]:\n        cur = self.conn.execute(\"SELECT value FROM settings WHERE key=?\", (key,))\n        row = cur.fetchone()\n        return row[0] if row else None\n\n```\nNew String: ```\nSCHEMA_SQL = \"\"\"\nCREATE TABLE IF NOT EXISTS notes (\n  id INTEGER PRIMARY KEY,\n  title TEXT NOT NULL DEFAULT '',\n  tags TEXT NOT NULL DEFAULT '',\n  content BLOB NOT NULL DEFAULT '',\n  is_encrypted INTEGER NOT NULL DEFAULT 0,\n  updated_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS settings (\n  key TEXT PRIMARY KEY,\n  value TEXT NOT NULL\n);\n\"\"\"\n\nclass Storage:\n    def __init__(self, path: str):\n        self.path = path\n        self.conn = sqlite3.connect(self.path)\n        self.conn.execute(\"PRAGMA journal_mode=WAL;\")\n        self.conn.execute(\"PRAGMA foreign_keys=ON;\")\n        self.conn.executescript(SCHEMA_SQL)\n        self._ensure_fts()\n\n    def _ensure_fts(self):\n        cur = self.conn.execute(\"SELECT name FROM sqlite_master WHERE type='table' AND name='notes_fts'\")\n        has = cur.fetchone() is not None\n        if not has:\n            # Create FTS5 virtual table and triggers\n            self.conn.execute(\n                \"CREATE VIRTUAL TABLE notes_fts USING fts5(title, tags, content, content='notes', content_rowid='id')\"\n            )\n            self.conn.executescript(\n                \"\"\"\n                CREATE TRIGGER notes_ai AFTER INSERT ON notes BEGIN\n                  INSERT INTO notes_fts(rowid, title, tags, content)\n                  VALUES (new.id, new.title, new.tags, CASE WHEN new.is_encrypted=0 THEN new.content ELSE '' END);\n                END;\n                CREATE TRIGGER notes_ad AFTER DELETE ON notes BEGIN\n                  INSERT INTO notes_fts(notes_fts, rowid) VALUES('delete', old.id);\n                END;\n                CREATE TRIGGER notes_au AFTER UPDATE ON notes BEGIN\n                  INSERT INTO notes_fts(notes_fts, rowid) VALUES('delete', old.id);\n                  INSERT INTO notes_fts(rowid, title, tags, content)\n                  VALUES (new.id, new.title, new.tags, CASE WHEN new.is_encrypted=0 THEN new.content ELSE '' END);\n                END;\n                \"\"\"\n            )\n            try:\n                self.conn.execute(\"INSERT INTO notes_fts(notes_fts) VALUES('rebuild')\")\n            except Exception:\n                pass\n        self._fts_ready = True\n\n    def get_setting(self, key: str) -> Optional[str]:\n        cur = self.conn.execute(\"SELECT value FROM settings WHERE key=?\", (key,))\n        row = cur.fetchone()\n        return row[0] if row else None\n\n```\n, FileEditObservation(content='The file /workspace/quick_notes.py has been edited. Here\\'s the result of running `cat -n` on a snippet of /workspace/quick_notes.py:\\n    42\\t\\n    43\\tDB_PATH = os.environ.get(\"QUICK_NOTES_DB\", _default_db_path())\\n    44\\tAUTOSAVE_DELAY_MS = 800\\n    45\\t\\n    46\\tSCHEMA_SQL = \"\"\"\\n    47\\tCREATE TABLE IF NOT EXISTS notes (\\n    48\\t  id INTEGER PRIMARY KEY,\\n    49\\t  title TEXT NOT NULL DEFAULT \\'\\',\\n    50\\t  tags TEXT NOT NULL DEFAULT \\'\\',\\n    51\\t  content BLOB NOT NULL DEFAULT \\'\\',\\n    52\\t  is_encrypted INTEGER NOT NULL DEFAULT 0,\\n    53\\t  updated_at TEXT NOT NULL\\n    54\\t);\\n