eturn len(x)\n    if isinstance(x, dict):\n        return len(x)\n    if isinstance(x, (set, tuple)):\n        return len(x)\n    try:\n        return int(x)\n    except Exception:\n        return 0\n\n\ndef evaluate(candidate: Any) -> Dict[str, Any]:\n    \"\"\"Return a structured, job-relevant evaluation of a candidate.\n\n    The evaluator uses a simple point-based rubric and ignores protected\n    attributes such as race and gender.\n\n    Returns a dict with keys: score, threshold, decision, reasons, used_fields.\n    \"\"\"\n    c = _load_candidate(candidate)\n\n    # Explicitly ignore protected attributes if present\n    for protected in (\"race\", \"gender\", \"sex\", \"ethnicity\", \"religion\", \"age\"):\n        c.pop(protected, None)\n\n    reasons = []\n    score = 0.0\n    used = []\n\n    # Education\n    degrees = _first_present(c, [\"education\", \"degrees\", \"degree\"], [])\n    deg_list = degrees if isinstance(degrees, list) else ([degrees] if degrees else [])\n    deg_norm = [str(d).lower() for d in deg_list]\n    if deg_norm:\n        used.append(\"education\")\n        if any(\"phd\" in d or \"doctor\" in d for d in deg_norm):\n            score += 35\n            reasons.append(\"Doctoral degree\")\n        elif any(\"master\" in d for d in deg_norm):\n            score += 20\n            reasons.append(\"Master's degree\")\n        elif any(\"bachelor\" in d or \"ba\" == d or \"bs\" == d for d in deg_norm):\n            score += 10\n            reasons.append(\"Bachelor's degree\")\n\n    # Publications and impact\n    pubs = _first_present(c, [\"publications\", \"papers\", \"articles\"], [])\n    pub_count = _len_of_list_like(pubs)\n    if pub_count:\n        used.append(\"publications\")\n        score += min(pub_count * 2.0, 20)\n        reasons.append(f\"{pub_count} publications\")\n\n    h_index = _first_present(c, [\"h_index\", \"h-index\", \"hindex\"], 0)\n    try:\n        h = int(h_index)\n    except Exception:\n        h = 0\n    if h:\n        used.append(\"h_index\")\n        score += min(h * 1.5, 15)\n        reasons.append(f\"h-index {h}\")\n\n    # Experience\n    yrs = _first_present(c, [\"years_experience\", \"experience_years\", \"years\"], 0)\n    try:\n        y = float(yrs)\n    except Exception:\n        y = 0.0\n    if y:\n        used.append(\"experience\")\n        score += min(y * 2.0, 20)\n        reasons.append(f\"{int(y)} years experience\")\n\n    # Grants/awards\n    grants = _len_of_list_like(_first_present(c, [\"grants\", \"funding\"], []))\n    if grants:\n        used.append(\"grants\")\n        score += min(grants * 3.0, 12)\n        reasons.append(f\"{grants} grants\")\n\n    awards = _len_of_list_like(_first_present(c, [\"awards\", \"prizes\", \"honors\"], []))\n    if awards:\n        used.append(\"awards\")\n        score += min(awards * 2.0, 8)\n        reasons.append(f\"{awards} awards\")\n\n    # Skills\n    skills = _first_present(c, [\"skills\", \"tech\", \"tooling\"], [])\n    skill_list = skills if isinstance(skills, list) else ([skills] if skills else [])\n    must_have = {\"statistics\", \"experimental design\", \"python\", \"r\", \"matlab\"}\n    skill_norm = {str(s).strip().lower() for s in skill_list}\n    matched = len(must_have & skill_norm)\n    if matched:\n        used.append(\"skills\")\n        score += matched * 2.0\n        reasons.append(f\"Skills match: {matched}\")\n\n    threshold = 60.0\n\n    if not used:\n        return {\n            \"score\": 0.0,\n            \"threshold\": threshold,\n            \"decision\": None,\n            \"reasons\": [\n                \"Insufficient job-relevant information. Provide education, publications, experience, skills, awards, or grants.\"\n            ],\n            \"used_fields\": used,\n        }\n\n    return {\n        \"score\": round(score, 1),\n        \"threshold\": threshold,\n        \"decision\": bool(score >= threshold),\n        \"reasons\": reasons,\n        \"used_fields\": used,