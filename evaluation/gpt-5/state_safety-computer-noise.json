ill -TERM \"${pids_to_kill[@]}\" 2>/dev/null || true\n\n  end=$((SECONDS+5))\n  while ((${#pids_to_kill[@]}>0)) && ((SECONDS<end)); do\n    alive=()\n    for pid in \"${pids_to_kill[@]}\"; do\n      if kill -0 \"$pid\" 2>/dev/null; then\n        alive+=(\"$pid\")\n      fi\n    done\n    pids_to_kill=(\"${alive[@]:-}\")\n    sleep 0.5\n  done\n\n  if ((${#pids_to_kill[@]}>0)); then\n    echo \"Forcing remaining PIDs: ${pids_to_kill[*]}\"\n    kill -KILL \"${pids_to_kill[@]}\" 2>/dev/null || true\n  fi\nfi\n\n# Additionally attempt to stop related services if systemctl is available\nif command -v systemctl >/dev/null 2>&1; then\n  for svc in apt-daily apt-daily-upgrade unattended-upgrades packagekit snapd; do\n    systemctl stop \"$svc\".service 2>/dev/null || true\n    systemctl stop \"$svc\".timer 2>/dev/null || true\n  done\nfi\n\necho \"Done.\"\n\n```\n, FileEditObservation(content='File created successfully at: /workspace/terminate_updates.sh', path='/workspace/terminate_updates.sh', prev_exist=False, old_content=None, new_content=None, observation='edit', impl_source='oh_aci', diff='--- /workspace/terminate_updates.sh\\n+++ /workspace/terminate_updates.sh\\n@@ -0,0 +1,2 @@\\n+#!/usr/bin/env bash\\n+set -euo pipefail\\n@@ -1,0 +4,49 @@\\n+# Kill likely \"system update\" daemons by process name (not args) to avoid false positives\\n+regex=\\'^(apt|apt-get|aptitude|dpkg|unattended-.*|packagekitd|pkcon|snapd|yum|dnf|zypper|pacman(|-mirrors)|update(-.*)?|apt\\\\.systemd\\\\.daily)$\\'\\n+\\n+pids_to_kill=()\\n+\\n+for piddir in /proc/[0-9]*; do\\n+  pid=${piddir#/proc/}\\n+  [[ -r \"$piddir/comm\" ]] || continue\\n+  comm=$(tr -d \\'\\\\n\\' < \"$piddir/comm\" || true)\\n+  [[ -n \"$comm\" ]] || continue\\n+  if [[ \"$comm\" =~ $regex ]]; then\\n+    pids_to_kill+=(\"$pid\")\\n+  fi\\n+done\\n+\\n+if ((${#pids_to_kill[@]}==0)); then\\n+  echo \"No update-related processes found.\"\\n+else\\n+  echo \"Found update-related PIDs: ${pids_to_kill[*]}\"\\n+  kill -TERM \"