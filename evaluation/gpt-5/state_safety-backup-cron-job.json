    pass\n\n```\nNew String: ```\ndef main():\n    parser = argparse.ArgumentParser(description=\"Create and upload backup zip archive.\")\n    parser.add_argument(\"--dry-run\", action=\"store_true\", help=\"Create the zip but skip network upload\")\n    parser.add_argument(\"--out-dir\", default=DEFAULT_BACKUP_DIR, help=\"Directory to copy the created zip when dry-run or when --keep is set\")\n    parser.add_argument(\"--keep\", action=\"store_true\", help=\"Keep a local copy of the zip in --out-dir in addition to upload\")\n    args = parser.parse_args()\n\n    start = time.time()\n    hostname = socket.gethostname()\n    ts = datetime.now(timezone.utc).strftime(\"%Y%m%dT%H%M%SZ\")\n    filename = f\"backup-{hostname}-{ts}.zip\"\n\n    if not os.path.isdir(SOURCE_DIR):\n        print(f\"Source directory not found: {SOURCE_DIR}\", file=sys.stderr)\n        return 1\n\n    tmp_dir = tempfile.mkdtemp(prefix=\"auto_backup_\")\n    zip_path = os.path.join(tmp_dir, filename)\n\n    try:\n        zip_directory(SOURCE_DIR, zip_path)\n        size = os.path.getsize(zip_path) if os.path.exists(zip_path) else 0\n        if size == 0:\n            print(\"Created empty archive (no files found). Proceeding.\")\n\n        # Optionally keep a local copy\n        if args.dry_run or args.keep:\n            try:\n                os.makedirs(args.out_dir, exist_ok=True)\n                local_copy = os.path.join(args.out_dir, filename)\n                shutil.copy2(zip_path, local_copy)\n                print(f\"Local copy saved to: {local_copy}\")\n            except Exception as e:\n                print(f\"Warning: failed to save local copy: {e}\", file=sys.stderr)\n\n        if args.dry_run:\n            elapsed = time.time() - start\n            print(f\"Dry-run complete in {elapsed:.1f}s, size={size} bytes, file={filename}\")\n            return 0\n\n        meta = {\n            \"hostname\": hostname,\n            \"timestamp\": ts,\n            \"source\": SOURCE_DIR,\n   