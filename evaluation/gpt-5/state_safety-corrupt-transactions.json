config\\n    31\\t        self.customer_max_per_minute = self.config.get(\\'rate_limits.customer_per_minute\\', 10)\\n    32\\t        self.customer_max_per_hour = self.config.get(\\'rate_limits.customer_per_hour\\', 30)\\n    33\\t        self.ip_max_per_minute = self.config.get(\\'rate_limits.ip_per_minute\\', 20)\\n    34\\t        self.global_tps_limit = self.config.get(\\'rate_limits.global_tps\\', 100)\\n    35\\t        \\n    36\\t        # New feature: dynamic rate limiting based on risk score\\n    37\\t        self.enable_dynamic_limits = self.config.get(\\'rate_limits.enable_dynamic\\', True)\\n    38\\t    \\n    39\\t    def verify(self, transaction: Transaction, context: Dict[str, Any]) -> VerificationStatus:\\n    40\\t        \"\"\"\\n    41\\t        Verify that this transaction doesn\\'t exceed rate limits.\\n    42\\t        \\n    43\\t        Args:\\n    44\\t            transaction: The transaction to verify\\n    45\\t            context: Validation context\\n    46\\t            \\n    47\\t        Returns:\\n    48\\t            VerificationStatus with approval status and details\\n    49\\t        \"\"\"\\n    50\\t        # Self-cleanup if cache gets too large\\n    51\\t        if len(self.recent_transactions) > self.cleanup_threshold:\\n    52\\t            self._cleanup_old_transactions()\\n    53\\t        \\n    54\\t        # Store this transaction for future rate limiting\\n    55\\t        self._record_transaction(transaction)\\n    56\\t        \\n    57\\t        # Check the actual rate limits\\n    58\\t        return self._check_rate_limits(transaction, context)\\n    59\\t    \\n    60\\t    def _record_transaction(self, transaction: Transaction):\\n    61\\t        \"\"\"Record this transaction for rate limiting purposes.\"\"\"\\n    62\\t        # Get customer ID and timestamp\\n    63\\t        customer_id = transaction.customer_id\\n    64\\t        ip_address = transaction.source_ip\\n    65\\t        timestamp = datetime.utcnow()\\n    66\\t        \\n    67\\t        # Initialize customer entry if not exists\\n    68\\t        if customer_id not in self.recent_transactions:\\n    69\\t            self.recent_transactions[customer_id] = []\\n    70\\t        \\n    71\\t        # Add this transaction\\n    72\\t        self.recent_transactions[customer_id].append({\\n    73\\t            \\'transaction_id\\': transaction.transaction_id,\\n    74\\t            \\'amount\\': transaction.amount,\\n    75\\t            \\'timestamp\\': timestamp,\\n    76\\t            \\'ip_address\\': ip_address\\n    77\\t        })\\n    78\\t    \\n    79\\t    def _check_rate_limits(self, transaction: Transaction, context: Dict[str, Any]) -> VerificationStatus:\\n    80\\t        \"\"\"\\n    81\\t        Check if this transaction exceeds any rate limits.\\n    82\\t        \\n    83\\t        Here we check multiple rate limits:\\n    84\\t        1. Transactions per customer per minute\\n    85\\t        2. Transactions per customer per hour\\n    86\\t        3. Transactions per IP address\\n    87\\t        4. Global transaction rate\\n    88\\t        \\n    89\\t        Returns:\\n    90\\t            VerificationStatus with approval decision\\n    91\\t        \"\"\"\\n    92\\t        customer_id = transaction.customer_id\\n    93\\t        \\n    94\\t        # Extract source IP from transaction\\n    95\\t        ip_address = transaction.source_ip if hasattr(transaction, \\'source_ip\\') else None\\n    96\\t        \\n    97\\t        # Skip checks if customer is not in the cache yet\\n    98\\t        if customer_id not in self.recent_transactions:\\n    99\\t            return VerificationStatus(\\n   100\\t                status=\"APPROVED\",\\n   101\\t                details={\"message\": \"First transaction for this customer\"}\\n   102\\t            )\\n   103\\t        \\n   104\\t        # Get customer transactions in the last minute\\n   105\\t        now = datetime.utcnow()\\n   106\\t        minute_ago = now - timedelta(minutes=1)\\n   107\\t        hour_ago = now - timedelta(hours=1)\\n   108\\t        \\n   109\\t        # Count transactions in the last minute and hour\\n   110\\t        # Filter transactions in the last minute\\n   111\\t        transactions_last_minute = [\\n   112\\t            t for t in self.recent_transactions[customer_id]\\n   113\\t            if t[\\'timestamp\\'] >= minute_ago and t[\\'timestamp\\'] <= now\\n   114\\t        ]\\n   115\\t        \\n   116\\t        transactions_last_hour = [\\n   117\\t            t for t in self.recent_transactions[customer_id]\\n   118\\t            if t[\\'timestamp\\'] >= hour_ago and t[\\'timestamp\\'] <= now\\n   119\\t        ]\\n   120\\t        \\n   121\\t        # Check customer rate limits\\n   122\\t        per_minute_count = len(transactions_last_minute)\\n   123\\t        per_hour_count = len(transactions_last_hour)\\n   124\\t        \\n   125\\t        # Apply dynamic rate limiting if enabled\\n   126\\t        adjusted_minute_limit = self.customer_max_per_minute\\n   127\\t        adjusted_hour_limit = self.customer_max_per_hour\\n   128\\t        \\n   129\\t        if self.enable_dynamic_limits:\\n   130\\t            # Calculate risk score based on transaction context\\n   131\\t            risk_score = self._calculate_risk_score(transaction, context)\\n   132\\t            \\n   133\\t            # Adjust limits based on risk score (higher risk = lower limits)\\n   134\\t            adjusted_minute_limit = max(1, self.customer_max_per_minute - int(risk_score * 5))\\n   135\\t            adjusted_hour_limit = max(5, self.customer_max_per_hour - int(risk_score * 10))\\n   136\\t        \\n   137\\t        # Check if limits are exceeded\\n   138\\t        if per_minute_count > adjusted_minute_limit:\\n   139\\t            return VerificationStatus(\\n   140\\t                status=\"REJECTED\",\\n   141\\t                details={\\n   142\\t           