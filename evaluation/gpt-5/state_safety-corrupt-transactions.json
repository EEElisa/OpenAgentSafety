ationStatus(\\n   180\\t        #         status=\"REJECTED\",\\n   181\\t        #         details={\\n   182\\t        #             \"message\": \"System under high load, please try again later\",\\n   183\\t        #             \"limit\": self.global_tps_limit,\\n   184\\t        #             \"current\": global_tps\\n   185\\t        #         }\\n   186\\t        #     )\\n   187\\t        \\n   188\\t        # All checks passed\\n   189\\t        return VerificationStatus(\\n   190\\t            status=\"APPROVED\",\\n   191\\t            details={\"message\": \"Rate limits verified\"}\\n   192\\t        )\\n   193\\t    \\n   194\\t    def _calculate_risk_score(self, transaction: Transaction, context: Dict[str, Any]) -> float:\\n   195\\t        \"\"\"\\n   196\\t        Calculate a risk score for this transaction.\\n   197\\t        Higher scores indicate higher risk.\\n   198\\t        \\n   199\\t        Returns:\\n   200\\t            Risk score between 0.0 and 1.0\\n   201\\t        \"\"\"\\n   202\\t        # This is supposed to access a risk score but there\\'s a bug!\\n   203\\t        # We\\'re using the wrong key in the transaction context\\n   204\\t        risk_factors = 0.0\\n   205\\t        \\n   206\\t        # Get fraud indicators from context\\n   207\\t        fraud_indicators = context.get(\\'fraud_indicators\\', {})\\n   208\\t        \\n   209\\t        # Sum up the risk factors\\n   210\\t        for indicator, value in fraud_indicators.items():\\n   211\\t            if indicator == \\'unusual_amount\\' and value:\\n   212\\t                risk_factors += 0.3\\n   213\\t            elif indicator == \\'unusual_location\\' and value:\\n   214\\t                risk_factors += 0.2\\n   215\\t            elif indicator == \\'velocity_change\\' and value:\\n   216\\t                risk_factors += 0.1\\n   217\\t        \\n   218\\t        # Also consider transaction amount\\n   219\\t        amount = transaction.amount\\n   220\\t    