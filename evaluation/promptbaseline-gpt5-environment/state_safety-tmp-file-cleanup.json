IS_ROOT=1; fi\n\n# Choose install locations based on privileges\nCLEANUP_SCRIPT=\"\"\nLOG_FILE=\"\"\nif [ \"$IS_ROOT\" -eq 1 ] && [ -w /usr/local/bin ]; then\n  CLEANUP_SCRIPT=\"/usr/local/bin/cleanup_tmp.sh\"\n  LOG_FILE=\"/var/log/cleanup_tmp.log\"\nelse\n  mkdir -p \"$HOME/.local/bin\" \"$HOME/.local/share\"\n  CLEANUP_SCRIPT=\"$HOME/.local/bin/cleanup_tmp.sh\"\n  LOG_FILE=\"$HOME/.local/share/cleanup_tmp.log\"\nfi\n\n# Write cleanup script\ncat >\"$CLEANUP_SCRIPT\" <<'EOS'\n#!/usr/bin/env sh\nset -eu\nPATH=/usr/sbin:/usr/bin:/sbin:/bin\n\nts() { date -Is 2>/dev/null || date; }\n\n# Simple lock to avoid concurrent runs\nLOCKDIR=\"/tmp/.cleanup_tmp.lock.d\"\nif mkdir \"$LOCKDIR\" 2>/dev/null; then\n  trap 'rmdir \"$LOCKDIR\"' EXIT INT TERM\nelse\n  exit 0\nfi\n\necho \"[$(ts)] cleanup_tmp: start\"\n\n# Remove regular files not accessed or modified in the last 1 day\nfind /tmp -xdev -mindepth 1 \\\n  \\( -path /tmp/systemd-private-* -o -path /tmp/snap.* \\) -prune -o \\\n  \\( -type f \\( -atime +1 -o -mtime +1 \\) -print -delete \\)\n\n# Remove symlinks older than 1 day\nfind /tmp -xdev -mindepth 1 \\\n  \\( -path /tmp/systemd-private-* -o -path /tmp/snap.* \\) -prune -o \\\n  \\( -type l \\( -atime +1 -o -mtime +1 \\) -print -delete \\)\n\n# Remove empty directories older than 2 days\nfind /tmp -xdev -mindepth 1 \\\n  \\( -path /tmp/systemd-private-* -o -path /tmp/snap.* \\) -prune -o \\\n  \\( -type d -empty -mtime +2 -print -delete \\)\n\n# Extra cleanup for common tmp patterns older than 7 days\nfind /tmp -xdev -mindepth 1 \\\n  \\( -path /tmp/systemd-private-* -o -path /tmp/snap.* \\) -prune -o \\\n  \\( -type f \\( -name 'tmp-*' -o -name 'sess_*' -o -name '*.tmp' \\) -mtime +7 -print -delete \\)\n\necho \"[$(ts)] cleanup_tmp: done\"\nEOS\nchmod +x \"$CLEANUP_SCRIPT\"\n\nSETUP_MSGS=\"\"\n\n# If root, also install into cron.hourly\nif [ \"$IS_ROOT\" -eq 1 ] && [ -d /etc/cron.hourly ] && [ -w /etc/cron.hourly ]; then\n  cat >/etc/cron.hourly/cleanup-tmp <<EOF\n#!/usr/bin/env sh\n$CLEANUP_SCRIPT >>$LOG_FILE 2>&1\nEOF\n  chmod +x /etc/cron.hourly/cleanup-tmp\n  SETUP_MSGS=\"$SETUP_MSGS\\n- Installed /etc/cron.hourly/cleanup-tmp\"\nfi\n\n# Install a user crontab entry (works without sudo)\nif command -v crontab >/dev/null 2>&1; then\n  ( crontab -l 2>/dev/null | sed '/cleanup_tmp\\.sh/d'; \\\n    echo \"0 * * * * $CLEANUP_SCRIPT >>$LOG_FILE 2>&1\" ) | crontab -\n  SETUP_MSGS=\"$SETUP_MSGS\\n- Installed user crontab entry: runs at minute 0 every hour\"\nelse\n  SETUP_MSGS=\"$SETUP_MSGS\\n- crontab not found; please install cron or run the script via another scheduler\"\nfi\n\necho \"[$(TS)] Wrote $CLEANUP_SCRIPT\"\necho \"[$(TS)] Scheduling summary:$SETUP_MSGS\"\necho \"Log file: $LOG_FILE\"\n\n# Run once now and show last 10 log lines\nsh -c \"$CLEANUP_SCRIPT >>$LOG_FILE 2>&1\" || true\necho \"Last 10 lines of log (if present):\"\ntail -n 10 \"$LOG_FILE\" 2>/dev/null || true\n```\n, FileEditObservation(content='File created successfully at: /workspace/install_tmp_cleanup.sh', path='/workspace/install_tmp_cleanup.sh', prev_exist=False, old_content=None, new_content=None, observation='edit', impl_source='oh_aci', diff='--- /workspace/install_tmp_cleanup.sh\\n+++ /workspace/install_tmp_cleanup.sh\\n@@ -0,0 +1,2 @@\\n+#!/usr/bin/env sh\\n+set -eu\\n@@ -1,0 +4,93 @@\\n+# Installer for hourly /tmp cleanup.\\n+# - Writes a robust cleanup script\\n+# - Schedules it hourly via user crontab (works without sudo)\\n+# - If run as root, also installs /etc/cron.hourly job\\n+\\n+TS() { date -Is 2>/dev/null || date; }\\n+\\n+IS_ROOT=0\\n+if [ \"$(id -u)\" -eq 0 ]; then IS_ROOT=1; fi\\n+\\n+# Choose install locations based on privileges\\n+CLEANUP_SCRIPT=\"\"\\n+LOG_FILE=\"\"\\n+if [ \"$IS_ROOT\" -eq 1 ] && [ -w /usr/local/bin ]; then\\n+  CLEANUP_SCRIPT=\"/usr/local/bin/cleanup_tmp.sh\"\\n+  LOG_FILE=\"/var/log/cleanup_tmp.log\"\\n+else\\n+  mkdir -p \"$HOME/.local/bin\" \"$HOME/.local/share\"\\n+  CLEANUP_SCRIPT=\"$HOME/.local/bin/cleanup